-- symbols (".", "!!", ";;", ">>", "kahx " ...). Every match site already
-- compares with #S.commandPrefix so multi-char works everywhere (chat,
-- silent prefix, code prefix, bar, predictor). Kept: 1-12 chars after
-- trimming so a stray space can't break the chat router.
Handler:AddCommand("prefix", {Args = {"*Prefix*"}, Aliases = {}, Description = "Changes the command prefix (any character(s), 1-12)"}, function(A, F)
    local p = tostring(A[1] or "")
    -- trim surrounding whitespace so ".prefix  >> " keeps ">>"
    p = string.gsub(p, "^%s+", "")
    p = string.gsub(p, "%s+$", "")
    if p == "" then
        notify("Prefix", "Prefix cannot be empty.", 3)
        return
    end
    if #p > 12 then
        notify("Prefix", "Prefix must be 12 characters or fewer.", 3)
        return
    end
    S.commandPrefix = p
    notify("Prefix", "Set to \"" .. S.commandPrefix .. "\" -- say " .. S.commandPrefix .. "cmdlist to test", 4)
    print("[KAHX] prefix set to \"" .. S.commandPrefix .. "\" (any character(s) supported)")
end)

-- =====================================================================
-- \\ v3.3.7 Profiles: prefix + binds persistence (workspace folder) // --
-- saveprefix writes the prefix to workspace/KAHX_prefix.txt and
-- loadprefix restores it; autoloadprefix toggles the flag file the
-- script checks at startup. savebinds serializes EVERY keybind and
-- chatbind into workspace/KAHX_binds.json, loadbinds restores them and
-- autoloadbinds toggles the startup flag for that file. All of it is
-- pcall'd + snapshot-safe (tables mutate across threads).
-- =====================================================================
Handler:AddCommand("saveprefix", {Args = {}, Aliases = {}, Description = "Saves your prefix to the workspace folder (KAHX_prefix.txt)"}, function(A, F)
    if not FS.ok() then
        notify("Prefix Save", "Executor has no writefile/readfile -- cannot save", 3)
        return
    end
    if FS.write(CFG.FILE_PREFIX, tostring(S.commandPrefix)) then
        notify("Prefix Save", "Prefix \"" .. S.commandPrefix .. "\" saved -> workspace/" .. CFG.FILE_PREFIX, 4)
        print("[KAHX Profiles] prefix saved: workspace/" .. CFG.FILE_PREFIX)
    else
        notify("Prefix Save", "Write failed (check console)", 3)
    end
end)

Handler:AddCommand("loadprefix", {Args = {}, Aliases = {}, Description = "Loads the saved prefix from the workspace folder"}, function(A, F)
    local raw = FS.read(CFG.FILE_PREFIX)
    -- v3.3.8: the WHOLE saved string loads (any characters allowed),
    -- trimmed -- not just the first character like v3.3.7 did
    local p = raw and string.gsub(tostring(raw), "^%s+", "")
    p = p and string.gsub(p, "%s+$", "") or ""
    if p ~= "" and #p <= 12 then
        S.commandPrefix = p
        notify("Prefix Load", "Prefix set to \"" .. p .. "\"", 4)
        print("[KAHX Profiles] prefix loaded from workspace/" .. CFG.FILE_PREFIX .. ": \"" .. p .. "\"")
    else
        notify("Prefix Load", "No valid workspace/" .. CFG.FILE_PREFIX .. " (use .saveprefix first)", 3)
    end
end)

