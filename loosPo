    local uid = tonumber(input)
    if uid and bannedPlayers[uid] then
        bannedPlayers[uid] = nil
        notify("Unban", "Unbanned ID " .. uid, 3)
        return true
    end
    for u, info in pairs(bannedPlayers) do
        if string.lower(info.name) == string.lower(input) or string.lower(info.displayName) == string.lower(input) then
            bannedPlayers[u] = nil
            notify("Unban", "Unbanned " .. info.name, 3)
            return true
        end
    end
    notify("Unban", "No ban found", 3)
    return false
end

