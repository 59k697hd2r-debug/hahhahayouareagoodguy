local clrRunning = false
local clrStop = false
local function clearAll()
    if clrRunning then return end
    clrRunning = true
    clrStop = false
    equipBuildingTools()
    local endpoint = getSyncAPI()
    if not endpoint then
        notifyError(".clr: Building Tools endpoint not available.")
        clrRunning = false
        return
    end
    local targets = {"Part", "Truss", "Wedge", "CornerWedge"}
    local instances = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            local n = string.lower(v.Name)
            for _, t in ipairs(targets) do
                if n == string.lower(t) then
                    table.insert(instances, v)
                    break
                end
            end
        end
    end
    if #instances == 0 then
        notify(".clr", "No matching parts found.")
        clrRunning = false
        return
    end
    local total = 0
    for i = 1, #instances, 5000 do
        if clrStop then break end
        local batch = {}
        for j = i, math.min(i + 4999, #instances) do
            table.insert(batch, instances[j])
        end
        pcall(function()
            endpoint:InvokeServer("Remove", batch)
        end)
        total = total + #batch
        task.wait(0.01)
    end
    notify(".clr", "Removed " .. total .. " parts.")
    clrRunning = false
end

