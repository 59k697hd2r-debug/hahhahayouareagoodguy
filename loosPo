function Handler:RunCommand(name, args, full)
    local cmd = self.Commands[string.lower(name or "")]
    if not cmd then
        if type(S.didYouMean) == "function" then
            S.didYouMean(tostring(name or ""), args or {}, full or "")
        else
            notify("Command Handler", "Invalid command: " .. tostring(name), 3)
        end
        return
    end
    for i, a in ipairs(cmd.config.Args or {}) do
        if string.sub(a, 1, 1) .. string.sub(a, -1) == "**" and (not args[i] or args[i] == "") then
            notify("Argument Handler", "Missing argument #" .. i .. " for " .. tostring(name), 3)
            return
        end
    end
    announceCommand(name, cmd.config)
    cmd.callback(args, full or "")
end
