local function neutralizePlatform(obj)
    if not obj or not obj:IsA("SkateboardPlatform") then return end
    if isPlatformWhitelisted(obj) then return end
    pcall(function()
        obj.CanTouch = false
        obj.Anchored = false
        obj.CanCollide = false
        obj.Massless = true
        obj.Transparency = 1
        obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        obj:GetPropertyChangedSignal("CanTouch"):Connect(function()
            if Variables.AntiKick and obj.Parent and not isPlatformWhitelisted(obj) then obj.CanTouch = false end
        end)
        obj:GetPropertyChangedSignal("Anchored"):Connect(function()
            if Variables.AntiKick and obj.Parent and not isPlatformWhitelisted(obj) then obj.Anchored = false end
        end)
        obj:GetPropertyChangedSignal("CanCollide"):Connect(function()
            if Variables.AntiKick and obj.Parent and not isPlatformWhitelisted(obj) then obj.CanCollide = false end
        end)
    end)
    task.spawn(function() deleteInstances(obj) end)
end

