-- v3.3.7 AUTOLOAD PROFILES (user: "autoloadprefix and autoloadbinds
-- which just auto loads"): the flag files live in the executor workspace
-- folder and are written by .autoloadprefix / .autoloadbinds. When a
-- flag says "1", the matching load command runs silently at startup so
-- your prefix and every keybind + chatbind come back on their own.
-- ---------------------------------------------------------------------
do
    local function flagEnabled(path)
        if (type(readfile) ~= "function") or (type(isfile) ~= "function") then
            return false
        end
        local ok, on = pcall(function()
            return isfile(path) and readfile(path) == "1"
        end)
        return ok and on or false
    end
    if flagEnabled(CFG.FLAG_AUTO_PREFIX) then
        S.autoloadPrefix = true
        local c = Handler.Commands["loadprefix"]
        if c then
            pcall(c.callback, {}, "")
        end
    end
    if flagEnabled(CFG.FLAG_AUTO_BINDS) then
        S.autoloadBinds = true
        local c2 = Handler.Commands["loadbinds"]
        if c2 then
            pcall(c2.callback, {}, "")
        end
    end
end

