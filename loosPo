local function resolveKeyName(input)
    local s = tostring(input or "")
    if s == "" then return nil end
    local ok, key = pcall(function() return Enum.KeyCode[s] end)
    if ok and key then return key.Name end
    local cap = string.upper(string.sub(s, 1, 1)) .. string.lower(string.sub(s, 2))
    local ok2, key2 = pcall(function() return Enum.KeyCode[cap] end)
    if ok2 and key2 then return key2.Name end
    return nil
end
