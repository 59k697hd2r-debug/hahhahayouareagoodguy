local function resolvePlayerInput(input, cb, incSelf)
    if not input or input == "" then cb({}) return end
    local tokens = {}
    for tok in string.gmatch(string.lower(input), "[^,]+") do
        tok = string.gsub(tok, "^%s+", "")
        tok = string.gsub(tok, "%s+$", "")
        if tok ~= "" then table.insert(tokens, tok) end
    end
    if #tokens == 0 then cb({}) return end
    local ps, seen = {}, {}
    local function addPlayer(p)
        if p and not seen[p] then
            seen[p] = true
            table.insert(ps, p)
        end
    end
    for _, tok in ipairs(tokens) do
        if tok == "all" then
            for _, p in ipairs(Players:GetPlayers()) do
                if incSelf or p ~= LocalPlayer then addPlayer(p) end
            end
        elseif tok == "others" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then addPlayer(p) end
            end
        elseif tok == "random" then
            local l = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if incSelf or p ~= LocalPlayer then table.insert(l, p) end
            end
            if #l > 0 then addPlayer(l[math.random(1, #l)]) end
        elseif tok == "me" or tok == "self" then
            addPlayer(LocalPlayer)
        elseif tok == "friends" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                    if s and f then addPlayer(p) end
                end
            end
        elseif tok == "nonfriends" or tok == "non-friends" or tok == "nfriends" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                    if not (s and f) then addPlayer(p) end
                end
            end
        else
            addPlayer(getPlayerFromPartial(tok))
        end
    end
    if #ps == 0 then
        notify("Player not found", "No match for \"" .. tostring(input) .. "\"", 3)
    else
        cb(ps)
    end
end
