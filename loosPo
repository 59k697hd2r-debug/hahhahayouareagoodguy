-- =====================================================================
-- \\ FS -- executor workspace file helpers (v3.3.7) // --
-- Every map/profile file lives DIRECTLY in the executor WORKSPACE
-- folder (writefile/readfile paths are relative to it), per user spec.
-- Every helper is nil-safe: executors without the file API gracefully
-- disable persistence and the in-memory behavior keeps working.
-- =====================================================================
local HttpService = game:GetService("HttpService")

local FS = {}

-- ok(): file persistence is only possible when writefile + readfile exist
FS.ok = function()
    return (type(writefile) == "function") and (type(readfile) == "function")
end

-- write(): pcall'd writefile, returns true only on confirmed success
FS.write = function(name, data)
    if not FS.ok() then return false end
    local s, e = pcall(function() writefile(name, data) end)
    if not s then print("[KAHX FS] write failed for " .. tostring(name) .. ": " .. tostring(e)) end
    return s
end

-- read(): pcall'd readfile, returns the content string or nil
FS.read = function(name)
    if not FS.ok() then return nil end
    local s, v = pcall(function() return readfile(name) end)
    if s then return v end
    return nil
end

-- exists(): isfile when the executor has it, read-probe otherwise
FS.exists = function(name)
    if type(isfile) == "function" then
        local s, v = pcall(function() return isfile(name) end)
        if s then return v end
    end
    return FS.read(name) ~= nil
end

-- del(): pcall'd delfile (used by .delmap to drop the workspace file)
FS.del = function(name)
    if type(delfile) ~= "function" then return false end
    return pcall(function() delfile(name) end)
end

-- list(): pcall'd listfiles of the workspace root, table or {}
FS.list = function()
    if type(listfiles) ~= "function" then return {} end
    local s, v = pcall(function() return listfiles("") end)
    if s and type(v) == "table" then return v end
    return {}
end

-- encode()/decode(): JSON bridge through HttpService, nil on failure
FS.encode = function(t)
    local s, v = pcall(function() return HttpService:JSONEncode(t) end)
    if s then return v end
    return nil
end

FS.decode = function(str)
    local s, v = pcall(function() return HttpService:JSONDecode(str) end)
    if s then return v end
    return nil
end

-- mapFileName(): sanitized, collision-safe workspace file name
local function mapFileName(saveName)
    local clean = tostring(saveName):gsub("[^%w%-_]", "")
    if clean == "" then clean = "unnamed" end
    return CFG.MAP_FILE_PREFIX .. clean .. CFG.MAP_FILE_EXT
end

-- =====================================================================
-- \\ Map Saver // --
-- Snapshot: name-valid BaseParts outside Terrain/Tabby/character/SK
-- folders, up to CFG.MAP_PART_CAP, storing a 12-number CFrame, size,
-- color, material NAME, transparency, anchored flag and name.
-- v3.3.7 (user: "make savemaps save in workspace folder"): the snapshot
-- is serialized to JSON and written to workspace/KAHX_map_<name>.json
-- so maps SURVIVE rejoining; the memory copy stays as the fast path.
-- =====================================================================
local function saveMap(saveName)
    local saved = {}
    local count = 0
    local tr = Workspace:FindFirstChild("Terrain")
    local tb = Workspace:FindFirstChild("Tabby")
    for _, v in pairs(Workspace:GetDescendants()) do
        if count >= CFG.MAP_PART_CAP then break end
        if v:IsA("BasePart") and CFG.VALID_PART_NAMES[v.Name] and not isProtectedInstance(v) then
            local skip = false
            local m = v:FindFirstAncestorOfClass("Model")
            if m and Players:GetPlayerFromCharacter(m) then skip = true end
            if not skip and tr and v:IsDescendantOf(tr) then skip = true end
            if not skip and tb and v:IsDescendantOf(tb) then skip = true end
            if not skip and Variables.SKickFolder and v:IsDescendantOf(Variables.SKickFolder) then skip = true end
            if not skip then
                -- GetComponents = position + full rotation matrix, so the
                -- rebuild is EXACT (orientation included), not just placed
                local cx, cy, cz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = v.CFrame:GetComponents()
                table.insert(saved, {
                    c = {cx, cy, cz, r00, r01, r02, r10, r11, r12, r20, r21, r22},
                    s = {v.Size.X, v.Size.Y, v.Size.Z},
                    col = {v.Color.R, v.Color.G, v.Color.B},
                    m = tostring(v.Material),
                    t = v.Transparency,
                    a = v.Anchored and 1 or 0,
                    n = v.Name
                })
                count = count + 1
            end
        end
    end
    mapSaves[saveName] = saved
    local json = FS.encode({v = 1, map = saveName, count = count, parts = saved})
    if json and FS.write(mapFileName(saveName), json) then
        notify("Map Saver", "Saved " .. count .. " parts -> workspace/" .. mapFileName(saveName), 5)
        print("[KAHX Map Saver] file saved: workspace/" .. mapFileName(saveName) .. " (" .. count .. " parts)")
    else
        notify("Map Saver", "Saved " .. count .. " parts as \"" .. tostring(saveName) .. "\" (memory only -- no file API)", 5)
    end
end

-- =====================================================================
-- \\ Map Loader (v3.3.7 FAST REBUILD) // --
-- The old loop made SIX server round trips per part (CreatePart +
-- SyncResize + SyncColor + SyncMaterial + SyncAnchor + SetName). Now
-- every part costs exactly ONE CreatePart invoke and each property
-- class is synced as a single BATCHED array call per 25-part chunk --
-- roughly 6x fewer round trips, which is where all the waiting was.
-- Names are skipped on rebuild (pure cosmetics, zero gameplay value).
-- Source order: in-memory snapshot first, then the workspace file.
-- =====================================================================
local function loadMap(saveName)
    local saved = mapSaves[saveName]
    if not saved then
        local raw = FS.read(mapFileName(saveName))
        local data = raw and FS.decode(raw)
        if data and type(data.parts) == "table" then
            saved = data.parts
            mapSaves[saveName] = saved
            print("[KAHX Map Saver] loaded file: workspace/" .. mapFileName(saveName))
        end
    end
    if not saved then
        notify("Map Saver", "No save named \"" .. tostring(saveName) .. "\"", 3)
        return
    end
    if loadedMapGroups[saveName] and loadedMapGroups[saveName].Parent then
        f3x({"Remove", {loadedMapGroups[saveName]}})
    end
    local group = f3x({"CreateGroup", "Model", getHiddenParent(), {}})
    if not group then
        notify("Map Saver", "Failed to create group", 3)
        return
    end
    f3x({"SetName", {group}, getObfName()})
    loadedMapGroups[saveName] = group
    task.spawn(function()
        local total = #saved
        local CH = 25
        local refs = {}
        local t0 = os.clock()
        for i, d in ipairs(saved) do
            -- rebuild the CFrame: 12 numbers when valid, position-only
            -- as the fallback for hand-edited or legacy files
            local c = d.c or {}
            local cf = CFrame.new(tonumber(c[1]) or 0, tonumber(c[2]) or 0, tonumber(c[3]) or 0)
            if tonumber(c[12]) then
                pcall(function()
                    cf = CFrame.new(c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12])
                end)
            end
            local res = f3x({"CreatePart", "Normal", cf, group})
            local part = res
            if type(res) == "table" then part = res[1] end
            if part then table.insert(refs, {p = part, d = d, cf = cf}) end
            -- chunk boundary: flush every property class as ONE call
            if (i % CH == 0) or (i == total) then
                local rb, cb, mb, ab = {}, {}, {}, {}
                for _, r in ipairs(refs) do
                    local s = r.d.s or {4, 1, 2}
                    table.insert(rb, {Part = r.p, CFrame = r.cf, Size = Vector3.new(tonumber(s[1]) or 4, tonumber(s[2]) or 1, tonumber(s[3]) or 2)})
                    local col = r.d.col or {0.6, 0.6, 0.6}
                    table.insert(cb, {Part = r.p, Color = Color3.new(tonumber(col[1]) or 0.6, tonumber(col[2]) or 0.6, tonumber(col[3]) or 0.6)})
                    local okm, mat = pcall(function() return Enum.Material[tostring(r.d.m or "Plastic")] end)
                    if not okm or not mat then mat = Enum.Material.Plastic end
                    table.insert(mb, {Part = r.p, Material = mat, Transparency = tonumber(r.d.t) or 0})
                    table.insert(ab, {Part = r.p, Anchored = (tonumber(r.d.a) or 0) >= 1})
                end
                pcall(function() f3x({"SyncResize", rb}) end)
                pcall(function() f3x({"SyncColor", cb}) end)
                pcall(function() f3x({"SyncMaterial", mb}) end)
                pcall(function() f3x({"SyncAnchor", ab}) end)
                refs = {}
                if (i % 250 == 0) and (i < total) then
                    notify("Map Saver", "Loading " .. i .. "/" .. total .. "...", 2)
                end
                task.wait(0.03)
            end
        end
        local ms = math.floor((os.clock() - t0) * 1000)
        notify("Map Saver", "Loaded " .. total .. " parts in " .. ms .. "ms", 5)
        print("[KAHX Map Saver] rebuilt " .. total .. " parts from \"" .. tostring(saveName) .. "\" in " .. ms .. "ms (batched sync)")
    end)
end

