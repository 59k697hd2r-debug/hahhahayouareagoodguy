    local function loadAllImages(mySeq)
        for _, w in pairs(rowsByUser) do
            if not w.dead then
                local cached = fmtIdx <= 3 and thumbCache[w.uid] and thumbCache[w.uid][fmtIdx]
                if cached then
                    w.img.Image = cached
                    w.imgStatus.Text = ""
                elseif fmtIdx <= 3 and not w.triedFmt[fmtIdx] then
                    w.imgStatus.Text = "..."
                end
            end
        end
        if fmtIdx > 3 then
            for _, w in pairs(rowsByUser) do
                if not w.dead then
                    w.img.Image = ""
                    w.imgStatus.Text = ""
                end
            end
            return
        end
        local queue = {}
        for _, w in pairs(rowsByUser) do
            if not w.dead and not (thumbCache[w.uid] and thumbCache[w.uid][fmtIdx])
                and not w.triedFmt[fmtIdx] then
                table.insert(queue, w)
            end
        end
        table.sort(queue, function(a, b) return a.uid < b.uid end)
        task.spawn(function()
            local i = 1
            while i <= #queue do
                if mySeq ~= fetchSeq or not gui.Parent then return end
                local burst = {}
                for k = i, math.min(i + 11, #queue) do
                    table.insert(burst, queue[k])
                end
                for _, w in ipairs(burst) do
                    w.triedFmt[fmtIdx] = true
                    task.spawn(function()
                        local ok, content = pcall(function()
                            local t = Enum.ThumbnailType[THUMB_TYPE[fmtIdx]] or Enum.ThumbnailType.AvatarThumbnail
                            return Players:GetUserThumbnailAsync(w.uid, t, Enum.ThumbnailSize.Size100x100)
                        end)
                        if not w.dead and mySeq == fetchSeq and gui.Parent then
                            if ok and content then
                                thumbCache[w.uid] = thumbCache[w.uid] or {}
                                thumbCache[w.uid][fmtIdx] = content
                                w.img.Image = content
                                w.imgStatus.Text = ""
                            else
                                w.endpoint = true
                            end
                        end
                    end)
                end
                task.wait(0.35)
                i = i + 12
            end
            task.spawn(function()
                local pending = {}
                for _, w in ipairs(queue) do
                    if not w.dead and w.endpoint
                        and not (thumbCache[w.uid] and thumbCache[w.uid][fmtIdx]) then
                        table.insert(pending, w.uid)
                    end
                end
                if #pending == 0 then return end
                for i2 = 1, #pending, 100 do
                    if mySeq ~= fetchSeq or not gui.Parent then return end
                    local chunk = {}
                    for j = i2, math.min(i2 + 99, #pending) do
                        table.insert(chunk, pending[j])
                    end
                    local data = httpJson(THUMB_URLS[fmtIdx](table.concat(chunk, ",")))
                    if mySeq ~= fetchSeq or not gui.Parent then return end
                    if data and data.data then
                        for _, e in ipairs(data.data) do
                            if e.state == "Completed" and e.imageUrl then
                                thumbCache[e.targetId] = thumbCache[e.targetId] or {}
                                thumbCache[e.targetId][fmtIdx] = e.imageUrl
                                local w = rowsByUser[e.targetId]
                                if w and not w.dead then
                                    w.img.Image = e.imageUrl
                                    w.imgStatus.Text = ""
                                end
                            end
                        end
                    end
                    task.wait(0.2)
                end
            end)
        end)
    end
