    return s and r or nil
end
local function deleteInstances(ins)
    if type(ins) ~= "table" then ins = {ins} end
    if #ins == 0 then return 0 end
    local e = getEndpoint()
    if not e then return 0 end
    local v = {}
    for _, i in ipairs(ins) do
        if i and i:IsA("Instance") then table.insert(v, i) end
    end
    if #v == 0 then return 0 end
    local t = 0
    for i = 1, #v, CFG.BATCH_SIZE do
        local b = {}
        for j = i, math.min(i + CFG.BATCH_SIZE - 1, #v) do table.insert(b, v[j]) end
        if pcall(function() e:InvokeServer("Remove", b) end) then t = t + #b end
        task.wait(0.01)
    end
    return t
end
