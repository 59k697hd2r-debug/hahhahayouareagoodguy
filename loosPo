-- ---------------------------------------------------------------------
-- Anti-Blind (self, v3.3.5 user spec: "detects if there is
-- PlayerGui.EFFECTGUIBLIND and deletes it"): three layers now --
--   1. a DescendantAdded hook on PlayerGui deletes it the FRAME it lands
--   2. the 0.05s sweep deletes anything that slipped past the hook
--      (destroy is INSTANT -- the old version rate-limited the destroy
--      itself, letting a re-added blind survive between windows)
--   3. the chat "unblind <name>" is still sent (rate-limited) as
--      belt-and-braces for server-side effects
-- mon_antiblind (p07) keeps trying the same for OTHER protected players,
-- though their PlayerGui is not replicated to us.
-- ---------------------------------------------------------------------
function Antis.startAntiBlind()
    if S.antiBlindActive then return end
    S.antiBlindActive = true
    -- layer 1: instant hook on PlayerGui adds
    task.spawn(function()
        local pg = LocalPlayer:WaitForChild("PlayerGui", 5)
        if not pg then return end
        table.insert(Connections, pg.ChildAdded:Connect(function(c)
            if not S.antiBlindActive then return end
            if c and c.Name == "EFFECTGUIBLIND" then
                task.defer(function()
                    pcall(function() c:Destroy() end)
                    local n = os.clock()
                    if (n - S.lastUnblindTime) >= 0.5 then
                        S.lastUnblindTime = n
                        notify("Anti-Blind", "Deleted EFFECTGUIBLIND", 2)
                        print("[KAHX Anti-Blind] EFFECTGUIBLIND deleted (hook)")
                    end
                end)
            end
        end))
        if pg:FindFirstChild("EFFECTGUIBLIND") then
            pcall(function() pg.EFFECTGUIBLIND:Destroy() end)
        end
    end)
    -- layers 2 + 3: sweep + server-side unblind
    runLoop("antiblind", 0.05, function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return end
        local b = pg:FindFirstChild("EFFECTGUIBLIND")
        if b then
            -- v3.3.5: destroy ALWAYS, instantly
            pcall(function() b:Destroy() end)
            local n = os.clock()
            if (n - S.lastUnblindTime) >= 0.5 then
                S.lastUnblindTime = n
                chatSystem("unblind " .. LocalPlayer.Name)
                notify("Anti-Blind", "Deleted EFFECTGUIBLIND", 2)
                print("[KAHX Anti-Blind] EFFECTGUIBLIND deleted (sweep)")
            end
        end
    end, true)
end

function Antis.stopAntiBlind()
    S.antiBlindActive = false
    stopLoop("antiblind")
end

