Handler:AddCommand("voidspawns", {Args = {"Count?"}, Aliases = {"vspawn", "vspawns", "voidspawn"}, Description = "Void spawns: obfuscated SpawnLocations at Y -600 under Realistic SunRays -- arg = TOTAL number of spawns (.voidspawns 1000), default 500, model-loader pace. Clear with .clrvoidspawns"}, function(A, F)
