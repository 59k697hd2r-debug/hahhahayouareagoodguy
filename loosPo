local function toggleAntiAbuse(state)
    antiAbuseActive = state
    if state then
        local obby = Workspace:FindFirstChild("Tabby") and Workspace.Tabby:FindFirstChild("Admin_House") and Workspace.Tabby.Admin_House:FindFirstChild("Obby")
        if obby then
            local cf = obby:GetBoundingBox()
            local targets = {
                Workspace:FindFirstChild("Realistic SunRays"),
                Workspace:FindFirstChild("Realistic Bloom"),
                Workspace:FindFirstChild("Realistic ColorCorrection"),
                Workspace:FindFirstChild("Terrain")
            }
            for _, target in ipairs(targets) do
                if target then
                    local res = f3x({"CreatePart", "Normal", cf, target})
                    local part = res
                    if type(res) == "table" then part = res[1] end
                    if part then
                        f3x({"SyncResize", {{Part = part, CFrame = cf, Size = Vector3.new(30, 4, 10)}}})
                        f3x({"SyncAnchor", {{Part = part, Anchored = true}}})
                        f3x({"SyncCollision", {{Part = part, CanCollide = false}}})
                        f3x({"SyncMaterial", {{Part = part, Transparency = 0.5}}})
                        f3x({"SetName", {part}, "AntiAbusePass"})
                        table.insert(antiAbuseParts, part)
                    end
                end
            end
        end
        task.spawn(function()
            while antiAbuseActive and monitorLoopActive do
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and p.Character.Parent == Lighting then
                        chatSystem("unpunish " .. p.Name)
                    end
                end
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj.Name:find("'s jail") then
                        local name = obj.Name:match("^(.-)'s jail")
                        if name then chatSystem("unjail " .. name) end
                    end
                end
                task.wait(0.1)
            end
        end)
    else
        for _, part in ipairs(antiAbuseParts) do
            if part and part.Parent then f3x({"Remove", {part}}) end
        end
        antiAbuseParts = {}
    end
end

