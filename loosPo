-- === PAD CLAIMER ===
local trackedPad = nil
local padChildren = nil
local clickDetector = nil

local function initPadClaimer()
    local terrain = Workspace:FindFirstChild("Terrain")
    if not terrain then return false end
    local gameFolder = terrain:FindFirstChild("_Game")
    if not gameFolder then return false end
    local adminFolder = gameFolder:FindFirstChild("Admin")
    if not adminFolder then return false end
    local pads = adminFolder:FindFirstChild("Pads")
    if not pads then return false end
    padChildren = pads:GetChildren()
    if #padChildren < 9 then return false end
    clickDetector = adminFolder:FindFirstChild("Regen") and adminFolder.Regen:FindFirstChild("ClickDetector")
    return true
end

local function fireRegen()
    if not clickDetector then return false end
    clickDetector.MaxActivationDistance = 99999
    pcall(function()
        fireclickdetector(clickDetector)
    end)
    return true
end

local function getHRP()
    local char = LocalPlayer.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function fireTouch(pad)
    local head = pad:FindFirstChild("Head")
    if not head then return false end
    local hrp = getHRP()
    if not hrp then return false end
    pcall(function()
        firetouchinterest(head, hrp, 0)
        task.wait(0.05)
        firetouchinterest(head, hrp, 1)
    end)
    return true
end

local function isDarkGreen(pad)
    local head = pad:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head.BrickColor == BrickColor.new("Dark green")
    end
    return false
end

local function isBrightRed(pad)
    local head = pad:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head.BrickColor == BrickColor.new("Bright red")
    end
    return false
end

local function findDarkGreen()
    if not padChildren then return nil end
    for _, pad in ipairs(padChildren) do
        if isDarkGreen(pad) then return pad end
    end
    return nil
end

local function touchAndTrack()
    local dark = findDarkGreen()
    if dark then
        fireTouch(dark)
        task.wait(0.05)
        if isBrightRed(dark) then
            trackedPad = dark
            return true
        end
    else
        fireRegen()
