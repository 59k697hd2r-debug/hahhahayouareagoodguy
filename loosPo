-- =====================================================================
-- \\ Loopkill Engine // --
-- =====================================================================
local function startLoopkill(pl, method)
    local id = pl.UserId
    if S.loopkillTasks[id] then return end
    S.loopkillTasks[id] = {active = true, method = method or "sk"}
    task.spawn(function()
        while S.monitorLoopActive do
            local entry = S.loopkillTasks[id]
            if not entry or not entry.active then break end
            local p = getPlayerByUserId(id)
            if not p then break end
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if entry.method == "pk" then
                    pcall(function() Handler.Commands["potatokick"].callback({p.Name}, "") end)
                else
                    pcall(function() Handler.Commands["skateboardkick"].callback({p.Name}, "") end)
                end
            end
            local t0 = os.clock()
            while p.Parent and os.clock() - t0 < 12 do
                local e = S.loopkillTasks[id]
                if not e or not e.active then break end
                task.wait(0.25)
            end
            t0 = os.clock()
            while p.Parent and not (p.Character and p.Character:FindFirstChild("HumanoidRootPart"))
                and os.clock() - t0 < 10 do
                task.wait(0.25)
            end
            task.wait(0.5)
        end
        S.loopkillTasks[id] = nil
    end)
end

local function stopLoopkill(pl)
    local entry = S.loopkillTasks[pl.UserId]
    if entry then
        entry.active = false
        return true
    end
    return false
end

