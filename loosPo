-- resolvePlayerInput (v3.3.5): expands a target expression into a list
-- of players and hands it to the callback. incSelf gates whether the
-- local player can appear in the result for the group selectors.
--   SELECTORS: every keyword a target expression may contain besides names
--     all          everyone (respects incSelf)
--     others       everyone EXCEPT you (v3.3.5, user request)
--     me           JUST you -- overrides incSelf because you asked
--                  for it explicitly (v3.3.8, user request; also
--                  accepts "self")
--     friends      your friends            (v3.3.5, user request)
--     nonfriends   everyone who is NOT your friend (v3.3.5; also
--                  accepts "non-friends" / "nfriends")
--     random       one random player
--   COMMA MULTI-TARGET (v3.3.5, user request): "skick noob,Master"
--     kicks BOTH -- every comma token may itself be a selector, so
--     "skick others", "ban a,b,c", "pkick friends,xNoob" all work.
--     Results are de-duplicated before the callback runs.
local function resolvePlayerInput(input, cb, incSelf)
    if not input or input == "" then cb({}) return end
    local tokens = {}
    for tok in string.gmatch(string.lower(input), "[^,]+") do
        tok = string.gsub(tok, "^%s+", "")
        tok = string.gsub(tok, "%s+$", "")
        if tok ~= "" then table.insert(tokens, tok) end
    end
    if #tokens == 0 then cb({}) return end
    local ps, seen = {}, {}
    local function addPlayer(p)
        if p and not seen[p] then
            seen[p] = true
            table.insert(ps, p)
        end
    end
    for _, tok in ipairs(tokens) do
        if tok == "all" then
            for _, p in ipairs(Players:GetPlayers()) do
                if incSelf or p ~= LocalPlayer then addPlayer(p) end
            end
        elseif tok == "others" then
            -- always excludes YOU, no matter what incSelf says
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then addPlayer(p) end
            end
        elseif tok == "random" then
            local l = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if incSelf or p ~= LocalPlayer then table.insert(l, p) end
            end
            if #l > 0 then addPlayer(l[math.random(1, #l)]) end
        elseif tok == "me" or tok == "self" then
            -- v3.3.8 (user request): "me" targets YOU and only you --
            -- it ignores incSelf because naming yourself explicitly is
            -- the whole point (e.g. ".loopkill me" with selftarget off).
            addPlayer(LocalPlayer)
        elseif tok == "friends" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                    if s and f then addPlayer(p) end
                end
            end
        elseif tok == "nonfriends" or tok == "non-friends" or tok == "nfriends" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                    if not (s and f) then addPlayer(p) end
                end
            end
        else
            addPlayer(getPlayerFromPartial(tok))
        end
    end
    if #ps == 0 then
        notify("Player not found", "No match for \"" .. tostring(input) .. "\"", 3)
    else
        cb(ps)
    end
end

-- joinTargetArgs: the chat router splits on spaces, so ".skick noob, Master"
-- arrives as A = {"noob,", "Master"} and A[1] alone would only carry the
-- trailing comma. This glues comma-trailing tokens back onto the target
-- list (".skick noob, master, third" -> "noob,master,third") without
-- touching normal space-separated multi-arg commands: if the first
-- argument does not end with a comma, nothing is joined.
local function joinTargetArgs(A)
    local out = A[1] or ""
    for i = 2, #A do
        if string.sub(out, -1) == "," then
            out = out .. A[i]
        else
            break
        end
    end
    return out
end

-- Platforms owned by whitelisted players (or sitting in the SK folder) must
-- survive the anti-kick neutralizer, otherwise our own kick rig gets eaten.
local function isPlatformWhitelisted(obj)
    if Variables.SKickFolder and obj:IsDescendantOf(Variables.SKickFolder) then return true end
    -- v3.3.6: every multi-setup folder is exempt too (.sks N)
    do
        local hit = false
        pcall(function()
            for _, f in ipairs(Variables.SKSetups) do
                if f and f.Parent and obj:IsDescendantOf(f) then hit = true break end
            end
        end)
        if hit then return true end
    end
    local a = obj:FindFirstAncestorOfClass("Model")
    if a then
        local plr = Players:GetPlayerFromCharacter(a)
        if plr and plr ~= LocalPlayer then return true end
    end
    local bp = obj:FindFirstAncestorOfClass("Backpack")
    if bp then
        local plr = bp:FindFirstAncestorOfClass("Player")
        if plr and plr ~= LocalPlayer then return true end
    end
    -- v3.3.4: snapshot traversal -- WhitelistedSKS is mutated by commands
    -- on other threads; live pairs() across threads can throw
    -- "invalid key to 'next'"
    local wlNames = {}
    pcall(function()
        for plrName, _ in pairs(WhitelistedSKS) do table.insert(wlNames, plrName) end
    end)
    for _, plrName in ipairs(wlNames) do
        local p = Players:FindFirstChild(plrName)
        if p then
            if p:FindFirstChild("Backpack") and obj:IsDescendantOf(p.Backpack) then return true end
            if p.Character and obj:IsDescendantOf(p.Character) then return true end
        end
    end
    return false
end

