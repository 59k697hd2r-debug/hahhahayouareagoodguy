    local function argChip(arg)
        local a = tostring(arg or "")
        local bare = a:gsub("%*", ""):gsub("%?", "")
        local low = string.lower(bare)
        if string.find(low, "player", 1, true) or string.find(low, "name", 1, true)
            or string.find(low, "target", 1, true) then
            return {label = "<" .. bare .. ">", insert = "me ", hint = "arg -- inserts 'me'"}
        end
        if low == "on/off" then
            return {label = "on", insert = "on ", hint = "toggle arg"}
        end
        if string.find(low, "count", 1, true) or string.find(low, "number", 1, true) then
            return {label = "2", insert = "2 ", hint = "number arg"}
        end
        if string.find(low, "code", 1, true) then
            return {label = "<code>", insert = "print('hi')", hint = "lua arg"}
        end
        if string.find(low, "key", 1, true) then
            return {label = "F", insert = "F ", hint = "key arg"}
        end
        return {label = "<" .. bare .. ">", insert = bare .. " ", hint = "arg"}
    end
    local SELECTOR_CHIPS = {"me", "others", "friends", "nonfriends", "random", "all"}
    local function argIsPlayer(config)
        for _, a in ipairs(config.Args or {}) do
            local la = string.lower(tostring(a):gsub("%*", ""):gsub("%?", ""))
            if string.find(la, "player", 1, true) or string.find(la, "name", 1, true)
                or string.find(la, "target", 1, true) then return true end
        end
        return false
    end
    local function refreshSuggestions()
        refreshCmdNames()
        local raw = box.Text
        local codePrefix = ">" .. S.commandPrefix
        if raw == "" or string.sub(raw, 1, #codePrefix) == codePrefix then
            hideSuggestions()
            return
        end
        local q = raw
        if string.sub(q, 1, #S.commandPrefix) == S.commandPrefix then
            q = string.sub(q, #S.commandPrefix + 1)
        end
        q = string.lower((q:gsub("^%s+", "")))
        if q == "" then
            hideSuggestions()
            return
        end
        local tokens = {}
        for tok in q:gmatch("%S+") do table.insert(tokens, string.lower(tok)) end
        local cmdEntry = Handler.Commands[tokens[1] or ""]
        local endsSpace = string.sub(raw, -1) == " "
        local list = {}
        if #tokens == 1 and endsSpace and cmdEntry then
            local seenLabels = {}
            for _, a in ipairs(cmdEntry.config.Args or {}) do
                if #list >= 5 then break end
                local chip = argChip(a)
                if not seenLabels[chip.label] then
                    seenLabels[chip.label] = true
                    table.insert(list, chip)
                end
            end
            for _, al in ipairs(cmdEntry.config.Aliases or {}) do
                if #list >= 5 then break end
                local lal = tostring(al)
                if not seenLabels[lal] then
                    seenLabels[lal] = true
                    table.insert(list, {label = lal, insert = lal .. " ", hint = "alias of " .. tokens[1], absolute = true})
                end
            end
        elseif #tokens >= 2 and cmdEntry and argIsPlayer(cmdEntry.config) then
            local last = tokens[#tokens]
            for _, sel in ipairs(SELECTOR_CHIPS) do
                if #list >= 5 then break end
                if sel ~= last and string.sub(sel, 1, #last) == last then
                    table.insert(list, {label = sel, insert = sel .. " ", hint = "selector"})
                end
            end
            for _, p in ipairs(Players:GetPlayers()) do
                if #list >= 5 then break end
                local nm = string.lower(p.Name)
                local dn = string.lower(p.DisplayName)
                if nm ~= last and (string.sub(nm, 1, #last) == last or string.sub(dn, 1, #last) == last) then
                    table.insert(list, {label = p.Name, insert = p.Name .. " ", hint = p.DisplayName})
                end
            end
        elseif #tokens == 1 then
            local starts, contains = {}, {}
            for _, e in ipairs(cmdNames) do
                local nm = e.name
                if nm ~= q then
                    if string.sub(nm, 1, #q) == q then
                        table.insert(starts, e)
                    elseif string.find(nm, q, 1, true) then
                        table.insert(contains, e)
                    end
                end
            end
            for _, e in ipairs(starts) do table.insert(list, e) end
            for _, e in ipairs(contains) do
                if #list >= 5 then break end
                table.insert(list, e)
            end
            for idx, e in ipairs(list) do
                list[idx] = {label = e.name, insert = e.name .. " ", hint = (e.config and e.config.Description) or "", absolute = true}
            end
        end
        sugList = list
        sugIndex = 0
        for i = 1, 5 do
            local row = sugRows[i]
            local e = list[i]
            local h = sugHints[i]
            if e then
                row.Visible = true
                if h then
                    h.label.Text = tostring(e.label or "")
                    h.hint.Text = tostring(e.hint or "")
                end
                styleRow(i, false)
            else
                row.Visible = false
            end
        end
    end
