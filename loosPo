local function updateFriends()
    local localPlayer = LocalPlayer
    local currentFriends = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local success, isFriend = pcall(function()
                return localPlayer:IsFriendsWith(player.UserId)
            end)
            if success and isFriend then
                table.insert(currentFriends, player)
            end
        end
    end

    for _, friend in ipairs(currentFriends) do
        local alreadyTracked = false
        for _, tracked in ipairs(friendsInGame) do
            if tracked == friend then
                alreadyTracked = true
                break
            end
        end
        if not alreadyTracked then
            window:Toast({
                title = "Friend joined",
                subtitle = friend.DisplayName .. " is in your server",
                avatar = friend.UserId,
            })
        end
    end

    friendsInGame = currentFriends

    local currentUserIds = {}
    for _, f in ipairs(friendsInGame) do
        table.insert(currentUserIds, f.UserId)
    end
    table.sort(currentUserIds)
    local changed = false
    if #currentUserIds ~= #lastFriendsList then
        changed = true
    else
        for i = 1, #currentUserIds do
            if currentUserIds[i] ~= lastFriendsList[i] then
                changed = true
                break
            end
        end
    end
    if changed then
        lastFriendsList = currentUserIds
        rebuildFriendButtons()
    end
end

-- === PLAYER RESOLUTION ===
local function getPlayerFromPartial(partial)
    if not partial then return nil end
    local partialLower = string.lower(partial)
    for _, p in ipairs(Players:GetPlayers()) do
        local nameLow = string.lower(p.Name)
        local displayLow = string.lower(p.DisplayName)
        if nameLow == partialLower or displayLow == partialLower then
            return p
        end
        if string.find(nameLow, partialLower, 1, true) == 1 then
            return p
        end
        if string.find(displayLow, partialLower, 1, true) == 1 then
            return p
        end
    end
    return nil
end

local function resolvePlayerInput(input, callback, friendChoice, skipCrashed)
    if not input or input == "" then
        notifyError("No target specified")
        return
    end
    if not callback or type(callback) ~= "function" then
        notifyError("Internal error: callback is not a function")
        return
    end

    local function getTargets(includeFriends, skipCrashed)
        local players = Players:GetPlayers()
        local targets = {}
        for _, p in ipairs(players) do
            if p == LocalPlayer then continue end
            if skipCrashed and isRecentlyCrashed(p) then continue end
            if not includeFriends then
                local isFriend = false
                for _, f in ipairs(friendsInGame) do
                    if f == p then
                        isFriend = true
                        break
                    end
                end
                if isFriend then continue end
            end
            table.insert(targets, p)
        end
        return targets
    end

    if input == "random" then
        local function pickRandom(includeFriends)
            local targets = getTargets(includeFriends, false)
            if #targets == 0 then
                notifyError("No eligible players found")
                return
            end
            local chosen = targets[math.random(1, #targets)]
            if callback then callback({ chosen }) else notifyError("Callback nil") end
        end

        if friendChoice then
            pcall(function()
                window:Popup({
                    title = "Random Target",
                    content = "Do you want to include your friends as possible targets?",
                    options = {
                        { text = "No (exclude friends)", callback = function() pickRandom(false) end },
                        { text = "Yes (include friends)", style = "primary", callback = function() pickRandom(true) end },
                    },
                })
            end)
        else
            pickRandom(false)
        end
        return
    end

    if input == "all" then
        local function doAll(includeFriends)
            local targets = getTargets(includeFriends, skipCrashed or false)
            if #targets == 0 then
                notifyError("No other players in server")
                return
            end
            if callback then callback(targets) else notifyError("Callback nil") end
        end

        if friendChoice then
            pcall(function()
                window:Popup({
                    title = "All Target",
                    content = "Do you want to include your friends in the target list?",
                    options = {
                        { text = "No (exclude friends)", callback = function() doAll(false) end },
                        { text = "Yes (include friends)", style = "primary", callback = function() doAll(true) end },
                    },
                })
            end)
        else
            doAll(false)
        end
        return
    end

    local target = getPlayerFromPartial(input)
    if target then
        if callback then callback({ target }) else notifyError("Callback nil") end
    else
        notifyError("Player not found")
    end
end

