-- ===== ADMIN PADS (ONE PAD, SWAP EVERY 3 MINS) =====
local adminPads = {}
local clickDetector = nil

local function initAdminPads()
    local terrain = Workspace:FindFirstChild("Terrain")
    if not terrain then return false end
    local gf = terrain:FindFirstChild("_Game")
    if not gf then return false end
    local af = gf:FindFirstChild("Admin")
    if not af then return false end
    local pads = af:FindFirstChild("Pads")
    if not pads then return false end
    adminPads = pads:GetChildren()
    if #adminPads == 0 then return false end
    clickDetector = af:FindFirstChild("Regen") and af.Regen:FindFirstChild("ClickDetector")
    return true
end

local function startAutoAdmin()
    if not initAdminPads() then return end
    if autoAdminThread then return end

    local originalCFs = {}
    for _, pad in ipairs(adminPads) do
        local head = pad:FindFirstChild("Head")
        if head then
            originalCFs[head] = head.CFrame
        end
    end

    autoAdminThread = task.spawn(function()
        local selectedPad = nil
        local lastSwap = os.clock()
        
        local function selectNewPad()
            local allRed = true
            local newPad = nil
            for _, pad in ipairs(adminPads) do
                local head = pad:FindFirstChild("Head")
                if head and head:IsA("BasePart") then
                    if head.BrickColor == BrickColor.new("Bright red") then
                        continue
                    end
                    allRed = false
                    if not newPad then
                        newPad = pad
                    end
                end
            end
            return newPad, allRed
        end

        while monitorLoopActive do
            local touchPart = getHRP()
            if touchPart then
                -- 1. Check if we need to select a new pad (every 3 mins or if current is gone)
                if not selectedPad or not selectedPad.Parent or (os.clock() - lastSwap) > 180 then
                    -- Restore old pad
                    if selectedPad and selectedPad.Parent then
                        local oldHead = selectedPad:FindFirstChild("Head")
                        if oldHead and originalCFs[oldHead] then
                            oldHead.CFrame = originalCFs[oldHead]
                        end
                    end
                    
                    local newPad, allRed = selectNewPad()
                    
                    if allRed then
                        if clickDetector then
                            clickDetector.MaxActivationDistance = 99999
                            pcall(function() fireclickdetector(clickDetector) end)
                        end
                        task.wait(1) -- Wait for regen
                        for _, pad in ipairs(adminPads) do
                            local head = pad:FindFirstChild("Head")
                            if head then originalCFs[head] = head.CFrame end
                        end
                        selectedPad = nil
                        lastSwap = os.clock()
                    else
                        selectedPad = newPad
                        lastSwap = os.clock()
                    end
                end
                
                -- 2. Process the selected pad
                if selectedPad and selectedPad.Parent then
                    local head = selectedPad:FindFirstChild("Head")
                    if head and head:IsA("BasePart") then
                        if head.BrickColor == BrickColor.new("Dark green") then
                            head.CanCollide = false
                            head.CFrame = touchPart.CFrame
                            pcall(function()
                                firetouchinterest(head, touchPart, 0)
                                firetouchinterest(head, touchPart, 1)
                            end)
                        elseif head.BrickColor == BrickColor.new("Bright red") then
                            if originalCFs[head] then
                                head.CFrame = originalCFs[head]
                            end
                        end
                    end
                end
            end
            task.wait(0.01)
        end
        autoAdminThread = nil
    end)
    notify("Auto Admin", "Started")
end

local function stopAutoAdmin()
    if autoAdminThread then task.cancel(autoAdminThread) autoAdminThread = nil end
    notify("Auto Admin", "Stopped")
end

local function claimAllAdminPads()
    if not initAdminPads() then return end
    local hrp = getHRP()
    if not hrp then return end
    local claimed = 0
    for _, pad in ipairs(adminPads) do
        local head = pad:FindFirstChild("Head")
        if head and head:IsA("BasePart") and head.BrickColor == BrickColor.new("Dark green") then
            local origCF = head.CFrame
            head.CanCollide = false
            local running = true
            task.spawn(function()
                while running do
                    head.CFrame = hrp.CFrame
                    pcall(function() firetouchinterest(head, hrp, 0) firetouchinterest(head, hrp, 1) end)
                    task.wait(0.01)
                end
            end)
            local elapsed = 0
            while elapsed < 3 do
                if head.BrickColor == BrickColor.new("Bright red") then
                    running = false
                    head.CFrame = origCF
                    claimed = claimed + 1
                    break
                end
                task.wait(0.02)
                elapsed = elapsed + 0.02
            end
            running = false
            head.CFrame = origCF
        end
    end
    notify("Claim All", "Claimed " .. claimed .. " pads")
end

