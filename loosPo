    --   -- the command inside EXECUTES and the bar collapses back to ]
    -- ---------------------------------------------------------------
    local expanded = false
    local fadeToken = 0
    -- example obj4 is "supposed to fade in/out": the input box (and any
    -- visible predictions) tween their transparency over 8 quick steps.
    local function fadeBar(open)
        fadeToken = fadeToken + 1
        local my = fadeToken
        task.spawn(function()
            local steps = 8
            for s = 1, steps do
                if my ~= fadeToken then return end
                local a = s / steps
                pcall(function()
                    box.BackgroundTransparency = open and (1 - a * 0.5) or (0.5 + a * 0.5)
                    box.TextTransparency = open and (1 - a) or a
                    for _, r in ipairs(sugRows) do
                        if r.Visible then
                            r.BackgroundTransparency = open and (0.3 + (1 - a) * 0.7) or (0.3 + a * 0.7)
                            r.TextTransparency = open and (1 - a) or a
                        end
                    end
                end)
                task.wait(0.025)
            end
            if not open and my == fadeToken then
                pcall(function()
                    box.Visible = false
                    for _, r in ipairs(sugRows) do r.Visible = false end
                end)
            end
        end)
    end
    local function expandBar()
        if expanded then return end
        expanded = true
        box.Visible = true
        box.BackgroundTransparency = 1
        box.TextTransparency = 1
        fadeBar(true)
        box:CaptureFocus()
    end
    local function collapseBar()
        if not expanded then return end
        expanded = false
        hideSuggestions()
        fadeBar(false)
