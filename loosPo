-- =====================================================================
-- \\ Persistent Banlist (v3.3.8, user request) // --
-- Every ban is SAVED to workspace/KAHX_bans.json as a full record:
--     {UserId = 123, Name = "xNoob", DisplayName = "X Noob"}
-- The save keeps userid + username + displayname so a banned player
-- who LEAVES can still be found and un-banned later: .unban accepts
-- ANY of the three (the lookup checks userid first, then username,
-- then displayname -- displayname also matches as a substring). The
-- file loads at startup (banLoad below) and re-saves on every ban /
-- unban / clear, so the list survives reboots of the executor too.
-- Without file support everything falls back to session-only memory.
-- =====================================================================
local function banSave()
    -- snapshot before encoding: banRecords mutates across threads
    -- (the join monitor can ban through future-loopkill paths)
    local snap = {}
    for _, r in ipairs(S.banRecords) do table.insert(snap, r) end
    if not FS.ok() then return false end
    local json = FS.encode(snap)
    if json and FS.write(CFG.FILE_BANS, json) then return true end
    print("[KAHX Bans] save to workspace/" .. CFG.FILE_BANS .. " failed")
    return false
end

-- banLoad(): startup restore -- reads the saved records back, rebuilds
-- banRecords AND the runtime id list the join monitor checks
local function banLoad()
    if not FS.ok() then return end
    local raw = FS.read(CFG.FILE_BANS)
    if not raw then return end
    local data = FS.decode(raw)
    if type(data) ~= "table" then return end
    S.banRecords = {}
    for _, r in ipairs(data) do
        if type(r) == "table" and r.UserId ~= nil then
            table.insert(S.banRecords, {
                UserId      = tonumber(r.UserId) or r.UserId,
                Name        = tostring(r.Name or ""),
                DisplayName = tostring(r.DisplayName or ""),
            })
            if not table.find(S.bannedPlayers, r.UserId) then
                table.insert(S.bannedPlayers, r.UserId)
            end
        end
    end
    if #S.banRecords > 0 then
        print("[KAHX Bans] loaded " .. #S.banRecords .. " saved ban(s) from workspace/" .. CFG.FILE_BANS)
    end
end

-- banUpsert(id, name, disp): add or refresh a record (keeps the
-- runtime id list in sync with the saved records)
local function banUpsert(id, name, disp)
    for _, r in ipairs(S.banRecords) do
        if r.UserId == id then
            r.Name = name or r.Name
            r.DisplayName = disp or r.DisplayName
            if not table.find(S.bannedPlayers, id) then table.insert(S.bannedPlayers, id) end
            banSave()
            return
        end
    end
    table.insert(S.banRecords, {UserId = id, Name = name or "", DisplayName = disp or ""})
    if not table.find(S.bannedPlayers, id) then table.insert(S.bannedPlayers, id) end
    banSave()
end

-- banFind(q): matches userid OR username OR displayname -- exactly the
-- user spec ("the save saves their userid, display name, and username,
-- so u type it in: it checks"). userid compare is numeric; username and
-- displayname compares are case-insensitive; displayname also matches
-- as a substring so partial typing works.
local function banFind(q)
    q = tostring(q or "")
    if q == "" then return nil end
    local id = tonumber(q)
    local lq = string.lower(q)
    for _, r in ipairs(S.banRecords) do
        if id ~= nil and r.UserId == id then return r end
    end
    for _, r in ipairs(S.banRecords) do
        if r.Name ~= "" and string.lower(r.Name) == lq then return r end
    end
    for _, r in ipairs(S.banRecords) do
        local dn = string.lower(r.DisplayName or "")
        if dn ~= "" and (dn == lq or string.find(dn, lq, 1, true)) then return r end
    end
    return nil
end

-- banRemove(rec): drops the record + the runtime id, re-saves the file
local function banRemove(rec)
    for i, r in ipairs(S.banRecords) do
        if r == rec then table.remove(S.banRecords, i) break end
    end
    local idx = table.find(S.bannedPlayers, rec.UserId)
    if idx then table.remove(S.bannedPlayers, idx) end
    banSave()
end

-- load the saved banlist immediately (this part runs once at script
-- load, after the FS helpers in p08 are already defined)
banLoad()

