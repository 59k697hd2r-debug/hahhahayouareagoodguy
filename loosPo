local function getFilteredParts()
    local validNames = {Part = true, Truss = true, Wedge = true, CornerWedge = true, Seat = true}
    local terrain = Workspace:FindFirstChild("Terrain")
    local tabby = Workspace:FindFirstChild("Tabby")
    local parts = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and validNames[v.Name] then
            local skip = false
            local model = v:FindFirstAncestorOfClass("Model")
            if model and Players:GetPlayerFromCharacter(model) then skip = true end
            if not skip and terrain and v:IsDescendantOf(terrain) then skip = true end
            if not skip and tabby and v:IsDescendantOf(tabby) then skip = true end
            if not skip and Variables.SKickFolder and v:IsDescendantOf(Variables.SKickFolder) then skip = true end
            if not skip then table.insert(parts, v) end
        end
    end
    return parts
end

local function syncParts(parts, unanchor, nocol)
    local endpoint = getSyncAPI()
    if not endpoint then
        ensureF3X()
        local waited = 0
        while not endpoint and waited < 3 do
            task.wait(0.1)
            waited = waited + 0.1
            endpoint = getSyncAPI()
        end
    end
    if not endpoint then return end
    local batch = {}
    for i, v in ipairs(parts) do
        local entry = {Part = v}
        if unanchor then entry.CFrame = v.CFrame entry.Anchored = false end
        if nocol then entry.CanCollide = false end
        table.insert(batch, entry)
        if #batch == 5000 then
            if unanchor then pcall(function() endpoint:InvokeServer("SyncAnchor", batch) end) end
            if nocol then pcall(function() endpoint:InvokeServer("SyncCollision", batch) end) end
            batch = {}
            task.wait(0.01)
        end
    end
    if #batch > 0 then
        if unanchor then pcall(function() endpoint:InvokeServer("SyncAnchor", batch) end) end
        if nocol then pcall(function() endpoint:InvokeServer("SyncCollision", batch) end) end
    end
end

