-- chatSystem (v3.3.3 CHAT REWORK -- "it still doesn't say anything"):
-- ROOT CAUSE #2 FOUND. TextChatService.TextChannels.RBXGeneral EXISTS on
-- modern clients even in legacy-chat games -- but in those games the
-- server simply ignores channel sends. The v3.3 order checked the channel
-- FIRST, "succeeded" (SendAsync never errors), returned true and the
-- message vanished into the void. The user-verified working method is
-- the classic remote, so the order is now:
--   1. ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest
--        :FireServer(msg, "System")      <- PRIMARY (exactly the user's
--                                            messagesystem() pattern;
--                                            channel = "System" per the
--                                            user's verified correction --
--                                            "System", NOT "All")
--   2. TextChatService.TextChannels.RBXGeneral:SendAsync / :Send
--      (only when the game has no legacy chat remote at all)
-- The remote is resolved ONCE at script load in a task.spawn with BOUNDED
-- WaitForChild timeouts, so nothing here can ever hang the script --
-- including on TextChatService-only games where the remote never exists.
--
-- Hidden chat (v3.3): RBXSystem is the system channel. Player sends are
-- refused by the server, so hidden messages are displayed locally with
-- DisplaySystemMessage -- you see them, nobody else does. Toggle with
-- .hsc (routes ALL script chat) or send one-off with .hiddenchat <text>.
local function chatFeedback(msg)
    local shown = false
    pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        local sys = channels and channels:FindFirstChild("RBXSystem")
        if sys and sys.DisplaySystemMessage then
            sys:DisplaySystemMessage(tostring(msg))
            shown = true
        end
    end)
    if not shown then
        pcall(function()
            StarterGui:SetCore("ChatMakeSystemMessage", {
                Text = tostring(msg),
                Color = Color3.fromRGB(0, 170, 255),
                Font = Enum.Font.SourceSansBold,
                TextSize = 18,
            })
        end)
    end
end

local function chatHidden(msg)
    msg = tostring(msg)
    pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        local sys = channels and channels:FindFirstChild("RBXSystem")
        if sys and sys.SendAsync then
            task.spawn(function()
                pcall(function() sys:SendAsync(msg) end)
            end)
        end
    end)
    -- Always echo locally: RBXSystem player-sends are server-blocked, so
    -- this is the only guaranteed delivery -- and it stays 100% hidden.
    chatFeedback("[KAHX hidden] " .. msg)
end

-- one-time async resolve of the legacy chat remote (non-blocking)
task.spawn(function()
    pcall(function()
        local evts = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 5)
        if evts then
            local smr = evts:WaitForChild("SayMessageRequest", 3)
            if smr and smr:IsA("RemoteEvent") then
                S.ChatEvent = smr
                print("[KAHX v3.3.8] Chat: legacy SayMessageRequest remote locked in (channel: System)")
            end
        end
    end)
end)

local function chatSystem(msg)
    msg = tostring(msg)
    if S.HiddenChat then
        chatHidden(msg)
        return true
    end
    -- 1) legacy remote -- PRIMARY, the user-verified method ("System")
    local ev = S.ChatEvent
    if ev and ev.Parent then
        local ok = pcall(function() ev:FireServer(msg, "System") end)
        if ok then return true end
        -- stale/broken remote: fall through to TCS
        S.ChatEvent = nil
    end
    -- 2) TextChatService fallback (only reached when the game has no
    --    legacy DefaultChatSystemChatEvents remote at all)
    local viaChannel = false
    pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        local general = channels and channels:FindFirstChild("RBXGeneral")
        if general then
            if general.SendAsync then
                task.spawn(function()
                    pcall(function() general:SendAsync(msg) end)
                end)
            elseif general.Send then
                pcall(function() general:Send(msg) end)
            end
            viaChannel = true
        end
    end)
    return viaChannel
end

