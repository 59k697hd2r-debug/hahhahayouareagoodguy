-- Workspace Hidden: reparents your character into an obfuscated F3X
-- folder under a decorative or hidden parent so other clients stop
-- rendering you. mon_hidden keeps respawned characters tucked.
-- ---------------------------------------------------------------------
function Antis.toggleWorkspaceHidden(state)
    S.workspaceHidden = state
    if state then
        if not S.hiddenFolder or not S.hiddenFolder.Parent then
            local hp = Workspace:FindFirstChild("Terrain") or getHiddenParent()
            if not hp then
                notify("Error", "No hidden parent found", 3)
                return
            end
            S.hiddenFolder = f3x({"CreateGroup", "Folder", hp, {}})
            if S.hiddenFolder then f3x({"SetName", {S.hiddenFolder}, getObfName()}) end
        end
        if LocalPlayer.Character and S.hiddenFolder then
            f3x({"SetParent", {LocalPlayer.Character}, S.hiddenFolder})
            f3x({"SetName", {LocalPlayer.Character}, getObfName()})
        end
    else
        if LocalPlayer.Character then
            f3x({"SetParent", {LocalPlayer.Character}, Workspace})
            f3x({"SetName", {LocalPlayer.Character}, LocalPlayer.Name})
        end
    end
end

-- ---------------------------------------------------------------------
-- Anti-Abuse (v3.3.6 FULL REWORK, user spec):
--   * THE SHIELD ("anti abuse antikillbrick"): instead of one small
--     translucent F3X part, build 2 FOLDERS with obfuscated names inside
--     "Realistic SunRays" (NOT "Realistic Bloom" -- user explicit); under
--     the 2nd folder sit 100 COPIES of one obfuscated part,
--     CanCollide = TRUE, spanning across the ENTIRE kill bricks (the
--     whole obby footprint + margin). Removing the feature just deletes
--     the parent folder -- everything under it goes with it.
--   * ANTI PUNISH ALL: every punished player (character parked in
--     Lighting) gets "unpunish <name>" said for them, with a 3s debounce
--     per victim so chat is not flooded.
--   * ANTI KILL ALL: every dead player gets "reset <name>" said for
--     them -- 2 tries, then it stops FOR THAT VICTIM for 45s (not for
--     everyone), and the tries counter clears the moment they respawn.
--   * unjail watcher kept (also debounced per victim now).
-- ---------------------------------------------------------------------
function Antis.buildAbuseShield()
    if Variables.AKBFolder and Variables.AKBFolder.Parent then
        notify("Anti-Abuse", "Shield already up (" .. tostring(S.akbCount or 0) .. " parts)", 3)
        return
    end
    local ob = findObby()
    if not ob then
        notify("Anti-Abuse", "No obby found - no kill bricks to cover", 3)
        return
    end
    -- user spec: parented to Realistic SunRays, not Realistic Bloom
    local hp = Workspace:FindFirstChild("Realistic SunRays") or getHiddenParent()
    if not hp then
        notify("Anti-Abuse", "No Realistic SunRays / hidden parent", 3)
        return
    end
    local okCf, cf, size = pcall(function()
        local c, s2 = ob:GetBoundingBox()
        return c, s2
    end)
    if not okCf or not cf then
        notify("Anti-Abuse", "Could not measure the obby", 3)
        return
    end
    local f1 = f3x({"CreateGroup", "Folder", hp, {}})
    if not f1 then
        notify("Anti-Abuse", "Shield folder failed (no F3X response)", 3)
        return
    end
    f3x({"SetName", {f1}, getObfName()})
    local f2 = f3x({"CreateGroup", "Folder", f1, {}})
    if f2 then f3x({"SetName", {f2}, getObfName()}) end
    Variables.AKBFolder = f1
    local holder = f2 or f1
    -- v3.3.6 "be bigger": span across the ENTIRE kill bricks -- the full
    -- obby footprint plus margin, as a walkable invisible lid on top.
    local top = cf.Position.Y + (size.Y or 0) / 2
    local lidCf = CFrame.new(cf.Position.X, top + 2, cf.Position.Z)
    local lidSize = Vector3.new((size.X or 30) + 10, 3, (size.Z or 30) + 10)
    S.akbCount = 0
    notify("Anti-Abuse", "Building shield: 100 parts over the kill bricks...", 4)
    task.spawn(function()
        for i = 1, 100 do
            if not (Variables.AKBFolder and Variables.AKBFolder.Parent) then return end
            local res = f3x({"CreatePart", "Normal", lidCf, holder})
            local part = res
            if type(res) == "table" then part = res[1] end
            if part then
                f3x({"SyncResize", {{Part = part, CFrame = lidCf, Size = lidSize}}})
                f3x({"SyncAnchor", {{Part = part, Anchored = true}}})
                f3x({"SyncCollision", {{Part = part, CanCollide = true}}})
                f3x({"SyncMaterial", {{Part = part, Transparency = 1}}})
                f3x({"SetName", {part}, getObfName()})
                S.akbCount = i
            end
            if i % 25 == 0 then
                notify("Anti-Abuse", "Shield parts: " .. i .. "/100", 2)
                task.wait(0.05)
            end
        end
        notify("Anti-Abuse", "Shield up: 100 CanCollide parts span the kill bricks", 4)
        print("[KAHX Anti-Abuse] shield: 2 obfuscated folders in Realistic SunRays -> 100 obfuscated CanCollide parts, span "
            .. tostring(math.floor(lidSize.X)) .. "x" .. tostring(math.floor(lidSize.Z)))
    end)
end

-- user spec: "if you want to remove it you simply delete the parent
-- (the folder)" -- one Remove on the root folder kills all 100 parts.
function Antis.removeAbuseShield()
    local f1 = Variables.AKBFolder
    Variables.AKBFolder = nil
    S.akbCount = 0
    if f1 and f1.Parent then
        f3x({"Remove", {f1}})
    end
end

