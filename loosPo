local old
old = hookmetamethod(game, "__namecall", function(self, ...)
    if chatCmdsEnabled and self == ChatEvent and getnamecallmethod() == "FireServer" and typeof(({...})[1]) == "string" then
        local args = {...}
        local msg = args[1]
        local lowerMsg = string.lower(msg)
        local parts = string.split(lowerMsg, " ")
        local cmd = parts[1]
        local arg1 = parts[2]
        local arg2 = parts[3]

        if lowerMsg == "prefix" or lowerMsg:find("^prefix ") then
            local newPrefix = msg:match("^prefix%s+(.+)$")
            if newPrefix and newPrefix ~= "" then
                commandPrefix = newPrefix
                chatSystem("Prefix changed to: " .. commandPrefix)
                return nil
            end
        end
        if lowerMsg == "prefix" then
            chatSystem("Current prefix: " .. commandPrefix)
            return nil
        end

        if not lowerMsg:find("^" .. commandPrefix) then
            return old and old(self, ...)
        end

        local cmdWithoutPrefix = string.sub(lowerMsg, #commandPrefix + 1)
        parts = string.split(cmdWithoutPrefix, " ")
        cmd = parts[1]
        arg1 = parts[2]
        arg2 = parts[3]

        if not cmd or cmd == "" then
            return old and old(self, ...)
        end

        local function executeWithTargets(input, commandFunc, delay, friendChoice)
            if not input or input == "" then
                chatSystem("Usage: " .. cmd .. " <player/random/all>")
                return
            end
            resolvePlayerInput(input, function(players)
                for i, player in ipairs(players) do
                    if delay and i > 1 then task.wait(delay) end
                    commandFunc(player)
                end
            end, friendChoice or false)
        end

        local function handleCrash(input)
            executeWithTargets(input, crashPlayer, 0.5, true)
        end

        local function handleLoopKill(input)
            if string.lower(input) == "all" then
                startLoopKill(input)
            else
                executeWithTargets(input, startLoopKill, 0.5, true)
            end
        end

        local function handleStopLoopKill(input)
            if string.lower(input) == "all" then
                stopLoopKill("all")
            else
                local target = getPlayerFromPartial(input)
                if target then
                    stopLoopKill(target.Name)
                else
                    chatSystem("Player not found")
                end
            end
        end

        local function handleBanLoopKill(input)
            if string.lower(input) == "all" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then banLoopKill(p) end
                end
            else
                executeWithTargets(input, banLoopKill, 0.5, true)
            end
        end

        local function handleUnbanLoopKill(input)
            if string.lower(input) == "all" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then unbanLoopKill(p) end
                end
            else
                executeWithTargets(input, unbanLoopKill, 0.5, true)
            end
        end

        local function handleGearban(input)
            executeWithTargets(input, function(p)
                addGearbanTarget(p)
                chatSystem("Now monitoring " .. p.Name .. " for gears")
            end, 0.5, false)
        end

        local function handleUngearban(input)
            executeWithTargets(input, function(p)
                removeGearbanTarget(p)
                chatSystem("Stopped monitoring " .. p.Name)
            end, 0.5, false)
        end

        local function handlePorta(input)
            executeWithTargets(input, function(p) porta(p.Name) end, 0.5, false)
        end

        local function handleBan(input)
            executeWithTargets(input, banPlayer, 0.5, false)
        end

        local function handleAfk(input)
            executeWithTargets(input, function(p) goAfk(p.Name) end, 0.5, false)
        end

        local function handleUnAfk(input)
            executeWithTargets(input, function(p) unAfk(p.Name) end, 0.5, false)
        end

        if cmd == "clr" then
            task.spawn(clearAll)
        elseif cmd == "clrall" then
            task.spawn(clearAllParts)
        elseif cmd == "adminclr" then
            task.spawn(adminClear)
        elseif cmd == "getinfo" then
            if arg1 then
                executeWithTargets(arg1, function(p)
                    notify("Player Info", "Name: " .. p.Name .. " | UserId: " .. p.UserId, 5)
                end, 0.5, false)
            else
                notify("Player Info", "Usage: .getinfo <player/random/all>", 3)
            end
        elseif cmd == "crash" or cmd == "kick" then
            if arg1 then handleCrash(arg1) else chatSystem("Usage: " .. commandPrefix .. "crash <player/random/all>") end
        elseif cmd == "loopkill" then
            if arg1 then handleLoopKill(arg1) else chatSystem("Usage: " .. commandPrefix .. "loopkill <player/random/all>") end
        elseif cmd == "unloopkill" or cmd == "stoploopkill" then
            if arg1 then handleStopLoopKill(arg1) else chatSystem("Usage: " .. commandPrefix .. "unloopkill <player/all>") end
        elseif cmd == "banloopkill" then
            if arg1 then handleBanLoopKill(arg1) else chatSystem("Usage: " .. commandPrefix .. "banloopkill <player/random/all>") end
        elseif cmd == "unbanloopkill" then
            if arg1 then handleUnbanLoopKill(arg1) else chatSystem("Usage: " .. commandPrefix .. "unbanloopkill <player/random/all>") end
        elseif cmd == "unancall" then
            task.spawn(unanchorAll)
        elseif cmd == "nocolall" then
            task.spawn(nocolAll)
        elseif cmd == "trollclr" then
            task.spawn(trollClr)
        elseif cmd == "rejoin" or cmd == "rj" then
            task.spawn(rejoin)
        elseif cmd == "hop" or cmd == "serverhop" then
            task.spawn(serverHop)
        elseif cmd == "gearban" or cmd == "gban" then
            if arg1 then handleGearban(arg1) else chatSystem("Usage: " .. commandPrefix .. "gearban <player/random/all>") end
        elseif cmd == "ungearban" or cmd == "ungban" then
            if arg1 then handleUngearban(arg1) else chatSystem("Usage: " .. commandPrefix .. "ungearban <player/random/all>") end
        elseif cmd == "gameinfo" then
            task.spawn(gameInfo)
        elseif cmd == "serverinfo" then
            task.spawn(serverInfo)
        elseif cmd == "porta" then
            if arg1 then handlePorta(arg1) else chatSystem("Usage: " .. commandPrefix .. "porta <player/random/all>") end
        elseif cmd == "loopws" then
            if arg1 then
                local num = tonumber(arg1)
                if num then
                    if loopWSActive then stopLoopWS() end
                    startLoopWS(num)
                    chatSystem("WalkSpeed loop started at " .. num)
                else
                    chatSystem("Invalid number. Usage: " .. commandPrefix .. "loopws <number>")
                end
            else
                if loopWSActive then
                    stopLoopWS()
                    chatSystem("WalkSpeed loop stopped")
                else
                    chatSystem("WalkSpeed loop not active. Usage: " .. commandPrefix .. "loopws <number>")
                end
            end
        elseif cmd == "loopjp" then
            if arg1 then
                local num = tonumber(arg1)
                if num then
                    if loopJPActive then stopLoopJP() end
                    startLoopJP(num)
                    chatSystem("JumpPower loop started at " .. num)
                else
                    chatSystem("Invalid number. Usage: " .. commandPrefix .. "loopjp <number>")
                end
            else
                if loopJPActive then
                    stopLoopJP()
                    chatSystem("JumpPower loop stopped")
                else
                    chatSystem("JumpPower loop not active. Usage: " .. commandPrefix .. "loopjp <number>")
                end
            end
        elseif cmd == "loopgravity" then
            if arg1 then
                local num = tonumber(arg1)
                if num then
                    if loopGravityActive then stopLoopGravity() end
                    startLoopGravity(num)
                    chatSystem("Gravity loop started at " .. num)
                else
                    chatSystem("Invalid number. Usage: " .. commandPrefix .. "loopgravity <number>")
                end
            else
                if loopGravityActive then
                    stopLoopGravity()
                    chatSystem("Gravity loop stopped")
                else
                    chatSystem("Gravity loop not active. Usage: " .. commandPrefix .. "loopgravity <number>")
                end
            end
        elseif cmd == "afk" then
            if arg1 then handleAfk(arg1) else chatSystem("Usage: " .. commandPrefix .. "afk <player/random/all>") end
        elseif cmd == "unafk" then
            if arg1 then handleUnAfk(arg1) else chatSystem("Usage: " .. commandPrefix .. "unafk <player/random/all>") end
        elseif cmd == "ban" then
            if arg1 then handleBan(arg1) else chatSystem("Usage: " .. commandPrefix .. "ban <player/random/all>") end
        elseif cmd == "unban" then
            if arg1 then unbanPlayer(arg1) else chatSystem("Usage: " .. commandPrefix .. "unban <name or User ID>") end
        elseif cmd == "freeze" then
            if arg1 then
                executeWithTargets(arg1, function(p) chatSystem("freeze " .. p.Name) end, 0.5, false)
            else
                chatSystem("Usage: " .. commandPrefix .. "freeze <player/random/all>")
            end
        elseif cmd == "thaw" then
            if arg1 then
                executeWithTargets(arg1, function(p) chatSystem("thaw " .. p.Name) end, 0.5, false)
            else
                chatSystem("Usage: " .. commandPrefix .. "thaw <player/random/all>")
            end
        elseif cmd == "blind" then
            if arg1 then
                executeWithTargets(arg1, function(p) chatSystem("blind " .. p.Name) end, 0.5, false)
            else
                chatSystem("Usage: " .. commandPrefix .. "blind <player/random/all>")
            end
        elseif cmd == "size" then
            if arg1 and arg2 then
                local target = getPlayerFromPartial(arg1)
                if target then
                    chatSystem("size " .. target.Name .. " " .. arg2)
                else
                    chatSystem("Player not found")
                end
            else
                chatSystem("Usage: " .. commandPrefix .. "size <player> <value>")
            end
        elseif cmd == "speed" then
            if arg1 and arg2 then
                local target = getPlayerFromPartial(arg1)
                if target then
                    chatSystem("speed " .. target.Name .. " " .. arg2)
                else
                    chatSystem("Player not found")
                end
            else
                chatSystem("Usage: " .. commandPrefix .. "speed <player> <value>")
            end
        elseif cmd == "reset" then
            if arg1 then
                executeWithTargets(arg1, function(p) chatSystem("reset " .. p.Name) end, 0.5, false)
            else
                chatSystem("Usage: " .. commandPrefix .. "reset <player/random/all>")
            end
        elseif cmd == "admin" then
            startAutoAdmin()
            chatSystem("Auto Admin started")
        elseif cmd == "unadmin" then
            stopAutoAdmin()
            chatSystem("Auto Admin stopped")
        end

        if silentCommands then
            return nil
        else
            return old and old(self, ...)
        end
    end
    return old and old(self, ...)
end)

local wasAlive = true
local debounce = false
local lastReTime = 0

task.spawn(function()
    while monitorLoopActive do
        local char = LocalPlayer.Character
        local isDead = false
        local isPunished = false
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then isDead = true end
            if char.Parent == Lighting then isPunished = true end
        end
        local isAlive = (char ~= nil and char.Parent == workspace and not isDead and not isPunished)
        if wasAlive and not isAlive then
            local now = tick()
            if not debounce and not suppressRe and (now - lastReTime > 1) then
                if (now - reCounterResetTime) > RE_WINDOW then
                    reCounter = 0
                    reCounterResetTime = now
                end
                reCounter = reCounter + 1
                if reCounter >= MAX_RE_COUNT then
                    chatSystem("respawn " .. LocalPlayer.Name)
                    reCounter = 0
                    reCounterResetTime = tick()
                else
                    chatSystem("re")
                end
                debounce = true
                lastReTime = now
                task.wait(0.4)
                debounce = false
            end
        end
        wasAlive = isAlive
        task.wait(0.05)
    end
end)

