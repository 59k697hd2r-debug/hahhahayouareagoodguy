local function syncParts(ps, ua, nc)
    local e = getSyncAPI()
    if not e then ensureF3X() local w = 0 while not e and w < 3 do task.wait(0.1) w = w + 0.1 e = getSyncAPI() end end
    if not e then return end
    local b = {}
    for _, v in ipairs(ps) do
        local en = {Part = v}
        if ua then en.CFrame = v.CFrame en.Anchored = false end
        if nc then en.CanCollide = false end
        table.insert(b, en)
        if #b == 5000 then
            if ua then pcall(function() e:InvokeServer("SyncAnchor", b) end) end
            if nc then pcall(function() e:InvokeServer("SyncCollision", b) end) end
            b = {}
            task.wait(0.01)
        end
    end
    if #b > 0 then
        if ua then pcall(function() e:InvokeServer("SyncAnchor", b) end) end
        if nc then pcall(function() e:InvokeServer("SyncCollision", b) end) end
    end
end

