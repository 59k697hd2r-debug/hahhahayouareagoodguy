Handler:AddCommand("skateboardkick", {Args = {"*Player*"}, Aliases = {"skick", "sk", "kick"}, Description = "Skateboard kicks (auto-setup + confirm y<=-505, ms). Targets: name | others | friends | nonfriends | a,b,c"}, function(A, F)
    if not A[1] or A[1] == "" then return end
    -- v3.3.6: multi-setup aware source picker -- prefer the primary
    -- folder, else promote the first setup folder that still has a
    -- platform (admins may have deleted some)
    local function getSkSourceFolder()
        if Variables.SKickFolder and Variables.SKickFolder.Parent
            and Variables.SKickFolder:FindFirstChildOfClass("SkateboardPlatform") then
            return Variables.SKickFolder
        end
        local found = nil
        pcall(function()
            for _, f in ipairs(Variables.SKSetups) do
                if f ~= Variables.SKickFolder and f.Parent
                    and f:FindFirstChildOfClass("SkateboardPlatform") then
                    found = f
                    break
                end
            end
        end)
        if found then Variables.SKickFolder = found end
        return found
    end
    if not getSkSourceFolder() then
        notify("Auto-Setup", "Setting up SK...", 3)
        local s = Handler.Commands["skateboardkicksetup"].callback({}, "")
        if not s or not getSkSourceFolder() then
            notify("Error", "Auto setup failed", 3)
            return
        end
    end
    resolvePlayerInput(joinTargetArgs(A), function(ps)
        for _, v in ipairs(ps) do
            if v ~= LocalPlayer or S.allowSelfTarget then
                task.spawn(function()
                    local kt = os.clock()
                    -- fix #7: balanced pause
                    local prevPause = S.pauseLoops
                    S.pauseLoops = true
                    local srcFolder = getSkSourceFolder()
                    local sourcePlatform = srcFolder and srcFolder:FindFirstChildOfClass("SkateboardPlatform") or nil
                    local kicked = false
                    local kickConn
                    if v.Character then
                        kickConn = v.Character.ChildAdded:Connect(function(m)
                            if m:IsA("Motor6D") then kicked = true end
                        end)
                    end
                    local cf = CFrame.new(math.random(10000, 100000), math.random(10000, 100000), math.random(10000, 100000))
                    local boss = v.Character and v.Character:FindFirstChildOfClass("SkateboardPlatform")
                    if not boss then
                        local res = f3x({"Clone", {sourcePlatform}, v.Character})
                        if type(res) == "table" then boss = res[1] else boss = res end
                    end
                    if boss then
                        if boss:FindFirstChild("Motor6D") then
                            kicked = true
                        else
                            f3x({"SyncResize", {{Part = boss, CFrame = cf, Size = Vector3.new(100, 100, 100)}}})
                            if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                                f3x({"SyncMove", {{Part = v.Character.HumanoidRootPart, CFrame = cf}}})
                            end
                        end
                    end
                    -- v3.3.4 CONFIRMATION (user spec): skick has WORKED only
                    -- when (a) the platform is INSIDE the target's model and
                    -- (b) the target is at y <= -505 (gone through the map).
                    -- The target leaving the game during the watch also
                    -- counts -- they left because the kick landed.
                    local confirmed = false
                    local cto = os.clock() + 25
                    while os.clock() < cto do
                        if not v.Parent then
                            confirmed = true
                            break
                        end
                        local ch = v.Character
                        if ch then
                            local plat = ch:FindFirstChildOfClass("SkateboardPlatform")
                            local hrp = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
                            if plat and hrp and hrp.Position.Y <= -505 then
                                confirmed = true
                                break
                            end
                        end
                        task.wait(0.05)
                    end
                    if kickConn then kickConn:Disconnect() end
                    if v.Parent and v.Character then
                        local toRemove = {}
                        for _, child in ipairs(v.Character:GetChildren()) do
                            if child:IsA("SkateboardPlatform") or string.lower(child.Name):find("skate") then
                                table.insert(toRemove, child)
                            end
                        end
                        if #toRemove > 0 then f3x({"Remove", toRemove}) end
                        if confirmed and kicked then f3x({"Remove", {v.Character}}) end
                    end
                    S.pauseLoops = prevPause
                    -- v3.3.4: dualkick sequencing
                    S.kickDone[v.UserId] = os.clock()
                    local ft = tostring(math.floor((os.clock() - kt) * 1000))
                    if confirmed then
                        notify("Kicked " .. v.DisplayName, "confirmed " .. ft .. "ms", 3)
                        print("[KAHX] Skateboard kick CONFIRMED for " .. v.DisplayName .. " in " .. ft .. "ms (platform in model + y<=-505)")
                        stats.playersSkicked = stats.playersSkicked + 1
                    else
                        notify("Kick", "No confirm for " .. v.DisplayName .. " (" .. ft .. "ms)", 3)
                        print("[KAHX] Skateboard kick NOT confirmed for " .. v.DisplayName .. " after " .. ft .. "ms")
                    end
                end)
            end
        end
    end, S.allowSelfTarget)
end)

-- v3.3.6 MULTI-SETUP (user: ".sks 2" -> 2 setups, same with pks):
-- each .pks unit is its own hidden PointLight with a Tool inside, ALL
-- under "Realistic SunRays" (NOT "Realistic Bloom"). Variables.PKSetups
-- tracks every light; Variables.PKS stays pointed at the newest one.
-- v3.3.7 (user: "setup one of each then copy them for the amount"):
-- .pks builds ONE complete light+tool setup and F3X-CLONES it for the
-- remaining units -- one server call each instead of the full gear /
-- light / rename dance; a failed clone falls back to a full rebuild.
local function doSinglePkSetup()
    local hp = Workspace:FindFirstChild("Realistic SunRays") or getHiddenParent()
    local TempPart = f3x({"CreatePart", "Normal", CFrame.new(0, 0, 0), hp})
    if not TempPart then
        notify("Error", "PK setup failed (no F3X response)", 3)
        return nil
    end
    f3x({"CreateLights", {{Part = TempPart, LightType = "PointLight"}}})
    f3x({"SyncLighting", {{Part = TempPart, LightType = "PointLight", Brightness = 0}}})
    local PKSLight = TempPart:WaitForChild("PointLight", 5)
    if not PKSLight then
        notify("Error", "PK setup failed (no PointLight)", 3)
        return nil
    end
    f3x({"SetName", {PKSLight}, getObfName()})
    f3x({"Ungroup", {TempPart}})
    chatSystem("gear me ??")
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local Tool = bp and bp:WaitForChild("Tool", 5)
    if not Tool then
        notify("Error", "Failed to get tool for potato setup.", 3)
        return nil
    end
    Tool.Parent = LocalPlayer.Character
    f3x({"SetParent", {Tool}, PKSLight})
    f3x({"SetName", {Tool}, getObfName()})
    table.insert(Variables.PKSetups, PKSLight)
    Variables.PKS = PKSLight
    return PKSLight
end

local function countPkSetups()
    local n = 0
    pcall(function()
        for _, l in ipairs(Variables.PKSetups) do
            if l and l.Parent and l:FindFirstChildOfClass("Tool") then n = n + 1 end
        end
    end)
    return n
end

Handler:AddCommand("potatokicksetup", {Args = {"Count?"}, Aliases = {"pks"}, Description = "Sets up the potato kick: .pks = 1, .pks 3 = 3 setups (builds 1, clones the rest)"}, function(A, F)
    if S.pksSetupInProgress then return end
    local want = math.clamp(tonumber(A[1]) or 1, 1, 10)
    local have = countPkSetups()
    if have >= want and Variables.PKS then return true end
    S.pksSetupInProgress = true
    local made = 0
    -- v3.3.7 clone pipeline (same shape as the SK one): pick a surviving
    -- light as the clone source (fresh build when none exists), clone it
    -- until the count is hit, guard the loop, fall back to a full build
    -- any time the F3X clone comes back empty or broken.
    local base = nil
    if have == 0 then
        notify("PK Setup", "Building setup 1/" .. want .. "...", 3)
        base = doSinglePkSetup()
        if base then made = made + 1 end
    else
        pcall(function()
            for _, l in ipairs(Variables.PKSetups) do
                if l and l.Parent and l:FindFirstChildOfClass("Tool") then
                    base = l
                    break
                end
            end
        end)
        if not base and Variables.PKS and Variables.PKS.Parent then
            base = Variables.PKS
        end
    end
    local guard = 0
    while countPkSetups() < want and guard < 20 do
        guard = guard + 1
        local cloned = false
        if base and base.Parent then
            local hp = Workspace:FindFirstChild("Realistic SunRays") or getHiddenParent()
            local res = hp and f3x({"Clone", {base}, hp}) or nil
            local clone = res
            if type(res) == "table" then clone = res[1] end
            if clone and clone.Parent then
                task.spawn(function() f3x({"SetName", {clone}, getObfName()}) end)
                table.insert(Variables.PKSetups, clone)
                Variables.PKS = clone
                cloned = true
                made = made + 1
            end
        end
        if not cloned then
            notify("PK Setup", "Clone unavailable - full building a setup...", 3)
            local light = doSinglePkSetup()
            if light then
                made = made + 1
                if not base then base = light end
            else
                break
            end
        end
        task.wait(0.2)
    end
    S.pksSetupInProgress = false
    if made > 0 and countPkSetups() > 0 then
        notify("Success", "Potato kick set up! (" .. countPkSetups() .. " total)", 3)
        return true
    end
    return false
end)

