local function clearByFilter(f, exc, ext, etb, ekf)
    local e = getSyncAPI()
    if not e then ensureF3X() local w = 0 while not e and w < 3 do task.wait(0.1) w = w + 0.1 e = getSyncAPI() end end
    if not e then return 0 end
    local tr = Workspace:FindFirstChild("Terrain")
    local tb = Workspace:FindFirstChild("Tabby")
    local ins = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if f(v) then
            local s = false
            if exc then
                local m = v:FindFirstAncestorOfClass("Model")
                if m and Players:GetPlayerFromCharacter(m) then s = true end
            end
            if not s and ext and tr and v:IsDescendantOf(tr) then s = true end
            if not s and etb and tb and v:IsDescendantOf(tb) then s = true end
            if not s and ekf and Variables.SKickFolder and v:IsDescendantOf(Variables.SKickFolder) then s = true end
            if not s and Variables.PKS and v == Variables.PKS then s = true end
            if not s then table.insert(ins, v) end
        end
    end
    if #ins == 0 then return 0 end
    for i = 1, #ins, 5000 do
        local b = {}
        for j = i, math.min(i + 4999, #ins) do table.insert(b, ins[j]) end
        pcall(function() e:InvokeServer("Remove", b) end)
        task.wait(0.01)
    end
    return #ins
end

