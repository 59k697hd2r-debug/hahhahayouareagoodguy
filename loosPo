-- === FRIEND TRACKING ===
local function updateFriends()
    local myUserId = LocalPlayer.UserId
    local success, friendPages = pcall(function()
        return Players:GetFriendsAsync(myUserId)
    end)
    if not success then return end
    local friendIds = {}
    while true do
        local page = friendPages:GetCurrentPage()
        for _, friend in ipairs(page) do
            table.insert(friendIds, friend.Id)
        end
        if friendPages.IsFinished then break end
        friendPages:AdvanceToNextPageAsync()
    end
    local newFriendsInGame = {}
    for _, friendId in ipairs(friendIds) do
        local success2, userPresent, friendPlaceId, friendJobId = pcall(function()
            return TeleportService:GetPlayerPlaceInstanceAsync(friendId)
        end)
        if success2 and userPresent and friendPlaceId == game.PlaceId then
            table.insert(newFriendsInGame, friendId)
        end
    end
    for _, fid in ipairs(newFriendsInGame) do
        if not table.find(friendsInGame, fid) then
            local success3, friendInfo = pcall(function()
                return Players:GetNameFromUserIdAsync(fid)
            end)
            if success3 then
                window:Toast({
                    title = "Friend joined!",
                    subtitle = friendInfo .. " is in your server.",
                    avatar = fid,
                })
            end
        end
    end
    friendsInGame = newFriendsInGame
    -- Update friends dropdown if exists
    if friendsDropdown then
        local options = {}
        for _, friendId in ipairs(friendsInGame) do
            local success, name = pcall(function()
                return Players:GetNameFromUserIdAsync(friendId)
            end)
            if success then
                table.insert(options, name .. " (" .. friendId .. ")")
            end
        end
        if #options == 0 then
            table.insert(options, "No friends in this game")
        end
        pcall(function()
            friendsDropdown:SetOptions(options)
        end)
    end
end

task.spawn(function()
