-- unban (v3.3.8, user request): type the userid, the username OR the
-- display name -- the saved records are checked across all three
-- fields, so a player who already LEFT can still be un-banned.
Handler:AddCommand("unban", {Args = {"*UserId/Name*"}, Aliases = {}, Description = "Unbans by userid, username OR displayname (checks the saved records)"}, function(A, F)
    local q = tostring(A[1] or "")
    local rec = banFind(q)
    if rec then
        banRemove(rec)
        notify("Success", "Unbanned: " .. rec.UserId .. " | @" .. tostring(rec.Name) .. " | " .. tostring(rec.DisplayName), 4)
        print("[KAHX Bans] unbanned by query \"" .. q .. "\" -> " .. rec.UserId .. " @" .. tostring(rec.Name))
        return
    end
    -- legacy fallback: a bare id sitting in the runtime list only
    local id = tonumber(q)
    if id then
        local idx = table.find(S.bannedPlayers, id)
        if idx then
            table.remove(S.bannedPlayers, idx)
            banSave()
            local s, un = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
            notify("Success", "Unbanned: " .. (s and un or tostring(id)), 3)
            return
        end
    end
    notify("Error", "No saved ban matches \"" .. q .. "\" (check .bans).", 3)
end)

