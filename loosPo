local function SetupChatHandler()
    local function processCommand(msg, prefix)
        if msg:sub(1, #prefix) ~= prefix then return false end
        local content = msg:sub(#prefix + 1)
        if content == "" then return false end
        local args = {}
        for word in content:gmatch("%S+") do table.insert(args, word) end
        if #args == 0 then return false end
        local cmdName = string.lower(args[1])
        local cmd = Handler.Commands[cmdName]
        if cmd then
            local cmdArgs = {}
            for i = 2, #args do table.insert(cmdArgs, args[i]) end
            task.spawn(function() cmd.callback(cmdArgs, table.concat(cmdArgs, " ")) end)
            return true
        end
        return false
    end

    local function handleChat(msg)
        if not msg or msg == "" then return end
        if recentMsgs[msg] then return end
        recentMsgs[msg] = true
        task.delay(1, function() recentMsgs[msg] = nil end)

        if chatCmdsToCode and msg:sub(1, 2) == ">." then
            local code = msg:sub(3)
            local fn, err = loadstring(code)
            if fn then task.spawn(fn) else notify("Code Error", err, 5) end
            return
        end

        if chatCmdBinds[msg] then
            local targetCmd = Handler.Commands[chatCmdBinds[msg]]
            if targetCmd then task.spawn(function() targetCmd.callback({}, "") end) return end
        end
        local lowerMsg = string.lower(msg)
        if chatCmdBinds[lowerMsg] then
            local targetCmd = Handler.Commands[chatCmdBinds[lowerMsg]]
            if targetCmd then task.spawn(function() targetCmd.callback({}, "") end) return end
        end

        if not chatCmdsEnabled then return end
        if msg:sub(1, #commandPrefix) == commandPrefix then
            processCommand(msg, commandPrefix)
        elseif msg:sub(1, #silentPrefix) == silentPrefix then
            silentCommands = true
            processCommand(msg, silentPrefix)
            task.delay(0.1, function() silentCommands = false end)
        end
    end

    LocalPlayer.Chatted:Connect(function(msg) handleChat(msg) end)

    if TextChatService then
        pcall(function()
            TextChatService.SendingMessage:Connect(function(message)
                handleChat(message.Text or "")
            end)
        end)
        pcall(function()
            TextChatService.MessageReceived:Connect(function(message)
                if message.TextSource and message.TextSource.UserId == LocalPlayer.UserId then
                    handleChat(message.Text or "")
                end
            end)
        end)
    end

    pcall(function()
        local ChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if ChatEvents then
            local OnMessageDoneFiltering = ChatEvents:FindFirstChild("OnMessageDoneFiltering")
            if OnMessageDoneFiltering then
                OnMessageDoneFiltering.OnClientEvent:Connect(function(msgData)
                    if msgData and msgData.FromSpeaker == LocalPlayer.Name then
                        handleChat(msgData.Message or "")
                    end
                end)
            end
        end
    end)
end

