-- v3.3.5 ORDER FIX (user request): SKICK FIRST, THEN pkick -- doing the
-- potato kick first bugged the target's character model (the tool clone +
-- character removal race left the model in a broken state the skick clone
-- then glued itself to). Both phases still run strictly one after the
-- other via the S.kickDone completion stamps, so the pauseLoops
-- save/restore of each kick never interleaves.
Handler:AddCommand("dualkick", {Args = {"*Player*"}, Aliases = {"dk", "dualk"}, Description = "Dual kicks: SKATEBOARD kick FIRST, then potato kick (fixed order, v3.3.5)"}, function(A, F)
    if not A[1] or A[1] == "" then return end
    resolvePlayerInput(joinTargetArgs(A), function(ps)
        for _, v in ipairs(ps) do
            if v ~= LocalPlayer or S.allowSelfTarget then
                task.spawn(function()
                    notify("Dualkick", "SK phase on " .. v.DisplayName .. " first", 3)
                    local stamp0 = S.kickDone[v.UserId]
                    Handler.Commands["skateboardkick"].callback({v.Name}, "")
                    -- wait for the skick thread to actually finish (its
                    -- completion stamp) before launching the pkick, so the
                    -- two kicks' pauseLoops save/restore never interleave
                    local t0 = os.clock()
                    while os.clock() - t0 < 45 do
                        if not v.Parent then break end
                        local st = S.kickDone[v.UserId]
                        if st and st ~= stamp0 then break end
                        task.wait(0.1)
                    end
                    if v.Parent then
                        notify("Dualkick", "SK phase done - starting PK phase", 3)
                        Handler.Commands["potatokick"].callback({v.Name}, "")
                    end
                end)
            end
        end
    end, S.allowSelfTarget)
end)

