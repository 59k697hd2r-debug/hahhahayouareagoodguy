-- lists the memory saves AND every KAHX_map_*.json in the workspace
-- folder so saves made in previous sessions are visible.
Handler:AddCommand("delmap", {Args = {"*Name*"}, Aliases = {}, Description = "Deletes a saved map (memory + workspace file)"}, function(A, F)
    -- fix #12: no table[nil] indexing
    local name = tostring(A[1] or "")
    local removedFile = false
    if FS.exists(mapFileName(name)) then
        removedFile = FS.del(mapFileName(name))
    end
    if mapSaves[name] then
        if loadedMapGroups[name] and loadedMapGroups[name].Parent then
            f3x({"Remove", {loadedMapGroups[name]}})
        end
        mapSaves[name] = nil
        loadedMapGroups[name] = nil
        notify("Map Saver", "Deleted \"" .. name .. "\"" .. (removedFile and " (file too)" or ""), 3)
    elseif removedFile then
        notify("Map Saver", "Deleted file \"" .. mapFileName(name) .. "\"", 3)
    else
        notify("Map Saver", "No save named \"" .. name .. "\"", 3)
    end
end)

Handler:AddCommand("maps", {Args = {}, Aliases = {}, Description = "Lists saved maps (memory + workspace folder files)"}, function(A, F)
    local str = "\nmemory saves:\n"
    local n = 0
    local seen = {}
    pcall(function()
        for nm, m in pairs(mapSaves) do
            seen[nm] = true
            n = n + 1
            str = str .. nm .. " (" .. #m .. " parts)\n"
        end
    end)
    if n == 0 then str = str .. "(none)\n" end
    -- v3.3.7: scan the executor workspace folder for map files
    local fileMaps = {}
    pcall(function()
        for _, f in ipairs(FS.list()) do
            local base = tostring(f):match("[^/\\]+$") or tostring(f)
            local mn = base:match("^" .. CFG.MAP_FILE_PREFIX .. "(.*)" .. CFG.MAP_FILE_EXT .. "$")
            if mn and mn ~= "" and not seen[mn] then
                seen[mn] = true
                table.insert(fileMaps, mn)
            end
        end
    end)
    table.sort(fileMaps)
    str = str .. "workspace files:\n"
    if #fileMaps > 0 then
        for _, mn in ipairs(fileMaps) do str = str .. mn .. " (" .. CFG.MAP_FILE_PREFIX .. mn .. CFG.MAP_FILE_EXT .. ")\n" end
    else
        str = str .. "(none)\n"
    end
    print(str)
    notify("Map Saver", "Check developer console", 3)
end)

