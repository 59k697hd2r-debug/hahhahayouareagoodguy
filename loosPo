Handler:AddCommand("droptool", {Args = {"Tool?"}, Aliases = {"drop"}, Description = "Drops a tool: equips it first, then parents it to workspace (already-equipped tools are parented directly). Arg: tool name (drops every match) or empty = current tool"}, function(A, F)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then
        notify("Drop Tool", "No character or humanoid alive", 3)
        return
    end
    local wanted = string.lower(table.concat(A, " "))
    local drops = {}
    if wanted ~= "" then
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        local pools = {char}
        if bp then table.insert(pools, bp) end
        for _, pool in ipairs(pools) do
            for _, t in ipairs(pool:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), wanted, 1, true) then
                    table.insert(drops, t)
                end
            end
        end
        if #drops == 0 then
            notify("Drop Tool", "No tool matched \"" .. wanted .. "\"", 3)
            return
        end
    else
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped then
            table.insert(drops, equipped)
        else
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            local first = bp and bp:FindFirstChildOfClass("Tool")
            if first then
                table.insert(drops, first)
            else
                notify("Drop Tool", "Nothing equipped and no tools in the backpack", 3)
                return
            end
        end
    end
    for _, t in ipairs(drops) do
