Handler:AddCommand("savebinds", {Args = {}, Aliases = {}, Description = "Saves ALL keybinds + chatbinds to the workspace folder (KAHX_binds.json)"}, function(A, F)
    if not FS.ok() then
        notify("Binds Save", "Executor has no writefile/readfile -- cannot save", 3)
        return
    end
    -- snapshot both bind tables first (they mutate on other threads)
    local data = {keys = {}, chat = {}}
    pcall(function()
        for k, v in pairs(KeyBinds) do data.keys[k] = tostring(v) end
    end)
    pcall(function()
        for p, c in pairs(S.chatBinds or {}) do data.chat[tostring(p)] = tostring(c) end
    end)
    local json = FS.encode(data)
    if json and FS.write(CFG.FILE_BINDS, json) then
        local nk, nc = 0, 0
        for _ in pairs(data.keys) do nk = nk + 1 end
        for _ in pairs(data.chat) do nc = nc + 1 end
        notify("Binds Save", nk .. " keybind(s) + " .. nc .. " chatbind(s) -> workspace/" .. CFG.FILE_BINDS, 4)
        print("[KAHX Profiles] binds saved: workspace/" .. CFG.FILE_BINDS)
    else
        notify("Binds Save", "Write failed (check console)", 3)
    end
end)

Handler:AddCommand("loadbinds", {Args = {}, Aliases = {}, Description = "Loads the saved keybinds + chatbinds from the workspace folder"}, function(A, F)
    local raw = FS.read(CFG.FILE_BINDS)
    local data = raw and FS.decode(raw)
    if not data or (type(data.keys) ~= "table" and type(data.chat) ~= "table") then
        notify("Binds Load", "No valid workspace/" .. CFG.FILE_BINDS .. " (use .savebinds first)", 3)
        return
    end
    local nk, nc = 0, 0
    pcall(function()
        for k, v in pairs(data.keys or {}) do
            KeyBinds[tostring(k)] = tostring(v)
            nk = nk + 1
        end
    end)
    pcall(function()
        for p, c in pairs(data.chat or {}) do
            S.chatBinds[string.lower(tostring(p))] = tostring(c)
            nc = nc + 1
        end
    end)
    notify("Binds Load", "Restored " .. nk .. " keybind(s) + " .. nc .. " chatbind(s)", 4)
    print("[KAHX Profiles] binds loaded from workspace/" .. CFG.FILE_BINDS)
end)

