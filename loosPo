    -- still drive the loading screen even when the build died halfway
    local LH = { gui = nil, status = nil, fill = nil, fail = nil, skipped = false }

    local okUI, errUI = pcall(function()
    -- -----------------------------------------------------------------
    -- v3.3.6 PARENTING (user spec, twice + their example code): the
    -- KAHX_UI FOLDER goes into the PLAIN CoreGui FIRST, gethui() second,
    -- PlayerGui as the last resort. Both ScreenGuis live INSIDE it.
    -- -----------------------------------------------------------------
    local function parentHidden(f)
        local ok = pcall(function() f.Parent = CoreGui end)
        if ok and f.Parent then return true end
        local ok2 = pcall(function()
            local hui = (type(gethui) == "function") and gethui() or nil
            f.Parent = hui
        end)
        if ok2 and f.Parent then return true end
        local ok3 = pcall(function()
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                or LocalPlayer:WaitForChild("PlayerGui", 5)
            f.Parent = pg
        end)
        if ok3 and f.Parent then return true end
        return false
    end

    local uiFolder = Instance.new("Folder")
    uiFolder.Name = "KAHX_UI"
    if not parentHidden(uiFolder) then
        error("KAHX_UI folder could not be parented to gethui/CoreGui/PlayerGui")
    end

    -- -----------------------------------------------------------------
    -- mk() -- THE USER'S FIXED BUILDER (v3.3.8). The old version treated
    -- every props entry as a normal property, so a Parent key inside
    -- props was applied mid-loop and could wipe the parentage target --
    -- the root cause of "only the screengui gets created". This version:
    --   * pulls Parent OUT of props first and uses it as the target
    --   * never sets Parent as a normal property (skipped in the loop)
    --   * only parents when an actual target exists ("never wipe to nil")
    --   * every property + the parenting itself stay pcall'd, skipped +
    --     logged instead of killing the entire UI build
    -- -----------------------------------------------------------------
    local function mk(class, props, parent)
        local inst = Instance.new(class)
        local wantParent = parent
        if type(props) == "table" then
            -- pull Parent out of props so it is never set as a normal property
            if props.Parent ~= nil then
                wantParent = props.Parent
            end
            for k, v in pairs(props) do
                if k == "Parent" then
                    -- skip; applied once at the end
                elseif k == "Name" then
                    inst.Name = v
                else
                    local okp = pcall(function() inst[k] = v end)
                    if not okp then
                        pcall(function()
                            print("[KAHX UI] skipped property " .. class .. "." .. tostring(k) .. " (not supported here)")
                        end)
                    end
                end
            end
        end
        -- only parent when we actually have a target (never wipe to nil)
        if wantParent then
            local okp2 = pcall(function() inst.Parent = wantParent end)
            if not okp2 then
                pcall(function()
                    warn("[KAHX UI] could not parent " .. class .. " into " .. tostring(wantParent.Name or wantParent))
                end)
            end
        end
        return inst
    end

