    -- matches directly, the SIMILAR commands are shown instead so a typo
    -- in the search still lands somewhere useful.
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(searchBox.Text)
        local vis = 0
        for _, item in ipairs(listItems) do
            local en = itemEntries[item]
            local hit = (q == "")
            if en and not hit then
                local nm = string.lower(en.name or "")
                if string.find(nm, q, 1, true) then hit = true end
                if not hit then
                    for _, a in ipairs(en.config.Aliases or {}) do
                        if string.find(string.lower(a), q, 1, true) then hit = true break end
                    end
                end
                if not hit then
                    local dsc = string.lower(tostring(en.config.Description or ""))
                    if string.find(dsc, q, 1, true) then hit = true end
                end
            end
            item.Visible = hit
            if hit then vis = vis + 1 end
        end
        if vis == 0 and q ~= "" then
            local sims = findSimilar(q, 6)
            local simMap = {}
            for _, s in ipairs(sims) do simMap[s] = true end
            for _, item in ipairs(listItems) do
                local en = itemEntries[item]
                if en and simMap[en.name] then
                    item.Visible = true
                    vis = vis + 1
                end
            end
            searchHint.Text = (#sims > 0) and ("no exact match -- similar: " .. table.concat(sims, ", ")) or "no match"
        else
            searchHint.Text = ""
        end
    end)

    -- drag by the title bar
    local lDragging, lDragStart, lStartPos = false, nil, nil
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            lDragging = true
            lDragStart = input.Position
            lStartPos = lroot.Position
        end
    end)
    conn(UserInputService.InputChanged:Connect(function(input)
        if lDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - lDragStart
            lroot.Position = UDim2.new(
                lStartPos.X.Scale, lStartPos.X.Offset + delta.X,
                lStartPos.Y.Scale, lStartPos.Y.Offset + delta.Y)
        end
    end))
    conn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            lDragging = false
        end
    end))

    -----------------------------------------------------------------
    -- MILESTONE 5: hooks for the rest of the script + watchdog
    -----------------------------------------------------------------
    pulse("finishing...", 0.95)

    -- v3.3.7: the contents are ALL built -- only NOW do the finished,
    -- fully populated screens enter the KAHX_UI folder. If the folder
    -- write is blocked, the full fallback chain (CoreGui -> gethui ->
    -- PlayerGui) is tried per screen instead of killing the build.
    pcall(function() barGui.Parent = uiFolder end)
    if not (barGui and barGui.Parent) then parentHidden(barGui) end
    pcall(function() listGui.Parent = uiFolder end)
    if not (listGui and listGui.Parent) then parentHidden(listGui) end

    -- v3.3.7 verification: prove the CORE elements really exist before
    -- declaring the UI ready. Anything missing fails the load with the
    -- exact user-spec message ("ui did not be created") + the real
    -- reason on the console, instead of silently showing half a UI.
    local missingUI = {}
    if not (expandBtn and expandBtn.Parent) then table.insert(missingUI, "cmdbar ] button") end
    if not (box and box.Parent) then table.insert(missingUI, "cmdbar input box") end
    local sugOk = 0
    for _, r in ipairs(sugRows) do
        if r and r.Parent then sugOk = sugOk + 1 end
    end
    if sugOk < 3 then table.insert(missingUI, "prediction rows (" .. sugOk .. "/5)") end
    if not (lroot and lroot.Parent) then table.insert(missingUI, "cmdlist panel") end
    if not (listScroll and listScroll.Parent) then table.insert(missingUI, "cmdlist scroll list") end
    if #listItems == 0 then table.insert(missingUI, "cmdlist items") end
    if #missingUI > 0 then
        error("ui did not be created -- missing: " .. table.concat(missingUI, ", "))
    end

    -- v3.3.1: cmdlist toggles (run .cmdlist again to close it)
    S.ShowCmdList = function()
        listGui.Enabled = not listGui.Enabled
        return listGui.Enabled
    end

    -- v3.3.1: .cmdbar toggle so the bar can never be "lost"
    -- v3.3.5: re-parents the whole KAHX_UI folder if the executor
    -- flushed it, and drops the bar back into the folder if needed
    S.ToggleCmdBar = function()
        barGui.Enabled = not barGui.Enabled
        if barGui.Enabled then
            if not uiFolder.Parent then parentHidden(uiFolder) end
            if barGui.Parent ~= uiFolder then
                pcall(function() barGui.Parent = uiFolder end)
            end
        end
        return barGui.Enabled
    end

    S.didYouMean = function(badName, args, full)
        -- respect the "unknown commands run as code" opt-in: it already
        -- handled the text before RunCommand was reached.
        local best = findBestMatch(badName)
        if not best then
            notify("Command Handler", "Invalid command: " .. badName, 3)
            return
        end
        showPopup(badName, best, full)
        logToConsole("[KAHX] Invalid command '" .. badName .. "' -> did you mean '" .. best .. "'")
    end

    -- v3.3.5: one Destroy on the folder tears down BOTH screens (bar +
    -- cmdlist) plus any leftover loading screen
    S.CloseAllCustomUI = function()
        -- v3.3.2: stops the re-parent watchdog
        S.CmdBarAlive = false
        pcall(function() uiFolder:Destroy() end)
    end

    -- v3.3.2 watchdog: re-parent the bar if the executor flushes it.
    -- v3.3.4 FATAL FIX kept: this watchdog lives INSIDE the pcall'd
    -- build closure, where "uiFolder"/"parentHidden" are real upvalues
    -- (running it outside compiled them as nil globals and threw
    -- "attempt to index nil with 'Parent'" 3s after every load).
    -- v3.3.5: it now watches the FOLDER and re-nests stray screens.
    S.CmdBarAlive = true
    task.spawn(function()
        while S.CmdBarAlive do
            task.wait(3)
            if S.CmdBarAlive then
                if not uiFolder.Parent then
                    if not parentHidden(uiFolder) then break end
                end
                if barGui.Parent ~= uiFolder then
                    pcall(function() barGui.Parent = uiFolder end)
                end
                if listGui.Parent ~= uiFolder then
                    pcall(function() listGui.Parent = uiFolder end)
                end
                -- v3.3.7: an executor that flushes CONTENTS leaves an
                -- alive-but-EMPTY screen; re-home it through the full
                -- fallback chain so the finished screens survive
                pcall(function()
                    if barGui.Parent and #barGui:GetChildren() == 0 then
                        parentHidden(barGui)
                        print("[KAHX UI] cmdbar screen was flushed empty -- re-homed via fallback chain")
                    end
                end)
            end
        end
    end)

    print("[KAHX v3.3.7] Command bar UI ready -- KAHX_UI folder in the CoreGui holds cmdbar + cmdlist (all elements verified)")
    if LH.gui and LH.status then
        pcall(function()
            LH.status.Text = "ui ready"
            LH.fill.BackgroundColor3 = COL_OK
            LH.fill.Size = UDim2.new(1, 0, 1, 0)
        end)
        task.delay(0.6, function()
            if LH.gui then
                pcall(function() LH.gui:Destroy() end)
                LH.gui = nil
                LH.status = nil
                LH.fill = nil
            end
        end)
    end
    -- close the pcall-wrapped UI build
    end)

    -- v3.3.2: a build failure used to die SILENTLY (the #2 "where is the
    -- UI?" cause). v3.3.5: surface it on the loading screen ("ui did not
    -- be created") + console, exactly per user spec.
    if not okUI then
        local msg = "[KAHX] UI build failed: " .. tostring(errUI)
        pcall(function() warn(msg) end)
        pcall(function() print(msg) end)
        if type(LH.fail) == "function" then
            pcall(LH.fail, errUI)
        else
            pcall(function() notify("KAHX UI", "ui did not be created", 6) end)
        end
    end
end)

-- =====================================================================
-- \\ Extras Pack (v3.2, fix #16) // --
-- fly, noclip, infjump, esp, ctp, spy, fullbright, nofog, speed,
-- jpower, rejoin.
-- Design rules kept from v3.1:
--   * every feature is a chat COMMAND, so every feature is BINDABLE
--     with the new .bind <Key> <command> syntax;
--   * all mutable state lives in S (no new top-level scalars);
--   * connections go through conn() so .unload cleans them;
--   * loops go through runLoop/stopLoop with a loopThreads key;
--   * everything except the Extras namespace lives inside one do-block,
--     so the whole pack costs the main chunk exactly ONE register.
-- =====================================================================
local Extras = {}

do
    local RunService = game:GetService("RunService")
    local TeleportService = game:GetService("TeleportService")

    -- -----------------------------------------------------------------
    -- shared helpers (block-local: released with the do-block)
    -- -----------------------------------------------------------------
    local function getHumanoid()
        local ch = LocalPlayer.Character
        if not ch then return nil end
        return ch:FindFirstChildOfClass("Humanoid")
    end

    -- -----------------------------------------------------------------
    -- FLY -- camera-relative movement on RenderStepped. W/S = look
    -- axis, A/D = right axis, Space = up, LeftControl = down. Speed is
    -- S.flySpeed (set with .flyspeed). Velocity-driven so it plays nice
    -- with most seat/anchor setups; turn OFF anti-fling if you fly at
    -- very high speeds (its velocity-spike rescue cannot tell them apart).
    -- -----------------------------------------------------------------
    local flyConn = nil

    local function stopFly()
        S.flyActive = false
        if flyConn then
            flyConn:Disconnect()
            flyConn = nil
        end
        local hrp = getHRP()
        if hrp then
            pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
        end
        local hum = getHumanoid()
        if hum then
            pcall(function() hum.PlatformStand = false end)
        end
        notify("Fly", "Disabled", 3)
    end

    local function startFly()
        if S.flyActive then return end
        S.flyActive = true
        flyConn = conn(RunService.RenderStepped:Connect(function()
            local ch = LocalPlayer.Character
            local hrp = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
            if not hrp then return end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local move = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                move = move + cam.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                move = move - cam.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                move = move - cam.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                move = move + cam.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                move = move + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                move = move - Vector3.new(0, 1, 0)
            end
            if move.Magnitude > 0 then
                move = move.Unit * S.flySpeed
            else
                move = Vector3.zero
            end
            hrp.Anchored = false
            hrp.AssemblyLinearVelocity = move
        end))
        notify("Fly", "Enabled - WASD + Space/Ctrl (.flyspeed <n> for speed)", 5)
    end

    -- -----------------------------------------------------------------
    -- NOCLIP -- every physics step, all character BaseParts lose
    -- collision. The character still clips through F3X parts because
    -- those are server-side; client + locally created parts noclip fine.
    -- -----------------------------------------------------------------
    local function noclipStep()
        local ch = LocalPlayer.Character
        if not ch then return end
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end

    local function startNoclip()
        if S.noclipActive then return end
        S.noclipActive = true
        runLoop("extras_noclip", 0, noclipStep, false)
        notify("Noclip", "Enabled", 3)
    end

    local function stopNoclip()
        S.noclipActive = false
        stopLoop("extras_noclip")
        notify("Noclip", "Disabled", 3)
    end

    -- -----------------------------------------------------------------
    -- INFINITE JUMP -- one JumpRequest listener wired at load, gated on
    -- the flag, so toggling never leaks connections.
    -- -----------------------------------------------------------------
    conn(UserInputService.JumpRequest:Connect(function()
        if not S.infJumpActive then return end
        local hum = getHumanoid()
        if hum and hum.Health > 0 then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
        end
    end))

    local function startInfJump()
        S.infJumpActive = true
        notify("Infinite Jump", "Enabled", 3)
    end

    local function stopInfJump()
        S.infJumpActive = false
        notify("Infinite Jump", "Disabled", 3)
    end

    -- -----------------------------------------------------------------
    -- ESP -- Highlight per player, team-colored, refreshed by a 1s loop
    -- that also catches respawns, joins and team changes. Stopping
    -- destroys every highlight we own (name-tagged KAHX_ESP).
    -- -----------------------------------------------------------------
    local function espColor(pl)
        if pl and pl.Team then
            return pl.Team.TeamColor.Color
        end
        return Color3.fromRGB(255, 85, 127)
    end

    local function makeHighlight(pl)
        local ch = pl.Character
        if not ch or not ch.Parent then return end
        local old = S.espObjects[pl]
        if old and old.Parent then old:Destroy() end
        local col = espColor(pl)
        local hl = Instance.new("Highlight")
        hl.Name = "KAHX_ESP"
        hl.FillTransparency = 0.75
        hl.FillColor = col
        hl.OutlineColor = col
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = ch
        hl.Parent = ch
        S.espObjects[pl] = hl
    end

    local function clearESP()
        for pl, hl in pairs(S.espObjects) do
            pcall(function()
                if hl and hl.Parent then hl:Destroy() end
            end)
            S.espObjects[pl] = nil
        end
    end

    runLoop("extras_esp", 1, function()
        if not S.espActive then return end
        for _, pl in ipairs(Players:GetPlayers()) do
            local ch = pl.Character
            if ch and ch.Parent then
                local hl = S.espObjects[pl]
                if not hl or not hl.Parent or hl.Adornee ~= ch then
                    makeHighlight(pl)
                elseif pl.Team then
                    pcall(function()
                        local col = espColor(pl)
                        hl.FillColor = col
                        hl.OutlineColor = col
                    end)
                end
            end
        end
    end, false)

    local function startESP()
        S.espActive = true
        notify("ESP", "Enabled (team colored)", 3)
    end

    local function stopESP()
        S.espActive = false
        clearESP()
        notify("ESP", "Disabled", 3)
    end

    -- -----------------------------------------------------------------
    -- CLICK TP (ctp) -- left click while active teleports you to the
    -- mouse hit position (+3 studs up so you do not spawn inside the
    -- floor). Listener wired once, gated on the flag. Guarded against
    -- clicking on the UI (UserInputServiceGameProcessed).
    -- -----------------------------------------------------------------
    conn(UserInputService.InputBegan:Connect(function(input, typing)
        if not S.ctpActive or typing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local mouse = LocalPlayer:GetMouse()
        local hrp = getHRP()
        if not mouse or not mouse.Hit or not hrp then return end
        hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
    end))

    local function startCTP()
        S.ctpActive = true
        notify("Click TP", "Enabled - left click to teleport", 3)
    end

    local function stopCTP()
        S.ctpActive = false
        notify("Click TP", "Disabled", 3)
    end

    -- -----------------------------------------------------------------
    -- CHAT SPY -- hooks Player.Chatted for every player (including
    -- future joins) and mirrors it into the console buffer with names,
    -- so team-only and legacy chat shows up in the Code tab console and
    -- the developer console. Listeners are wired once and gated.
    -- -----------------------------------------------------------------
    local function hookSpy(pl)
        if S.spyHooked[pl] then return end
        S.spyHooked[pl] = true
        conn(pl.Chatted:Connect(function(msg)
            if not S.spyActive then return end
            logToConsole("[SPY] " .. pl.Name .. ": " .. msg)
        end))
    end

    conn(Players.PlayerAdded:Connect(hookSpy))
    for _, pl in ipairs(Players:GetPlayers()) do hookSpy(pl) end

    local function startSpy()
        S.spyActive = true
        notify("Chat Spy", "Enabled - all chat goes to the console", 3)
    end

    local function stopSpy()
        S.spyActive = false
        notify("Chat Spy", "Disabled", 3)
    end

    -- -----------------------------------------------------------------
    -- FULLBRIGHT + NOFOG -- one shared lighting snapshot, taken the
    -- first time either is enabled. Stopping either re-syncs: if the
    -- other is still active its props are re-applied, otherwise the
    -- snapshot is fully restored. No more "turn one off, lose both".
    -- -----------------------------------------------------------------
    local function backupLighting()
        if S.lightingBackup then return end
        S.lightingBackup = {
            Brightness     = Lighting.Brightness,
            Ambient        = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            ClockTime      = Lighting.ClockTime,
            GlobalShadows  = Lighting.GlobalShadows,
            FogColor       = Lighting.FogColor,
            FogStart       = Lighting.FogStart,
            FogEnd         = Lighting.FogEnd,
        }
    end

    local function applyFullbrightProps()
        pcall(function()
            Lighting.Brightness = 2
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.ClockTime = 14
            Lighting.GlobalShadows = false
        end)
    end

    local function applyNoFogProps()
        pcall(function()
            Lighting.FogStart = 0
            Lighting.FogEnd = 100000
        end)
    end

    local function restoreLighting()
        local b = S.lightingBackup
        if not b then return end
        pcall(function()
            Lighting.Brightness = b.Brightness
            Lighting.Ambient = b.Ambient
            Lighting.OutdoorAmbient = b.OutdoorAmbient
            Lighting.ClockTime = b.ClockTime
            Lighting.GlobalShadows = b.GlobalShadows
            Lighting.FogColor = b.FogColor
            Lighting.FogStart = b.FogStart
            Lighting.FogEnd = b.FogEnd
        end)
        S.lightingBackup = nil
    end

    local function syncLighting()
        if not S.fullbrightActive and not S.noFogActive then
            restoreLighting()
            return
        end
        if S.fullbrightActive then applyFullbrightProps() end
        if S.noFogActive then applyNoFogProps() end
    end

    local function startFullbright()
        if S.fullbrightActive then return end
        backupLighting()
        S.fullbrightActive = true
        applyFullbrightProps()
        notify("Fullbright", "Enabled", 3)
    end

    local function stopFullbright()
        if not S.fullbrightActive then return end
        S.fullbrightActive = false
        syncLighting()
        notify("Fullbright", "Disabled", 3)
    end

    local function startNoFog()
        if S.noFogActive then return end
        backupLighting()
        S.noFogActive = true
        applyNoFogProps()
        notify("No Fog", "Enabled", 3)
    end

    local function stopNoFog()
        if not S.noFogActive then return end
        S.noFogActive = false
        syncLighting()
        notify("No Fog", "Disabled", 3)
    end

    -- -----------------------------------------------------------------
    -- SPEED / JPOWER -- set now AND re-applied on every respawn, so you
    -- do not lose them after .re. Defaults 16 / 50 restore stock values
    -- and stop the respawn re-apply.
    -- -----------------------------------------------------------------
    conn(LocalPlayer.CharacterAdded:Connect(function(ch)
        task.spawn(function()
            local hum = ch:WaitForChild("Humanoid", 5)
            if not hum then return end
            if S.walkSpeed ~= 16 then
                pcall(function() hum.WalkSpeed = S.walkSpeed end)
            end
            if S.jumpPower ~= 50 then
                pcall(function()
                    hum.UseJumpPower = true
                    hum.JumpPower = S.jumpPower
                end)
            end
        end)
    end))

    -- -----------------------------------------------------------------
    -- Expose start/stop for the UI toggles on the Main tab.
    -- -----------------------------------------------------------------
    Extras.startFly = startFly
    Extras.stopFly = stopFly
    Extras.startNoclip = startNoclip
    Extras.stopNoclip = stopNoclip
    Extras.startInfJump = startInfJump
    Extras.stopInfJump = stopInfJump
    Extras.startESP = startESP
    Extras.stopESP = stopESP
    Extras.startCTP = startCTP
    Extras.stopCTP = stopCTP
    Extras.startSpy = startSpy
    Extras.stopSpy = stopSpy
    Extras.startFullbright = startFullbright
    Extras.stopFullbright = stopFullbright
    Extras.startNoFog = startNoFog
    Extras.stopNoFog = stopNoFog

    -- -----------------------------------------------------------------
    -- Commands -- every feature gets one, so everything is bindable.
    -- -----------------------------------------------------------------
    Handler:AddCommand("fly", {Args = {}, Aliases = {}, Description = "Toggles fly (WASD + Space/Ctrl, speed with .flyspeed)"}, function(A, F)
        if S.flyActive then stopFly() else startFly() end
    end)

    Handler:AddCommand("flyspeed", {Args = {"*Number*"}, Aliases = {}, Description = "Sets fly speed (studs/sec)"}, function(A, F)
        local n = tonumber(A[1])
        if not n or n < 1 or n > 1000 then
            notify("Fly", "Speed must be a number between 1 and 1000", 3)
            return
        end
        S.flySpeed = n
        notify("Fly", "Speed set to " .. n, 3)
    end)

    Handler:AddCommand("noclip", {Args = {}, Aliases = {}, Description = "Toggles noclip (walk through parts)"}, function(A, F)
        if S.noclipActive then stopNoclip() else startNoclip() end
    end)

    Handler:AddCommand("infjump", {Args = {}, Aliases = {"infinitejump"}, Description = "Toggles infinite jump"}, function(A, F)
        if S.infJumpActive then stopInfJump() else startInfJump() end
    end)

    Handler:AddCommand("esp", {Args = {}, Aliases = {}, Description = "Toggles player ESP (team-colored highlights)"}, function(A, F)
        if S.espActive then stopESP() else startESP() end
    end)

    Handler:AddCommand("ctp", {Args = {}, Aliases = {"clicktp"}, Description = "Toggles click-to-teleport (left click)"}, function(A, F)
        if S.ctpActive then stopCTP() else startCTP() end
    end)

    Handler:AddCommand("spy", {Args = {}, Aliases = {"chatspy"}, Description = "Toggles chat spy (all chat -> console)"}, function(A, F)
        if S.spyActive then stopSpy() else startSpy() end
    end)

    Handler:AddCommand("fullbright", {Args = {}, Aliases = {}, Description = "Toggles fullbright lighting"}, function(A, F)
        if S.fullbrightActive then stopFullbright() else startFullbright() end
    end)

    Handler:AddCommand("nofog", {Args = {}, Aliases = {}, Description = "Toggles fog removal"}, function(A, F)
        if S.noFogActive then stopNoFog() else startNoFog() end
    end)

    Handler:AddCommand("speed", {Args = {"*Number*"}, Aliases = {"walkspeed"}, Description = "Sets WalkSpeed (16 = default, persists on respawn)"}, function(A, F)
        local n = tonumber(A[1])
        if not n or n < 1 or n > 500 then
            notify("Speed", "Speed must be a number between 1 and 500", 3)
            return
        end
        S.walkSpeed = n
        local hum = getHumanoid()
        if hum then
            pcall(function() hum.WalkSpeed = n end)
        end
        notify("Speed", "WalkSpeed set to " .. n, 3)
    end)

    Handler:AddCommand("jpower", {Args = {"*Number*"}, Aliases = {"jumppower"}, Description = "Sets JumpPower (50 = default, persists on respawn)"}, function(A, F)
        local n = tonumber(A[1])
        if not n or n < 1 or n > 1000 then
            notify("Jump", "Power must be a number between 1 and 1000", 3)
            return
        end
        S.jumpPower = n
        local hum = getHumanoid()
        if hum then
            pcall(function()
                hum.UseJumpPower = true
                hum.JumpPower = n
            end)
        end
        notify("Jump", "JumpPower set to " .. n, 3)
    end)

    Handler:AddCommand("rejoin", {Args = {}, Aliases = {}, Description = "Rejoins this place instantly"}, function(A, F)
        notify("Rejoin", "Rejoining...", 3)
        task.delay(0.5, function()
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
        end)
    end)

    -- -----------------------------------------------------------------
    -- SERVERHOP (v3.3.8, user request): queries the PUBLIC server list
    -- for this place, drops the server you are already in + full ones,
    -- and teleports to a RANDOM pick from what is left. Uses whichever
    -- http function the executor exposes (http_request / request /
    -- syn.request / http.request) and pages up to 3 times (300 servers)
    -- before giving up. Every network + teleport call is pcall'd so a
    -- missing http API reports a clean message instead of erroring.
    -- -----------------------------------------------------------------
    local function httpGetJson(url)
        -- resolve the executor's request function once per call
        local fn = http_request or request or (syn and syn.request)
            or (http and http.request)
        if type(fn) ~= "function" then return nil, "this executor has no http function" end
        local ok, res = pcall(function()
            return fn({Url = url, Method = "GET"})
        end)
        if not ok then return nil, tostring(res) end
        -- response shapes differ: table with .Body, or the raw string
        local body = (type(res) == "table") and (res.Body or res.body) or res
        if type(body) ~= "string" then return nil, "empty response body" end
        local okd, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(body)
        end)
        if not okd then return nil, "response was not valid json" end
        return data
    end

    Handler:AddCommand("serverhop", {Args = {}, Aliases = {"hop"}, Description = "Hops to another random public server of this game"}, function(A, F)
        notify("ServerHop", "Searching for another server...", 3)
        task.spawn(function()
            -- public-servers endpoint (classic games.roblox.com API)
            local base = "https://games.roblox.com/v1/games/"
                .. tostring(game.PlaceId) .. "/servers/Public?limit=100&excludeFullGames=true"
            local cursor = ""
            local candidates = {}
            for _page = 1, 3 do
                -- cursor appended only after page 1 (empty cursor = first page)
                local url = base
                if cursor ~= "" then url = base .. "&cursor=" .. cursor end
                local data, err = httpGetJson(url)
                if not data then
                    notify("ServerHop", "Http request failed: " .. tostring(err), 4)
                    print("[KAHX ServerHop] http error: " .. tostring(err))
                    return
                end
                -- collect every joinable server that is NOT this one
                local list = (type(data) == "table") and data.data or nil
                if type(list) == "table" then
                    for _, srv in ipairs(list) do
                        if type(srv) == "table" and srv.id and srv.id ~= game.JobId
                            and (tonumber(srv.playing) or 0) < (tonumber(srv.maxPlayers) or 1) then
                            table.insert(candidates, srv.id)
                        end
                    end
                end
                cursor = tostring((type(data) == "table") and (data.nextPageCursor or "") or "")
                if #candidates > 0 or cursor == "" or cursor == "nil" then break end
            end
            if #candidates == 0 then
                notify("ServerHop", "No other joinable servers found -- try again later.", 4)
                return
            end
            -- random pick keeps the hop fair across candidates
            local target = candidates[math.random(1, #candidates)]
            notify("ServerHop", "Teleporting to server " .. target .. " (" .. #candidates .. " candidates)", 4)
            print("[KAHX ServerHop] picked " .. target .. " out of " .. #candidates .. " servers")
            local ok, e = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, target, LocalPlayer)
            end)
            if not ok then
                notify("ServerHop", "Teleport failed: " .. tostring(e), 4)
                print("[KAHX ServerHop] teleport error: " .. tostring(e))
            end
        end)
    end)
end

