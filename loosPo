            if s then
                local e = s:FindFirstChild("ServerEndpoint")
                if e then cachedEndpoint = e return e end
            end
        end
    end
    local ch = LocalPlayer.Character
    if ch then
        local t = ch:FindFirstChild("Building Tools")
        if t then
            local s = t:FindFirstChild("SyncAPI")
            if s then
                local e = s:FindFirstChild("ServerEndpoint")
                if e then cachedEndpoint = e return e end
            end
        end
    end
    return nil
end

local function f3x(args)
    local e = getSyncAPI()
    if not e then
        ensureF3X()
        local w = 0
        while not e and w < 3 do
            task.wait(0.1)
            w = w + 0.1
            e = getSyncAPI()
        end
    end
    if not e then return nil end
    local s, r = pcall(function() return e:InvokeServer(table.unpack(args)) end)
    if not s then cachedEndpoint = nil end
    return s and r or nil
end

local function deleteInstances(ins)
    if type(ins) ~= "table" then ins = {ins} end
    if #ins == 0 then return 0 end
    local e = getSyncAPI()
    if not e then ensureF3X() local w = 0 while not e and w < 3 do task.wait(0.1) w = w + 0.1 e = getSyncAPI() end end
    if not e then return 0 end
    local v = {}
    for _, i in ipairs(ins) do if i and i:IsA("Instance") then table.insert(v, i) end end
    if #v == 0 then return 0 end
    local t = 0
    for i = 1, #v, 5000 do
        local b = {}
        for j = i, math.min(i + 4999, #v) do table.insert(b, v[j]) end
        if pcall(function() e:InvokeServer("Remove", b) end) then t = t + #b end
        task.wait(0.01)
    end
    return t
end

