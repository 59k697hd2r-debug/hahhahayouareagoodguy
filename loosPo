local function runLoop(key, interval, body, respectPause)
    if loopThreads[key] then return end
    loopThreads[key] = task.spawn(function()
        while S.monitorLoopActive do
            -- v3.3.5: a loop is skipped while (a) the user's pauseLoops is
            -- set (kick/crash operations) or (b) a skick panic is being
            -- handled and this loop is not on the keep-list. The loop
            -- THREAD stays alive -- the panic watchdog lifts (b) when the
            -- handling window ends, so paused features RESUME on their own.
            local skip = (respectPause and S.pauseLoops)
                or (S.panicPause and not S.panicKeep[key] and key ~= "panic_watch")
            if not skip then
                pcall(body)
            end
            task.wait(interval)
        end
        loopThreads[key] = nil
    end)
end

local function stopLoop(key)
    local t = loopThreads[key]
    if t then
        pcall(function() task.cancel(t) end)
        loopThreads[key] = nil
    end
end

local function stopAllLoops()
    -- v3.3.4: "invalid key to 'next'" hardening -- loopThreads is mutated
    -- from many threads (runLoop inserts while stop* cancels); iterating
    -- a live table across threads can corrupt the traversal state. Take
    -- a snapshot of the keys first, then cancel outside the traversal.
    local keys = {}
    pcall(function()
        for k in pairs(loopThreads) do table.insert(keys, k) end
    end)
    for _, k in ipairs(keys) do
        local t = loopThreads[k]
        if t then
            pcall(function() task.cancel(t) end)
            loopThreads[k] = nil
        end
    end
end

-- v3.3.3: skick panic support -- cancel every loop thread EXCEPT the
-- keep-list (auto admin + anti punish + the anti-kick poll itself).
-- v3.3.5 NOTE: kept for emergencies, but the panic path below no longer
-- USES it -- the user asked for loops to stop only TEMPORARILY while a
-- kick attempt is being handled, then come back on their own.
local function stopAllLoopsExcept(keep)
    local keepMap = {}
    for _, k in ipairs(keep) do keepMap[k] = true end
    local keys = {}
    pcall(function()
        for k in pairs(loopThreads) do table.insert(keys, k) end
    end)
    for _, k in ipairs(keys) do
        if not keepMap[k] then
            local t = loopThreads[k]
            if t then
                pcall(function() task.cancel(t) end)
                loopThreads[k] = nil
            end
        end
    end
end

-- v3.3.5 (user request: "make anti skick stop the loops temporarily and
-- for the duration of handling the attempt"): instead of killing the
-- loop threads, FREEZE them. Every runLoop whose key is not in "keep"
-- skips its body while the panic is active; the panic_watch watchdog
-- below resumes everything once no new platform has been seen for the
-- window. Calling this again refreshes/extends the window.
local function panicPauseLoops(keep, seconds)
    local km = {}
    for _, k in ipairs(keep) do km[k] = true end
    S.panicKeep = km
    S.panicUntil = os.clock() + (seconds or 12)
    if not S.panicPause then
        S.panicPause = true
        print("[KAHX Anti-Skick] loops PAUSED while handling the kick attempt ("
            .. tostring(seconds or 12) .. "s window, still running: "
            .. table.concat(keep, ", ") .. ")")
    end
end

-- panic watchdog: lifts the temporary pause when the handling window
-- expires. It is exempt from the pause itself (see runLoop above) and
-- costs nothing while idle.
runLoop("panic_watch", 0.25, function()
    if S.panicPause and os.clock() >= S.panicUntil then
        S.panicPause = false
        S.panicKeep = {}
        notify("Anti-Skick", "Kick attempt handled - loops resumed", 4)
        print("[KAHX Anti-Skick] panic pause lifted - all loops RESUMED")
    end
end, false)

