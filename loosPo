local function crashPlayer(pl)
    if not pl then return end
    local u = pl.UserId
    local n = tick()
    if lastCrashTime[u] and (n - lastCrashTime[u]) < 0.05 then return end
    lastCrashTime[u] = n
    pauseLoops = true
    local vn = pl.Name
    chatSystem("gear me,me,me potato")
    task.wait(1.5)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local ch = LocalPlayer.Character
    if not ch then pauseLoops = false return end
    local function fp(c)
        local ps = {}
        if not c then return ps end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and (string.find(t.Name, "Potato") or t.Name == "HotPotato") then table.insert(ps, t) end
        end
        return ps
    end
    local ps = {}
    local w = 0
    while #ps == 0 and w < 5 do
        ps = fp(bp)
        for _, p in ipairs(fp(ch)) do table.insert(ps, p) end
        if #ps == 0 then task.wait(0.1) w = w + 0.1 end
    end
    if #ps == 0 then pauseLoops = false notify("Crash", "Failed to get Hot Potato", 3) return end
    chatSystem("freeze " .. vn)
    chatSystem("size " .. vn .. " nan")
    task.wait(0.3)
    chatSystem("to " .. vn)
    task.wait(0.3)
    local vC = pl.Character
    local mH = ch:FindFirstChild("HumanoidRootPart")
    if not vC or not mH then pauseLoops = false return end
    local vH = vC:FindFirstChild("HumanoidRootPart")
    if not vH then pauseLoops = false return end
    local to = os.clock() + 15
    while os.clock() < to do
        local pc = 0
        for _, t in ipairs(vC:GetChildren()) do
            if t:IsA("Tool") and (string.find(t.Name, "Potato") or t.Name == "HotPotato") then pc = pc + 1 end
        end
        if pc >= 3 then
            chatSystem("thaw " .. vn)
            stats.playersKicked = stats.playersKicked + 1
            chatSystem("name " .. vn .. " [CRASHED]")
            notify("Crash", "Crashed " .. vn .. " with Hot Potato!", 4)
            pauseLoops = false
            return
        end
        for _, p in ipairs(ps) do
            if p.Parent == bp then p.Parent = ch end
            local h = p:FindFirstChild("Handle") or p:FindFirstChildWhichIsA("BasePart")
            if h then
                pcall(function() firetouchinterest(h, vH, 0) firetouchinterest(h, vH, 1) end)
            end
        end
        pcall(function() firetouchinterest(mH, vH, 0) firetouchinterest(mH, vH, 1) end)
        task.wait(0.5)
    end
    chatSystem("thaw " .. vn)
    pauseLoops = false
    notify("Crash", "Timed out for " .. vn, 3)
end

