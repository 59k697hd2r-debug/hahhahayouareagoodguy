local function startLoopKill(input)
    if not input or input == "" then return end
    local li = string.lower(input)
    if li == "all" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then startLKForPlayer(p) end
        end
        notify("LoopKill", "Started on all current", 3)
        return
    elseif li == "allfuture" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then startLKForPlayer(p) end
        end
        loopkillFuture = true
        if loopkillFutureConn then loopkillFutureConn:Disconnect() end
        loopkillFutureConn = Players.PlayerAdded:Connect(function(p)
            if loopkillFuture then
                task.wait(1)
                startLKForPlayer(p)
            end
        end)
        notify("LoopKill", "Started on all + future", 3)
        return
