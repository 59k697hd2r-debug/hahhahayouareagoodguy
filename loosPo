    local function refreshFriends()
        fetchSeq = fetchSeq + 1
        local mySeq = fetchSeq
        countLbl.Text = "loading friends..."
        task.spawn(function()
            local full = {}
            local listErr = nil
            local okP, pages = pcall(function()
                return Players:GetFriendsAsync(LocalPlayer.UserId)
            end)
            if okP and pages then
                pcall(function()
                    for _ = 1, 20 do
                        local page = pages:GetCurrentPage()
                        for _, fr in ipairs(page) do table.insert(full, fr) end
                        if pages.IsFinished then break end
                        pages:AdvanceToNextPageAsync()
                        task.wait(0.05)
                    end
                end)
            else
                listErr = "GetFriendsAsync failed"
            end
            if mySeq ~= fetchSeq or not gui.Parent then return end
            local online = {}
            local okO, odata = pcall(function() return LocalPlayer:GetFriendsOnline() end)
            if okO and type(odata) == "table" then
                for _, o in ipairs(odata) do
                    local ou = o.User or {}
                    local oid = tonumber(ou.Id) or tonumber(o.Id)
                    if oid then online[oid] = o end
                end
            end
            local merged, seen = {}, {}
            for _, fr in ipairs(full) do
                local uid = tonumber(fr.Id)
                if uid and not seen[uid] then
                    seen[uid] = true
                    local o = online[uid]
                    table.insert(merged, {
                        Id = uid,
                        UserName = fr.Username or fr.UserName or fr.Name or "?",
                        DisplayName = fr.DisplayName or fr.Username or "?",
                        IsBanned = fr.IsBanned or nil,
                        PlaceId = o and o.PlaceId or nil,
                        GameId = o and o.GameId or nil,
                        LocationType = o and o.LocationType or nil,
                        LastOnline = o and o.LastOnline or nil,
                        IsOnline = o and o.IsOnline or nil,
                        Location = o and o.Location or nil,
                    })
                end
            end
            for uid, o in pairs(online) do
                if not seen[uid] then
                    seen[uid] = true
                    local ou = o.User or {}
                    table.insert(merged, {
                        Id = uid,
                        UserName = ou.Name or o.UserName or o.Username or o.Name or "?",
                        DisplayName = ou.DisplayName or o.DisplayName or ou.Name or "?",
                        IsBanned = o.IsBanned or nil,
                        PlaceId = o.PlaceId, GameId = o.GameId,
                        LocationType = o.LocationType, LastOnline = o.LastOnline,
                        IsOnline = o.IsOnline, Location = o.Location,
                    })
                end
            end
            if #merged == 0 and listErr then
                countLbl.Text = listErr
                return
            end
            friendData = merged
            table.sort(friendData, function(a, b)
                local ag = a.PlaceId and 1 or 0
                local bg = b.PlaceId and 1 or 0
                if ag ~= bg then return ag > bg end
                return tostring(a.DisplayName or a.UserName or "")
                    < tostring(b.DisplayName or b.UserName or "")
            end)
            buildRows()
        end)
    end
