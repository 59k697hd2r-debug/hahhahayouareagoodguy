local function clearByFilter(filterFunc, exc, ext, etb, ekf)
    local endpoint = getSyncAPI()
    if not endpoint then
        ensureF3X()
        local waited = 0
        while not endpoint and waited < 3 do
            task.wait(0.1)
            waited = waited + 0.1
            endpoint = getSyncAPI()
        end
    end
    if not endpoint then return 0 end
    local terrain = Workspace:FindFirstChild("Terrain")
    local tabby = Workspace:FindFirstChild("Tabby")
    local instances = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if filterFunc(v) then
            local skip = false
            if exc then
                local model = v:FindFirstAncestorOfClass("Model")
                if model and Players:GetPlayerFromCharacter(model) then skip = true end
            end
            if not skip and ext and terrain and v:IsDescendantOf(terrain) then skip = true end
            if not skip and etb and tabby and v:IsDescendantOf(tabby) then skip = true end
            if not skip and ekf and Variables.SKickFolder and v:IsDescendantOf(Variables.SKickFolder) then skip = true end
            if not skip and Variables.PKS and v == Variables.PKS then skip = true end
            if not skip then table.insert(instances, v) end
        end
    end
    if #instances == 0 then return 0 end
    for i = 1, #instances, 5000 do
        local batch = {}
        for j = i, math.min(i + 4999, #instances) do table.insert(batch, instances[j]) end
        pcall(function() endpoint:InvokeServer("Remove", batch) end)
        task.wait(0.01)
    end
    return #instances
end

