-- === PAD CLAIMER ===
local trackedPad = nil
local padChildren = nil
local clickDetector = nil

local function initPadClaimer()
    local terrain = Workspace:FindFirstChild("Terrain")
    if not terrain then return false end
    local gameFolder = terrain:FindFirstChild("_Game")
    if not gameFolder then return false end
    local adminFolder = gameFolder:FindFirstChild("Admin")
    if not adminFolder then return false end
    local pads = adminFolder:FindFirstChild("Pads")
    if not pads then return false end
    padChildren = pads:GetChildren()
    if #padChildren < 9 then return false end
    clickDetector = adminFolder:FindFirstChild("Regen") and adminFolder.Regen:FindFirstChild("ClickDetector")
    return true
end

local function fireRegen()
    if not clickDetector then return false end
    clickDetector.MaxActivationDistance = 99999
    pcall(function()
        fireclickdetector(clickDetector)
    end)
    return true
end

local function getHRP()
    local char = LocalPlayer.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function fireTouch(pad)
    local head = pad:FindFirstChild("Head")
    if not head then return false end
    local hrp = getHRP()
    if not hrp then return false end
    pcall(function()
        firetouchinterest(head, hrp, 0)
        task.wait(0.05)
        firetouchinterest(head, hrp, 1)
    end)
    return true
end

local function isDarkGreen(pad)
    local head = pad:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head.BrickColor == BrickColor.new("Dark green")
    end
    return false
end

local function isBrightRed(pad)
    local head = pad:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head.BrickColor == BrickColor.new("Bright red")
    end
    return false
end

local function findDarkGreen()
    if not padChildren then return nil end
    for _, pad in ipairs(padChildren) do
        if isDarkGreen(pad) then return pad end
    end
    return nil
end

local function touchAndTrack()
    local dark = findDarkGreen()
    if dark then
        fireTouch(dark)
        task.wait(0.05)
        if isBrightRed(dark) then
            trackedPad = dark
            return true
        end
    else
        fireRegen()
        task.wait(0.05)
    end
    return false
end

local function monitorTracked()
    if not trackedPad or not trackedPad.Parent then
        trackedPad = nil
        return false
    end
    if isDarkGreen(trackedPad) then
        fireTouch(trackedPad)
        task.wait(0.05)
        if isBrightRed(trackedPad) then
            return true
        else
            trackedPad = nil
            return false
        end
    elseif isBrightRed(trackedPad) then
        return true
    else
        trackedPad = nil
        return false
    end
end

local function claimAllPadsFast()
    if not padChildren then initPadClaimer() end
    if not padChildren then
        notifyError("Pads not available.")
        return
    end
    fireRegen()
    task.wait(0.3)
    local claimed = 0
    for _, pad in ipairs(padChildren) do
        if isDarkGreen(pad) then
            if fireTouch(pad) then
                claimed = claimed + 1
                task.wait(0.05)
            end
        end
    end
    notify("Claim All", "Claimed " .. claimed .. " pads.", 3)
end

local function stopPadClaimer()
    autoClaimEnabled = false
    if padClaimerThread then
        padClaimerThread = nil
    end
end

local function startPadClaimer()
    if not initPadClaimer() then
        notifyError("Pad claimer not available.")
        return
    end
    autoClaimEnabled = true
    if padClaimerThread then
        return
    end
    padClaimerThread = task.spawn(function()
        while autoClaimEnabled and monitorLoopActive do
            if trackedPad then
                if not monitorTracked() then
                    touchAndTrack()
                end
            else
                touchAndTrack()
            end
            task.wait(0.01)
        end
        padClaimerThread = nil
    end)
end

