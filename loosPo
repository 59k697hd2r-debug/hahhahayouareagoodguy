local function getEndpoint()
    local e = getSyncAPI()
    if not e then
        ensureF3X()
        local w = 0
        while not e and w < 3 do
            task.wait(0.1)
            w = w + 0.1
            e = getSyncAPI()
        end
    end
    return e
end
