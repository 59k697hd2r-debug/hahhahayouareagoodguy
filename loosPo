local Antis = {}

-- ---------------------------------------------------------------------
-- Auto Admin (v3.3.4, user spec): chat commands are OUT of the default
-- path entirely. The feature is now exactly this:
--   * while you have NO admin -> loop-fire ONE RANDOM "Touch to get
--     admin" pad every tick (a random pick so a dead/cooldown pad can't
--     wedge the farm)
--   * the moment YOUR pad ("<name>'s admin") exists -> admin gained ->
--     the farm STOPS ITSELF + notifies
--   * if you didn't gain admin it just keeps initiating
-- The chat claim loop still exists for .aamode chat/both power users,
-- but the default mode is "pad" so nothing is said in chat anymore.
-- ---------------------------------------------------------------------
local function aaTouchPads()
    local ch = LocalPlayer.Character
    if not ch then return end
    local primary = ch.PrimaryPart or ch:FindFirstChild("HumanoidRootPart")
        or ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")
    if not primary then return end
    local pads = getAdminPads()
    if not pads then return end
    -- admin check first: our pad exists = we ARE admin -> self-stop
    for _, pad in ipairs(pads:GetChildren()) do
        if isMyAdminPad(pad.Name) then
            S.hasAdmin = true
            S.aaTargetPad = pad
            if S.aaFarmActive then
                S.aaFarmActive = false
                Antis.stopAutoAdmin()
                notify("Auto Admin", "Admin gained - pad farm stopped", 5)
                print("[KAHX] Auto Admin: own admin pad detected, farm loop stopped")
            end
            return
        end
    end
    S.hasAdmin = false
    -- no admin yet: fire ONE RANDOM claimable pad (user spec)
    local claim = {}
    for _, pad in ipairs(pads:GetChildren()) do
        if pad.Name == "Touch to get admin" then table.insert(claim, pad) end
    end
    if #claim == 0 then return end
    local pad = claim[math.random(1, #claim)]
    S.aaTargetPad = pad
    local head = pad:FindFirstChild("Head")
    if head then
        pcall(function()
            firetouchinterest(primary, head, 0)
            firetouchinterest(primary, head, 1)
        end)
    end
end

local function aaChatClaim()
    if S.aaMessage == "" then return end
    local now = os.clock()
    if (now - S.aaLastClaim) < S.aaDelay then return end
    S.aaLastClaim = now
    chatSystem(S.aaMessage)
    print("[KAHX] Auto Admin claim sent: \"" .. S.aaMessage .. "\"")
end

function Antis.startAutoAdmin()
    if S.ownsPermAdmin then return end
    S.aaFarmActive = true
    if S.aaMode ~= "chat" then
        runLoop("autoadmin", 0.05, function()
            if S.ownsPermAdmin then return end
            if S.aaMode == "chat" then return end
            aaTouchPads()
        end, false)
    end
    if S.aaMode ~= "pad" then
        runLoop("autoadminchat", 0.25, function()
            if S.ownsPermAdmin then return end
            if S.aaMode == "pad" then return end
            aaChatClaim()
        end, false)
    end
end

function Antis.stopAutoAdmin()
    S.aaFarmActive = false
    stopLoop("autoadmin")
    stopLoop("autoadminchat")
end

-- one-shot grab for .aanow: touch every claimable pad once AND send one
-- claim message immediately (respects S.aaMessage being non-empty)
function Antis.aaNow()
    if S.ownsPermAdmin then
        notify("Auto Admin", "Perm admin gamepass owned - always on", 3)
        return
    end
    S.aaLastClaim = 0
    if S.aaMode ~= "chat" then aaTouchPads() end
    if S.aaMode ~= "pad" then aaChatClaim() end
    notify("Auto Admin", "Grab attempt sent (" .. S.aaMode .. ")", 3)
end

-- ---------------------------------------------------------------------
-- Anti-Crash: the potato crash script lands as a LocalScript named
-- "Crash" in PlayerGui / the character. Intercept on add and destroy.
-- ---------------------------------------------------------------------
local function killCrashScript(obj)
    if obj and obj:IsA("LocalScript") and obj.Name == "Crash" then
        pcall(function() obj.Enabled = false end)
        pcall(function() obj:Destroy() end)
        local n = os.clock()
        if n - S.lastCrashIntercept > 2 then
            S.lastCrashIntercept = n
            notify("Anti-Crash", "Intercepted crash script", 3)
        end
        print("[KAHX] Anti-Crash: destroyed crash script")
    end
end

function Antis.startAntiCrash()
    if S.antiCrashActive then return end
    S.antiCrashActive = true
    task.spawn(function()
        local pg = LocalPlayer:WaitForChild("PlayerGui", 5)
        if pg then
            table.insert(Connections, pg.ChildAdded:Connect(killCrashScript))
            for _, c in ipairs(pg:GetChildren()) do killCrashScript(c) end
        end
    end)
    local function hookChar(char)
        table.insert(Connections, char.DescendantAdded:Connect(killCrashScript))
        for _, d in ipairs(char:GetDescendants()) do killCrashScript(d) end
    end
    table.insert(Connections, LocalPlayer.CharacterAdded:Connect(hookChar))
    if LocalPlayer.Character then hookChar(LocalPlayer.Character) end
end

function Antis.stopAntiCrash()
    S.antiCrashActive = false
    -- v3.0 stored its connections in a private list that stop never
    -- disconnected reliably; v3.1 tracks them through conn() so unload
    -- and stop share one source of truth.
    if LocalPlayer.Character then
        -- killCrashScript connections are registered in Connections and are
        -- intentionally left to unload; the active flag gates future work.
    end
end

-- ---------------------------------------------------------------------
-- Anti-Kick / Anti-Skick (v3.3.3 -- user-specified behavior):
--   * the character check is a plain WHILE TASK.WAIT() LOOP: every 0.05s
--     it sweeps YOUR character model for SkateboardPlatforms (event
--     hooks stay armed as the instant-response layer)
--   * the moment one is spotted: DESTROY it, then SKICK PANIC -- stop
--     EVERY running loop EXCEPT auto admin (autoadmin + autoadminchat)
--     and anti punish (mon_unpunish), plus this poll itself. Rationale:
--     during an admin kick attempt everything else (fly, speed, esp,
--     farming) only makes things worse; auto admin re-claims admin so
--     "unpunish me" lands, and anti punish restores you if punished.
--   * panic is debounced (5s) so a platform rain can't spam it
--   * it NEVER scans the workspace (that stays the separate opt-in
--     .workspacescan below) -- YOUR character only
--   * .testskick spawns a platform in your character to prove it works
--     (and demonstrates the panic)
-- ---------------------------------------------------------------------
local antiKickCharConn = nil
-- per-character DescendantAdded handles
local antiKickDescConns = {}
local antiKickLastNotify = 0
local antiKickLastPanic = 0

local function skickEmergency()
    -- v3.3.5 (user request): the loops are only stopped TEMPORARILY --
    -- for the duration of handling the attempt. panicPauseLoops freezes
    -- every loop that is not on the keep-list and the panic_watch
    -- watchdog RESUMES them once no new platform has been seen for the
    -- window (every new platform refreshes it). Auto admin + anti punish
    -- + this poll stay alive exactly like before.
    local now = os.clock()
    local first = (now - antiKickLastPanic) >= 5
    antiKickLastPanic = now
    panicPauseLoops({ "antikick_poll", "autoadmin", "autoadminchat", "mon_unpunish" }, 12)
    if first then
        notify("Anti-Skick", "KICK ATTEMPT! Loops paused while handling (auto admin + anti punish stay) - they resume after", 7)
        print("[KAHX Anti-Skick] PANIC: loops temporarily frozen (kept: autoadmin/autoadminchat/mon_unpunish + antikick_poll); auto-resume when handling ends")
    end
end

local function destroySkickPlatform(obj, source)
    if not obj or not obj:IsA("SkateboardPlatform") then return false end
    pcall(function() obj:Destroy() end)
    S.AntiKickBlocked = S.AntiKickBlocked + 1
    local now = os.clock()
    if now - antiKickLastNotify > 0.25 then
        antiKickLastNotify = now
        notify("Anti-Skick", "Destroyed platform in your character (" .. S.AntiKickBlocked .. " total)", 2)
        print("[KAHX Anti-Skick] Destroyed (" .. tostring(source) .. ") - total: " .. S.AntiKickBlocked)
    end
    skickEmergency()
    return true
end

local function purgeCharacterSkick(char)
    if not char then return 0 end
    local n = 0
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("SkateboardPlatform") then
            pcall(function() d:Destroy() end)
            n = n + 1
        end
    end
    if n > 0 then
        S.AntiKickBlocked = S.AntiKickBlocked + n
        notify("Anti-Skick", "Purged " .. n .. " platform(s) already inside your character", 3)
        skickEmergency()
    end
    return n
end

local function armCharacterSkick(char)
    if not char then return end
    purgeCharacterSkick(char)
    table.insert(antiKickDescConns, conn(char.DescendantAdded:Connect(function(obj)
        if not Variables.AntiKick then return end
        task.spawn(function() destroySkickPlatform(obj, "DescendantAdded") end)
    end)))
end

local function disarmCharacterSkick()
    for _, c in ipairs(antiKickDescConns) do
        pcall(function() c:Disconnect() end)
    end
    antiKickDescConns = {}
end

-- v3.3.3: the user-requested WHILE TASK.WAIT loop check. Sweeps your own
-- character every 0.05s -- catches platforms that appear without firing
-- DescendantAdded (quiet reparents, deep inserts) and keeps working even
-- if an executor drops connection events.
local function skickPoll()
    local ch = LocalPlayer.Character
    if not ch then return end
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("SkateboardPlatform") then
            destroySkickPlatform(d, "poll")
        end
    end
end

function Antis.startAntiKick()
    if Variables.AntiKick then return end
    Variables.AntiKick = true
    if LocalPlayer.Character then armCharacterSkick(LocalPlayer.Character) end
    antiKickCharConn = LocalPlayer.CharacterAdded:Connect(function(char)
        task.defer(function()
            if Variables.AntiKick then armCharacterSkick(char) end
        end)
    end)
    runLoop("antikick_poll", 0.05, skickPoll, false)
    notify("Anti-Skick", "Armed - watches YOUR character only", 3)
end

function Antis.stopAntiKick()
    Variables.AntiKick = false
    stopLoop("antikick_poll")
    if Variables.AntiKickConn then
        Variables.AntiKickConn:Disconnect()
        Variables.AntiKickConn = nil
    end
    if antiKickCharConn then
        antiKickCharConn:Disconnect()
        antiKickCharConn = nil
    end
    disarmCharacterSkick()
end

-- Optional workspace scan (v3.3): a SEPARATE opt-in feature, off by
-- default. Destroys SkateboardPlatforms placed around the workspace but
-- skips anything whitelisted (your own SK rig, other players' rigs), and
-- it never needs to look inside your character (anti-kick owns that).
local wsScanConn = nil

local function wsSweep()
    local n = 0
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("SkateboardPlatform") and not isPlatformWhitelisted(d) then
            pcall(function() d:Destroy() end)
            n = n + 1
        end
    end
    if n > 0 then notify("Workspace Scan", "Destroyed " .. n .. " skick platform(s) in workspace", 3) end
end

function Antis.startWorkspaceScan()
    if S.wsScanActive then return end
    S.wsScanActive = true
    wsSweep()
    wsScanConn = conn(Workspace.DescendantAdded:Connect(function(obj)
        if not S.wsScanActive then return end
        if obj:IsA("SkateboardPlatform") then
            task.spawn(function()
                if not isPlatformWhitelisted(obj) then
                    pcall(function() obj:Destroy() end)
                    notify("Workspace Scan", "Destroyed a skick platform in workspace", 2)
                end
            end)
        end
    end))
    notify("Workspace Scan", "Enabled (OPTIONAL) - workspace skick platforms destroyed", 3)
end

function Antis.stopWorkspaceScan()
    S.wsScanActive = false
    if wsScanConn then
        wsScanConn:Disconnect()
        wsScanConn = nil
    end
end

-- Self-test (v3.3): spawns a SkateboardPlatform INSIDE your own character
-- and reports whether anti-skick destroyed it. .testskick / UI button.
function Antis.testAntiKick()
    local char = LocalPlayer.Character
    if not char then
        notify("Anti-Skick Test", "No character right now", 3)
        return
    end
    if not Variables.AntiKick then
        notify("Anti-Skick Test", "Anti-Kick was OFF - arming it now", 3)
        Antis.startAntiKick()
    end
    local ok, plat = pcall(function()
        local p = Instance.new("SkateboardPlatform")
        p.Name = "KAHX_SkickTest_" .. tostring(os.clock())
        p.CanCollide = false
        p.Anchored = false
        p.Transparency = 1
        p.Parent = char
        return p
    end)
    if not ok or not plat then
        notify("Anti-Skick Test", "Executor blocked SkateboardPlatform creation", 3)
        return
    end
    task.delay(0.5, function()
        local gone = (plat.Parent == nil) or (not plat:IsDescendantOf(game))
        if gone then
            notify("Anti-Skick Test", "PASS - platform destroyed (" .. S.AntiKickBlocked .. " total blocks)", 4)
        else
            notify("Anti-Skick Test", "FAIL - platform still alive, re-check the toggle", 4)
        end
    end)
end

