local function resolvePlayerInput(input, callback, includeSelf)
    if not input or input == "" then callback({}) return end
    local players = {}
    if input == "random" then
        local l = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if includeSelf or p ~= LocalPlayer then table.insert(l, p) end
        end
        if #l > 0 then table.insert(players, l[math.random(1, #l)]) end
    elseif input == "all" then
        for _, p in ipairs(Players:GetPlayers()) do
            if includeSelf or p ~= LocalPlayer then table.insert(players, p) end
        end
    elseif input == "friends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if s and f then table.insert(players, p) end
            end
        end
    elseif input == "nonfriends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if not (s and f) then table.insert(players, p) end
            end
        end
    else
        local found = getPlayerFromPartial(input)
        if found then table.insert(players, found) end
    end
    if #players == 0 then notify("Player not found", "No player(s) matched", 3) else callback(players) end
end

local function resolveAllWithFriends(input, callback, includeSelf)
    if string.lower(input) ~= "all" then
        resolvePlayerInput(input, callback, includeSelf)
        return
    end
    resolvePlayerInput("all", callback, includeSelf)
end

