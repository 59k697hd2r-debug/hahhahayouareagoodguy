                    {text = "Yes", style = "primary", callback = function() startAll(true) end},
                },
            })
        else
            startAll(targetFutureJoins)
        end
        return
    end
    local player = getPlayerFromPartial(input)
    if player then startLoopKillForPlayer(player) else notifyError("Player not found") end
end

