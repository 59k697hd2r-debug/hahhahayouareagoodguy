-- Fixed Auto Admin: targets ONE pad at a time
local function startAutoAdmin()
    if ownsPermAdmin then
        notify("Auto Admin", "Perm Admin detected, skipping.", 3)
        return
    end
    if autoAdminThread then return end
    
    local targetPad = nil
    
    autoAdminThread = task.spawn(function()
        while monitorLoopActive do
            if not ownsPermAdmin then
                local ch = LocalPlayer.Character
                if ch then
                    local primary = ch.PrimaryPart or ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")
                    if primary then
                        local pads = Workspace:FindFirstChild("Terrain") and Workspace.Terrain:FindFirstChild("_Game") and Workspace.Terrain._Game:FindFirstChild("Admin") and Workspace.Terrain._Game.Admin:FindFirstChild("Pads")
                        if pads then
                            -- If we already have a pad, verify we still own it
                            if targetPad and targetPad.Parent and targetPad.Name == LocalPlayer.Name.."'s admin" then
                                hasAdmin = true
                            else
                                hasAdmin = false
                                targetPad = nil
                                -- Look for an unclaimed pad or our own pad
                                for _, pad in ipairs(pads:GetChildren()) do
                                    if pad.Name == LocalPlayer.Name.."'s admin" then
                                        targetPad = pad
                                        hasAdmin = true
                                        break
                                    elseif pad.Name == "Touch to get admin" then
                                        targetPad = pad
                                        local head = pad:FindFirstChild("Head")
                                        if head then
                                            firetouchinterest(primary, head, 0)
                                            firetouchinterest(primary, head, 1)
                                        end
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.05)
        end
    end)
    notify("Auto Admin", "Started", 3)
end

local function stopAutoAdmin()
    if autoAdminThread then
        task.cancel(autoAdminThread)
        autoAdminThread = nil
    end
    notify("Auto Admin", "Stopped", 3)
end

local function claimAllAdminPads()
    if not initAdminPads() then return end
    local ch = LocalPlayer.Character
    if not ch then return end
    local primary = ch.PrimaryPart or ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")
    if not primary then return end
    local pads = Workspace.Terrain._Game.Admin.Pads:GetChildren()
    local c = 0
    for _, pad in ipairs(pads) do
        if isPadUnclaimed(pad) then
            local head = pad:FindFirstChild("Head")
            if head then
                firetouchinterest(primary, head, 0)
                firetouchinterest(primary, head, 1)
                task.wait(0.1)
                if padIsOurs(pad) then c = c + 1 end
            end
        end
    end
    if c > 0 then hasAdmin = true end
    notify("Claim All", "Claimed " .. c .. " pads")
end

