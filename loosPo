local Handler = {}
Handler.Commands = {}
-- v3.3: canonical registration order (cmdlist + predictor)
Handler.Order = {}

function Handler:AddCommand(n, c, cb)
    self.Commands[string.lower(n)] = {config = c, callback = cb}
    table.insert(self.Order, {name = string.lower(n), config = c})
    if c.Aliases then
        for _, a in ipairs(c.Aliases) do
            self.Commands[string.lower(a)] = {config = c, callback = cb}
        end
    end
end

-- v3.3.7 (user: "make it so when u say cmds it shows cmd and other ways
-- to activate"): every resolved command reports itself + every ALIAS, so
-- the user always learns the alternate forms that also trigger it (chat
-- prefix, silent prefix, bar bare-name). Rate-limited per command name
-- (1.5s) so loopkill-style re-runs never spam the notifier.
local cmdFeedbackAt = {}

local function announceCommand(name, config)
    if not S.cmdFeedback then return end
    local key = string.lower(name or "")
    local now = os.clock()
    if cmdFeedbackAt[key] and (now - cmdFeedbackAt[key]) < 1.5 then return end
    cmdFeedbackAt[key] = now
    local als = config.Aliases or {}
    local alt = ""
    for i, a in ipairs(als) do
        alt = alt .. S.commandPrefix .. tostring(a)
        if i < #als then alt = alt .. ", " end
    end
    if alt == "" then alt = "(none -- only " .. S.commandPrefix .. key .. ")" end
    notify("KAHX", S.commandPrefix .. key .. "  |  also: " .. alt, 2.5)
    print("[KAHX CMD] ran " .. S.commandPrefix .. key
        .. " | other ways to activate: " .. alt
        .. " | bar: type \"" .. key .. "\" (no prefix)"
        .. " | bind it: " .. S.commandPrefix .. "chatbind " .. key .. " <phrase>")
end

function Handler:RunCommand(name, args, full)
    local cmd = self.Commands[string.lower(name or "")]
    if not cmd then
        -- v3.3: did-you-mean hook. The command bar UI sets S.didYouMean;
        -- it fuzzy-matches the typo and pops a small "did you mean 'x'?"
        -- prompt with Run / No buttons. Fallback stays a plain notify.
        if type(S.didYouMean) == "function" then
            S.didYouMean(tostring(name or ""), args or {}, full or "")
        else
            notify("Command Handler", "Invalid command: " .. tostring(name), 3)
        end
        return
    end
    for i, a in ipairs(cmd.config.Args or {}) do
        if string.sub(a, 1, 1) .. string.sub(a, -1) == "**" and (not args[i] or args[i] == "") then
            notify("Argument Handler", "Missing argument #" .. i .. " for " .. tostring(name), 3)
            return
        end
    end
    -- v3.3.7: show the command + its aliases on every execution path
    -- (chat, silent, bar, cmdlist RUN, keybinds, did-you-mean).
    announceCommand(name, cmd.config)
    cmd.callback(args, full or "")
end

