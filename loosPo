local Chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
local function randomString(len)
    local r = ""
    for i = 1, len do
        r = r .. string.sub(Chars, math.random(1, #Chars), math.random(1, #Chars))
    end
    return r
end

local function waitForChildOfClass(parent, cn, to)
    to = to or 5
    for _, c in ipairs(parent:GetChildren()) do
        if c:IsA(cn) then return c end
    end
    local s, f = os.clock(), nil
    local conn = parent.ChildAdded:Connect(function(c) if c:IsA(cn) then f = c end end)
    while not f do
        if (os.clock() - s) >= to then conn:Disconnect() return nil end
        task.wait()
    end
    conn:Disconnect()
    return f
end

local function getPlayerFromPartial(name)
    if not name or name == "" then return nil end
    name = string.lower(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name) == name or string.lower(p.DisplayName) == name then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(p.Name), name) or string.find(string.lower(p.DisplayName), name) then return p end
    end
    return nil
end

local function gp(input)
    if not input or input == "" then return {} end
    input = string.lower(input)
    local r = {}
    if input == "all" then
        for _, p in ipairs(Players:GetPlayers()) do table.insert(r, p) end
        return r
    elseif input == "others" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(r, p) end
        end
        return r
    elseif input == "me" then
        return {LocalPlayer}
    elseif input == "random" then
        local l = Players:GetPlayers()
        if #l > 0 then return {l[math.random(1, #l)]} end
        return {}
    elseif input == "friends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if s and f then table.insert(r, p) end
            end
        end
        return r
    elseif input == "nonfriends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if not (s and f) then table.insert(r, p) end
            end
        end
        return r
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if string.sub(string.lower(p.Name), 1, #input) == input or string.sub(string.lower(p.DisplayName), 1, #input) == input then
                table.insert(r, p)
            end
        end
        return r
    end
    return {}
end

