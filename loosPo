    for i = #S.pendingLockKicks, 1, -1 do
        local pl = S.pendingLockKicks[i]
        if not pl.Parent then
            table.remove(S.pendingLockKicks, i)
        elseif kickTargetByLock(pl) then
            table.remove(S.pendingLockKicks, i)
        end
    end
end, false)

