local function runLoop(key, interval, body, respectPause)
    if loopThreads[key] then return end
    loopThreads[key] = task.spawn(function()
        while S.monitorLoopActive do
            local skip = (respectPause and S.pauseLoops)
                or (S.panicPause and not S.panicKeep[key] and key ~= "panic_watch")
            if not skip then
                pcall(body)
            end
            task.wait(interval)
        end
        loopThreads[key] = nil
    end)
end
local function stopLoop(key)
    local t = loopThreads[key]
    if t then
        pcall(function() task.cancel(t) end)
        loopThreads[key] = nil
    end
end
local function stopAllLoops()
    local keys = {}
    pcall(function()
        for k in pairs(loopThreads) do table.insert(keys, k) end
    end)
    for _, k in ipairs(keys) do
        local t = loopThreads[k]
        if t then
            pcall(function() task.cancel(t) end)
            loopThreads[k] = nil
        end
    end
end
local function stopAllLoopsExcept(keep)
    local keepMap = {}
    for _, k in ipairs(keep) do keepMap[k] = true end
    local keys = {}
    pcall(function()
        for k in pairs(loopThreads) do table.insert(keys, k) end
    end)
    for _, k in ipairs(keys) do
        if not keepMap[k] then
            local t = loopThreads[k]
            if t then
                pcall(function() task.cancel(t) end)
                loopThreads[k] = nil
            end
        end
    end
end
local function panicPauseLoops(keep, seconds)
    local km = {}
    for _, k in ipairs(keep) do km[k] = true end
    S.panicKeep = km
    S.panicUntil = os.clock() + (seconds or 12)
    if not S.panicPause then
        S.panicPause = true
        dbg("Anti-Skick loops PAUSED while handling the kick attempt ("
            .. tostring(seconds or 12) .. "s window, still running: "
            .. table.concat(keep, ", ") .. ")")
    end
end
runLoop("panic_watch", 0.25, function()
    if S.panicPause and os.clock() >= S.panicUntil then
        S.panicPause = false
        S.panicKeep = {}
        notify("Anti-Skick", "Kick attempt handled - loops resumed", 4)
