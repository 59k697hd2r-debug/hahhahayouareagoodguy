-- ===== ADMIN PADS (Fixed: uses Owner StringValue, fast simultaneous claim) =====
local adminPads = {}
local clickDetector = nil

local function initAdminPads()
    local terrain = Workspace:FindFirstChild("Terrain")
    if not terrain then return false end
    local gf = terrain:FindFirstChild("_Game")
    if not gf then return false end
    local af = gf:FindFirstChild("Admin")
    if not af then return false end
    local pads = af:FindFirstChild("Pads")
    if not pads then return false end
    adminPads = pads:GetChildren()
    if #adminPads == 0 then return false end
    clickDetector = af:FindFirstChild("Regen") and af.Regen:FindFirstChild("ClickDetector")
    return true
end

local function padIsOurs(pad)
    local owner = pad:FindFirstChild("Owner")
    return owner and owner.Value == LocalPlayer.Name
end

local function startAutoAdmin()
    if not initAdminPads() then
        notify("Auto Admin", "Admin pads not found", 3)
        return
    end
    if autoAdminThread then return end
    autoAdminThread = task.spawn(function()
        while monitorLoopActive do
            local hrp = getHRP()
            if hrp then
                local endpoint = getSyncAPI()
                if not endpoint then
                    ensureF3X()
                    task.wait(1)
                else
                    local targetPads = {}
                    for _, pad in ipairs(adminPads) do
                        local head = pad:FindFirstChild("Head")
                        if head and head:IsA("BasePart") and not padIsOurs(pad) then
                            table.insert(targetPads, pad)
                        end
                    end
                    if #targetPads > 0 then
                        local pad = targetPads[math.random(1, #targetPads)]
                        local head = pad:FindFirstChild("Head")
                        if head and head:IsA("BasePart") then
                            local origCF = head.CFrame
                            local timeout = os.clock() + 5
                            while monitorLoopActive and os.clock() < timeout do
                                local currentHrp = getHRP()
                                if not currentHrp then break end
                                task.spawn(function()
                                    pcall(function() endpoint:InvokeServer("SyncMove", {{Part = head, CFrame = currentHrp.CFrame}}) end)
                                end)
                                pcall(function()
                                    firetouchinterest(head, currentHrp, 0)
                                    firetouchinterest(head, currentHrp, 1)
                                end)
                                if padIsOurs(pad) then
                                    task.spawn(function()
                                        pcall(function() endpoint:InvokeServer("SyncMove", {{Part = head, CFrame = origCF}}) end)
                                    end)
                                    break
                                end
                                task.wait(0.02)
                            end
                            task.spawn(function()
                                pcall(function() endpoint:InvokeServer("SyncMove", {{Part = head, CFrame = origCF}}) end)
                            end)
                        end
                    end
                end
            end
            task.wait(0.05)
        end
        autoAdminThread = nil
    end)
    notify("Auto Admin", "Started")
end

local function stopAutoAdmin()
    if autoAdminThread then task.cancel(autoAdminThread) autoAdminThread = nil end
    notify("Auto Admin", "Stopped")
end

local function claimAllAdminPads()
    if not initAdminPads() then return end
    local hrp = getHRP()
    if not hrp then return end
    local endpoint = getSyncAPI()
    if not endpoint then notify("Error", "F3X not available", 3) return end
    local claimed = 0
    for _, pad in ipairs(adminPads) do
        local head = pad:FindFirstChild("Head")
        if head and head:IsA("BasePart") and not padIsOurs(pad) then
            local origCF = head.CFrame
            local running = true
            task.spawn(function()
                while running do
                    task.spawn(function()
                        pcall(function() endpoint:InvokeServer("SyncMove", {{Part = head, CFrame = hrp.CFrame}}) end)
                    end)
                    pcall(function()
                        firetouchinterest(head, hrp, 0)
                        firetouchinterest(head, hrp, 1)
                    end)
                    task.wait(0.02)
                end
            end)
            local elapsed = 0
            while elapsed < 3 do
                if padIsOurs(pad) then
                    running = false
                    task.spawn(function()
                        pcall(function() endpoint:InvokeServer("SyncMove", {{Part = head, CFrame = origCF}}) end)
                    end)
                    claimed = claimed + 1
                    break
                end
                task.wait(0.02)
                elapsed = elapsed + 0.02
            end
            running = false
            task.spawn(function()
                pcall(function() endpoint:InvokeServer("SyncMove", {{Part = head, CFrame = origCF}}) end)
            end)
        end
    end
    notify("Claim All", "Claimed " .. claimed .. " pads")
end

