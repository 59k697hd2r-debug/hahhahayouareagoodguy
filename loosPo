    local function mlHoldAlive(myToken, quiet)
        if MLS.token ~= myToken then return false end
        local function aliveNow()
            local ch = LocalPlayer.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            return (hum and hum.Health > 0) or false
        end
        if aliveNow() and mlF3xReady() then return true end
        local noToolSince = os.clock()
        local didReset = false
        if os.clock() - mlHoldStamp > 5 then
            mlHoldStamp = os.clock()
            notify("Model Loader", "You died - the import pauses and continues after respawn", 5)
        end
        while MLS.token == myToken do
            if not aliveNow() then
                noToolSince = os.clock()
                didReset = false
                setStatus("Died - pausing the import until you respawn...", MLC.WARN)
            elseif not mlF3xReady() then
                setStatus("Back alive - re-arming F3X (startergive)...", MLC.WARN)
                if os.clock() - mlLastGive > 8 then
                    mlLastGive = os.clock()
                    pcall(function() chatSystem("startergive") end)
                end
                if not didReset and os.clock() - noToolSince > 12
                    and os.clock() - mlLastGive > 4 then
                    didReset = true
                    notify("Model Loader", "No F3X after respawn - resetting once", 4)
                    pcall(function()
                        local hum = LocalPlayer.Character
                            and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        if hum then hum.Health = 0 end
                    end)
                end
            else
                if not quiet and os.clock() - mlHoldStamp > 5 then
                    mlHoldStamp = os.clock()
                    notify("Model Loader", "F3X back - continuing the import", 3)
                end
                return true
            end
            task.wait(0.25)
        end
        return false
    end
    local function safeGetObjects(id)
        local loaded, result = false, nil
        task.spawn(function()
            local ok, raw = pcall(function()
                return game:GetObjects("rbxassetid://" .. tostring(id))
            end)
            if ok and raw and #raw > 0 then result = raw[1] end
            loaded = true
        end)
