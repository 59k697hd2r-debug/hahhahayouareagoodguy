-- =====================================================================
-- \\ F3X Layer // --
-- Requests F3X via "f3x me", falls back to "btools me" if nothing arrives
-- (command names vary between KAH variants). The endpoint cache is in
-- S.cachedEndpoint; every call re-validates that the instance still has a
-- parent before trusting it.
-- =====================================================================
local function getSyncAPI()
    if S.cachedEndpoint and S.cachedEndpoint.Parent then return S.cachedEndpoint end
    S.cachedEndpoint = nil
    for _, container in ipairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if container then
            local t = container:FindFirstChild("Building Tools")
            if t then
                local s = t:FindFirstChild("SyncAPI")
                if s then
                    local e = s:FindFirstChild("ServerEndpoint")
                    if e then
                        S.cachedEndpoint = e
                        return e
                    end
                end
            end
        end
    end
    return nil
end

local function ensureF3X()
    if not S.f3xRequested then
        chatSystem("f3x me")
        S.f3xRequested = true
        task.delay(6, function()
            if not getSyncAPI() then
                -- v3.3.4 (user request): the fallback is now "startergive"
                -- -- the KAH command that grants the starter gear (which
                -- includes F3X) AND auto-re-gives it on every respawn.
                chatSystem("startergive")
                task.delay(10, function() S.f3xRequested = false end)
            else
                S.f3xRequested = false
            end
        end)
    end
end

local function getEndpoint()
    local e = getSyncAPI()
    if not e then
        ensureF3X()
        local w = 0
        while not e and w < 3 do
            task.wait(0.1)
            w = w + 0.1
            e = getSyncAPI()
        end
    end
    return e
end

local function f3x(args)
    local e = getEndpoint()
    if not e then return nil end
    local s, r = pcall(function() return e:InvokeServer(table.unpack(args)) end)
    if not s then S.cachedEndpoint = nil end
    return s and r or nil
end

local function deleteInstances(ins)
    if type(ins) ~= "table" then ins = {ins} end
    if #ins == 0 then return 0 end
    local e = getEndpoint()
    if not e then return 0 end
    local v = {}
    for _, i in ipairs(ins) do
        if i and i:IsA("Instance") then table.insert(v, i) end
    end
    if #v == 0 then return 0 end
    local t = 0
    for i = 1, #v, CFG.BATCH_SIZE do
        local b = {}
        for j = i, math.min(i + CFG.BATCH_SIZE - 1, #v) do table.insert(b, v[j]) end
        if pcall(function() e:InvokeServer("Remove", b) end) then t = t + #b end
        task.wait(0.01)
    end
    return t
end

