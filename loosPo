    local function mlImport(assetId, hitPos)
        local endpoint = getEndpoint()
        if not endpoint then
            ensureF3X()
            setStatus("F3X not found - said f3x me, retry in a few seconds", MLC.ERR)
            notify("Model Loader", "No F3X - gearing you, retry shortly", 4)
            return
        end
        if MLS.commitPace then pcall(MLS.commitPace) end
        if not (MLS.gui and MLS.gui.Parent) then return end
        local myToken = os.clock()
        MLS.token = myToken
        setChoiceReady(false)
        MLS.loaded = nil
        setStatus("Downloading asset...", MLC.WARN)
        task.spawn(function()
            local root = safeGetObjects(assetId)
            if not root then
                setStatus("Failed to load asset (stuck or invalid id)", MLC.ERR)
                notify("Model Loader", "Asset failed to load", 3)
                return
            end
            if MLS.token ~= myToken then
                pcall(function() root:Destroy() end)
                return
            end
            local baseCf, bSize = containerBox(root)
            local spawnCf = CFrame.new(hitPos) * CFrame.new(0, bSize.Y / 2, 0)
            local parts = {}
            if root:IsA("BasePart") then table.insert(parts, root) end
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("BasePart") then table.insert(parts, d) end
            end
            if #parts == 0 then
                setStatus("This model contains no BaseParts", MLC.ERR)
                pcall(function() root:Destroy() end)
                return
            end
            if not mlHoldAlive(myToken, true) then
                pcall(function() root:Destroy() end)
                return
            end
            local tempFolder = f3x({ "CreateGroup", "Folder", Workspace, {} })
            if not tempFolder then
                setStatus("F3X folder failed (no response)", MLC.ERR)
                pcall(function() root:Destroy() end)
                return
            end
            local dispName = tostring(root.Name or "Model"):gsub("[^%w%-_]", "")
            if dispName == "" or dispName == nil then dispName = "Model" end
            f3x({ "SetName", { tempFolder }, dispName .. "_Load" })
            setStatus(string.format("Importing %d parts...", #parts), MLC.WARN)
            local created, origNames = {}, {}
            local mapping, anchorFinal = {}, {}
            local resizeB, colorB, matB, anchorB = {}, {}, {}, {}
            local meshCreateB, meshSyncB = {}, {}
            local revealB, matSamples, meshSamples = {}, {}, {}
            local texB, texSrc = {}, {}
            local failed = 0
            local paceChunk = math.clamp(math.floor(tonumber(S.mlParts) or CFG.ML_BS_CHUNK or 2500), 10, 30000)
            local paceWin = 1 / math.clamp(tonumber(S.mlRate) or (1 / (CFG.ML_BS_WINDOW or 5)), 0.1, 60)
            local function holdPace(doneCount)
                if doneCount >= #parts or doneCount % paceChunk ~= 0 then return end
                local waited = 0
                while waited < paceWin and MLS.token == myToken do
                    task.wait(0.1)
                    waited = waited + 0.1
                end
            end
            local function recordCreate(srcPart, made, targetCf)
                if made then
                    table.insert(created, made)
                    table.insert(origNames, srcPart.Name)
                    mapping[srcPart] = made
                    table.insert(resizeB, { Part = made, CFrame = targetCf, Size = srcPart.Size })
                    table.insert(colorB, { Part = made, Color = srcPart.Color })
                    if S.mlGhost then
                        local hm = { Part = made, Material = srcPart.Material, Transparency = 1 }
                        if srcPart.Reflectance ~= 0 then hm.Reflectance = srcPart.Reflectance end
                        table.insert(matB, hm)
                        local rm = { Part = made, Material = srcPart.Material, Transparency = srcPart.Transparency }
                        if srcPart.Reflectance ~= 0 then rm.Reflectance = srcPart.Reflectance end
                        table.insert(revealB, rm)
                    elseif srcPart.Material ~= Enum.Material.Plastic or srcPart.Transparency ~= 0
                        or srcPart.Reflectance ~= 0 then
                        local m = { Part = made, Material = srcPart.Material, Transparency = srcPart.Transparency }
                        if srcPart.Reflectance ~= 0 then m.Reflectance = srcPart.Reflectance end
                        table.insert(matB, m)
                    end
                    table.insert(anchorB, { Part = made, Anchored = true })
                    table.insert(anchorFinal, { Part = made, Anchored = srcPart.Anchored })
                    if S.mlMeshes then
                        local okM, cMesh, sMesh = pcall(meshProps, srcPart, made)
                        if okM and cMesh and sMesh then
                            table.insert(meshCreateB, cMesh)
                            table.insert(meshSyncB, sMesh)
                            if #meshSamples < 8 then
                                table.insert(meshSamples, { made, sMesh.Scale })
                            end
                        end
                    end
                    if #matSamples < 8 and srcPart.Material ~= Enum.Material.Plastic then
                        table.insert(matSamples, { made, srcPart.Material })
                    end
                    for _, child in ipairs(srcPart:GetChildren()) do
                        if child:IsA("SurfaceAppearance") then
                            pcall(function() child:Clone().Parent = made end)
                        elseif child:IsA("Texture") or child:IsA("Decal") then
                            table.insert(texB, {
                                Part = made,
                                TextureType = child.ClassName,
                                Face = child.Face,
                                Texture = child.Texture,
                            })
                            table.insert(texSrc, { made, child })
                        end
                    end
                else
                    failed = failed + 1
                end
            end
            local function bigshotCreate()
                local seen, order, template = {}, {}, {}
                for _, part in ipairs(parts) do
                    local key = mapPartType(part) .. "|" .. part.Material.Name
                    if not seen[key] then
                        seen[key] = true
                        table.insert(order, key)
                    end
                end
                local parkCf = spawnCf * CFrame.new(0, -500, 0)
                for _, key in ipairs(order) do
                    if not mlHoldAlive(myToken) then return true end
                    local ptype, matName = key:match("^(.-)|(.+)$")
                    local tpl = f3x({ "CreatePart", ptype, parkCf, tempFolder })
                    if not tpl then
                        if not mlF3xReady() and mlHoldAlive(myToken, true) then
                            tpl = f3x({ "CreatePart", ptype, parkCf, tempFolder })
                        end
                        if not tpl then return false end
                    end
                    local matEntry = { Part = tpl }
                    pcall(function() matEntry.Material = Enum.Material[matName] end)
                    if S.mlGhost then matEntry.Transparency = 1 end
                    f3x({ "SyncMaterial", { matEntry } })
                    template[key] = tpl
                end
                local chunk = paceChunk
                local windowS = paceWin
                for i = 1, #parts, chunk do
                    if not mlHoldAlive(myToken) then return true end
                    local items, idx = {}, {}
                    for j = i, math.min(i + chunk - 1, #parts) do
                        local p = parts[j]
                        table.insert(items, template[mapPartType(p) .. "|" .. p.Material.Name])
                        table.insert(idx, j)
                    end
                    local clones = f3x({ "Clone", items, tempFolder })
                    if type(clones) ~= "table" or #clones ~= #items then
                        if not mlF3xReady() and mlHoldAlive(myToken, true) then
                            clones = f3x({ "Clone", items, tempFolder })
                        end
                    end
                    if type(clones) ~= "table" or #clones ~= #items then
                        local kids = tempFolder:GetChildren()
                        if #kids > 0 then deleteInstances(kids) end
                        return false
                    end
                    for k, j in ipairs(idx) do
                        local part = parts[j]
                        local targetCf = spawnCf * baseCf:ToObjectSpace(part.CFrame)
                        recordCreate(part, clones[k], targetCf)
                    end
                    setStatus(string.format("BIG SHOT: %d / %d parts (paced %d / %ds)",
                        math.min(i + chunk - 1, #parts), #parts, chunk, windowS), MLC.WARN)
                    if i + chunk <= #parts and MLS.token == myToken then
                        local waited = 0
                        while waited < windowS and MLS.token == myToken do
                            task.wait(0.1)
                            waited = waited + 0.1
                        end
                    end
                end
                return true
            end
            local phase = S.mlMode
            if phase == "bigshot" then
                setStatus(string.format("BIG SHOT: %d parts -> type x material templates, paced %d / %.1fs",
                    #parts, paceChunk, paceWin), MLC.WARN)
                local okBig = bigshotCreate()
                if not okBig then
                    created, origNames = {}, {}
                    mapping, anchorFinal = {}, {}
                    resizeB, colorB, matB, anchorB = {}, {}, {}, {}
                    meshCreateB, meshSyncB = {}, {}
                    texB, texSrc = {}, {}
                    revealB, matSamples, meshSamples = {}, {}, {}
                    failed = 0
                    phase = "oneshot"
                    setStatus("Big Shot rejected by server - falling back to the wave", MLC.WARN)
                end
            end
            if phase == "stream" then
                for idx, part in ipairs(parts) do
                    if MLS.token ~= myToken or not mlHoldAlive(myToken, true) then
                        pcall(function() root:Destroy() end)
                        f3x({ "Remove", { tempFolder } })
                        setStatus("Import cancelled - partial parts removed", MLC.ERR)
                        return
                    end
                    local targetCf = spawnCf * baseCf:ToObjectSpace(part.CFrame)
                    local made = f3x({ "CreatePart", mapPartType(part), targetCf, tempFolder })
                    if not made and MLS.token == myToken and not mlF3xReady() then
                        if mlHoldAlive(myToken, true) then
                            made = f3x({ "CreatePart", mapPartType(part), targetCf, tempFolder })
                        end
                    end
                    recordCreate(part, made, targetCf)
                    holdPace(idx)
                    if idx % 15 == 0 then
                        setStatus(string.format("Spawning: %d / %d", idx, #parts), MLC.WARN)
                        task.wait()
                    end
                end
            elseif phase == "oneshot" then
                local cap = CFG.ML_WAVE_CAP or 125
                local inFlight, done, reported = 0, 0, 0
                local lastReport = os.clock()
                local dispatched = 0
                for _, part in ipairs(parts) do
                    if MLS.token ~= myToken then break end
                    while inFlight >= cap and MLS.token == myToken do task.wait(0.01) end
                    if not mlHoldAlive(myToken, true) then break end
                    inFlight = inFlight + 1
                    dispatched = dispatched + 1
                    local targetCf = spawnCf * baseCf:ToObjectSpace(part.CFrame)
                    task.spawn(function()
                        local made = nil
                        if MLS.token == myToken then
                            made = f3x({ "CreatePart", mapPartType(part), targetCf, tempFolder })
                        end
                        if not made and MLS.token == myToken
                            and not mlF3xReady() and mlHoldAlive(myToken, true) then
                            made = f3x({ "CreatePart", mapPartType(part), targetCf, tempFolder })
                        end
                        recordCreate(part, made, targetCf)
                        inFlight = inFlight - 1
                        done = done + 1
                    end)
                    local now = os.clock()
                    if now - lastReport >= 0.25 and done > reported then
                        lastReport = now
                        reported = done
                        setStatus(string.format("Spawning: %d / %d (one-shot wave)", done, #parts), MLC.WARN)
                    end
                    holdPace(dispatched)
                end
                while inFlight > 0 do task.wait(0.02) end
            end
            if MLS.token ~= myToken then
                pcall(function() root:Destroy() end)
                f3x({ "Remove", { tempFolder } })
                setStatus("Import cancelled - partial parts removed", MLC.ERR)
                return
            end
            setStatus("Sync phases: resize -> color -> material -> anchor (one remote each)", MLC.WARN)
            for i = 1, #resizeB, CFG.BATCH_SIZE do
                if not mlHoldAlive(myToken, true) then break end
                local b = {}
                for j = i, math.min(i + CFG.BATCH_SIZE - 1, #resizeB) do table.insert(b, resizeB[j]) end
                f3x({ "SyncResize", b })
            end
            for i = 1, #colorB, CFG.BATCH_SIZE do
                if not mlHoldAlive(myToken, true) then break end
                local b = {}
                for j = i, math.min(i + CFG.BATCH_SIZE - 1, #colorB) do table.insert(b, colorB[j]) end
                f3x({ "SyncColor", b })
            end
            for i = 1, #matB, CFG.BATCH_SIZE do
                if not mlHoldAlive(myToken, true) then break end
                local b = {}
                for j = i, math.min(i + CFG.BATCH_SIZE - 1, #matB) do table.insert(b, matB[j]) end
                f3x({ "SyncMaterial", b })
            end
            if #matSamples > 0 then
                task.wait(0.25)
                local bad = 0
                for _, s in ipairs(matSamples) do
                    local okS, cur = pcall(function() return s[1].Material end)
                    if not okS or cur ~= s[2] then bad = bad + 1 end
                end
                if bad > 0 then
                    setStatus("Materials dropped - re-firing in small batches...", MLC.WARN)
                    for i = 1, #matB, 250 do
                        local b = {}
                        for j = i, math.min(i + 250 - 1, #matB) do table.insert(b, matB[j]) end
                        f3x({ "SyncMaterial", b })
                        task.wait(0.05)
                    end
                    task.wait(0.25)
                    bad = 0
                    for _, s in ipairs(matSamples) do
                        local okS2, cur2 = pcall(function() return s[1].Material end)
                        if not okS2 or cur2 ~= s[2] then bad = bad + 1 end
                    end
                    if bad > 0 then
                        print("[KAHX ML] material retry still wrong on " .. bad .. "/" .. #matSamples .. " samples")
                    end
                end
            end
            for i = 1, #anchorB, CFG.BATCH_SIZE do
                if not mlHoldAlive(myToken, true) then break end
                local b = {}
                for j = i, math.min(i + CFG.BATCH_SIZE - 1, #anchorB) do table.insert(b, anchorB[j]) end
                f3x({ "SyncAnchor", b })
            end
            if S.mlMeshes then
                for i = 1, #meshCreateB, CFG.BATCH_SIZE do
                    if not mlHoldAlive(myToken, true) then break end
                    local b1, b2 = {}, {}
                    for j = i, math.min(i + CFG.BATCH_SIZE - 1, #meshCreateB) do
                        table.insert(b1, meshCreateB[j])
                        table.insert(b2, meshSyncB[j])
                    end
                    f3x({ "CreateMeshes", b1 })
                    f3x({ "SyncMesh", b2, 1 })
                end
            end
            if S.mlMeshes and #meshSamples > 0 then
                task.wait(0.25)
                local badM = 0
                for _, s in ipairs(meshSamples) do
                    local okS, cur = pcall(function()
                        local m = s[1]:FindFirstChildOfClass("SpecialMesh")
                        return m and m.Scale or nil
                    end)
                    local want = s[2]
                    if not okS or not cur
                        or math.abs(cur.X - want.X) > 0.01
                        or math.abs(cur.Y - want.Y) > 0.01
                        or math.abs(cur.Z - want.Z) > 0.01 then
                        badM = badM + 1
                    end
                end
                if badM > 0 then
                    setStatus("Meshes dropped - re-firing in small batches...", MLC.WARN)
                    for i = 1, #meshSyncB, 250 do
                        local b2 = {}
                        for j = i, math.min(i + 250 - 1, #meshSyncB) do table.insert(b2, meshSyncB[j]) end
                        f3x({ "SyncMesh", b2, 1 })
                        task.wait(0.05)
                    end
                    task.wait(0.25)
                    badM = 0
                    for _, s in ipairs(meshSamples) do
                        local okS2, cur2 = pcall(function()
                            local m = s[1]:FindFirstChildOfClass("SpecialMesh")
                            return m and m.Scale or nil
                        end)
                        local want2 = s[2]
                        if not okS2 or not cur2
                            or math.abs(cur2.X - want2.X) > 0.01
                            or math.abs(cur2.Y - want2.Y) > 0.01
                            or math.abs(cur2.Z - want2.Z) > 0.01 then
                            badM = badM + 1
                        end
                    end
                    if badM > 0 then
                        print("[KAHX ML] mesh retry still wrong on " .. badM .. "/" .. #meshSamples .. " samples")
                    end
                end
            end
            if #texB > 0 then
                setStatus("Textures: server-side CreateTextures/SyncTexture...", MLC.WARN)
                local roundIdx, rounds = {}, {}
                for _, e in ipairs(texB) do
                    local r = roundIdx[e.Part] or 1
                    roundIdx[e.Part] = r + 1
                    rounds[r] = rounds[r] or {}
                    table.insert(rounds[r], e)
                end
                local okTex = true
                for r = 1, #rounds do
                    local made = f3x({ "CreateTextures", rounds[r] })
                    if type(made) ~= "table" then
                        okTex = false
                        break
                    end
                    f3x({ "SyncTexture", rounds[r] })
                end
                if not okTex then
                    print("[KAHX ML] CreateTextures missing - client-clone fallback")
                    for _, pair in ipairs(texSrc) do
                        pcall(function() pair[2]:Clone().Parent = pair[1] end)
                    end
                end
            end
            setStatus("Rebuilding joints + welds...", MLC.WARN)
            pcall(function()
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") then
                        local p0, p1 = mapping[d.Part0], mapping[d.Part1]
                        if p0 and p1 then
                            local w = Instance.new(d.ClassName)
                            w.Part0 = p0
                            w.Part1 = p1
                            if w:IsA("Weld") or w:IsA("Motor6D") then
                                w.C0 = d.C0
                                w.C1 = d.C1
                            end
                            w.Parent = p0
                        end
                    end
                end
            end)
            pcall(function() root:Destroy() end)
            setStatus("Restoring anchor states...", MLC.WARN)
            for i = 1, #anchorFinal, CFG.BATCH_SIZE do
                if not mlHoldAlive(myToken, true) then break end
                local b = {}
                for j = i, math.min(i + CFG.BATCH_SIZE - 1, #anchorFinal) do
                    table.insert(b, anchorFinal[j])
                end
                f3x({ "SyncAnchor", b })
            end
            if MLS.token ~= myToken then
                f3x({ "Remove", { tempFolder } })
                return
            end
            if S.mlGhost and #revealB > 0 then
                setStatus("Ghost build done - revealing all parts...", MLC.WARN)
                for i = 1, #revealB, CFG.BATCH_SIZE do
                    if not mlHoldAlive(myToken, true) then break end
                    local b = {}
                    for j = i, math.min(i + CFG.BATCH_SIZE - 1, #revealB) do table.insert(b, revealB[j]) end
                    f3x({ "SyncMaterial", b })
                end
            end
            MLS.loaded = { folder = tempFolder, parts = created, orig = origNames, name = dispName }
            table.insert(Variables.mlLoadedFolders, tempFolder)
            setChoiceReady(true)
            local msg = string.format("Model loaded: %d parts (%d failed) - choose Keep in Workspace or Hide", #created, failed)
            setStatus(msg, MLC.OK)
            notify("Model Loader", "Loaded " .. #created .. " parts - pick Workspace or Hide It", 5)
            print("[KAHX ML] import done (" .. tostring(S.mlMode) .. "): " .. #created .. " parts, " .. failed .. " failed, temp folder waiting for choice")
        end)
    end
    local function updateViewCamera()
        if not (MLS.cam and MLS.cam.Parent) then return end
        local rot = CFrame.Angles(0, math.rad(MLS.pax), 0)
            * CFrame.Angles(math.rad(MLS.pay), 0, 0)
        MLS.cam.CFrame = CFrame.new(MLS.center + rot.LookVector * MLS.dist, MLS.center)
    end
    conn(UserInputService.InputChanged:Connect(function(input)
        if not MLS.drag then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - MLS.last
        MLS.last = input.Position
        MLS.pax = MLS.pax - delta.X
        MLS.pay = math.clamp(MLS.pay - delta.Y, -85, 85)
        updateViewCamera()
    end))
    conn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            MLS.drag = false
        end
    end))
    local function ensureViewAssets()
        if not (MLS.frame and MLS.frame.Parent) then return end
        if not (MLS.world and MLS.world.Parent) then
            MLS.world = Instance.new("WorldModel")
            MLS.world.Parent = MLS.frame
        end
        if not (MLS.cam and MLS.cam.Parent) then
            MLS.cam = Instance.new("Camera")
            MLS.cam.Parent = MLS.frame
            MLS.frame.CurrentCamera = MLS.cam
        end
    end
    local function runPreview(id)
        if not (MLS.frame and MLS.frame.Parent) then return end
        ensureViewAssets()
        local myToken = os.clock()
        MLS.previewToken = myToken
        if MLS.hint then MLS.hint.Text = "Loading Preview..." end
        if MLS.info then MLS.info.Text = "Model info: loading..." end
        if MLS.world then
            for _, c in ipairs(MLS.world:GetChildren()) do
                pcall(function() c:Destroy() end)
            end
        end
        task.spawn(function()
            local model = safeGetObjects(id)
            if MLS.previewToken ~= myToken then
                if model then pcall(function() model:Destroy() end) end
                return
            end
            if not model then
                if MLS.hint then MLS.hint.Text = "Preview Failed" end
                if MLS.info then MLS.info.Text = "Preview failed - check the id" end
                return
            end
            pcall(function() model.Parent = MLS.world end)
            local cf, size = containerBox(model)
            local maxDim = math.max(size.X, size.Y, size.Z)
            MLS.dist = math.clamp(maxDim * 1.5, 0.5, 100000)
            MLS.center = cf.Position
            MLS.pax, MLS.pay = -45, -30
            updateViewCamera()
            if MLS.hint then MLS.hint.Text = "" end
            if MLS.info then
                local parts, meshes = 0, 0
                pcall(function()
                    local function count(d)
                        if d:IsA("BasePart") then
                            parts = parts + 1
                            if d:IsA("MeshPart") then meshes = meshes + 1 end
                        elseif d:IsA("SpecialMesh") then
                            meshes = meshes + 1
                        end
                    end
                    if model:IsA("BasePart") then count(model) end
                    for _, d in ipairs(model:GetDescendants()) do count(d) end
                end)
                local creator = "unknown"
                pcall(function()
                    local info = game:GetService("MarketplaceService")
                        :GetProductInfo(tonumber(id) or 0)
                    if info and info.Creator and info.Creator.Name then
                        creator = info.Creator.Name
                    end
                end)
                MLS.info.Text = string.format("By %s\n%d parts, %d meshes\nsize %d x %d x %d",
                    creator, parts, meshes,
                    math.floor(size.X + 0.5), math.floor(size.Y + 0.5), math.floor(size.Z + 0.5))
            end
        end)
    end
    local function disarmPlace()
        MLS.armed = false
        if MLS.armConn then
            MLS.armConn:Disconnect()
            MLS.armConn = nil
        end
        if MLS.followConn then
            MLS.followConn:Disconnect()
            MLS.followConn = nil
        end
        if MLS.follow then MLS.follow.Visible = false end
        if MLS.placeBtn then
            pcall(function()
                MLS.placeBtn.Text = "Click to Place"
                MLS.placeBtn.BackgroundColor3 = MLC.ROW
            end)
        end
    end
    local function armPlace()
        if MLS.armed then
            disarmPlace()
            return
        end
        if not (MLS.idBox and MLS.idBox.Text and MLS.idBox.Text:match("%d+")) then
            setStatus("Enter a valid model id first", MLC.ERR)
            return
        end
        disarmPlace()
        MLS.armed = true
        local armedAt = os.clock()
        if MLS.placeBtn then
            pcall(function()
                MLS.placeBtn.Text = "Click somewhere..."
                MLS.placeBtn.BackgroundColor3 = MLC.SEL
            end)
        end
        if MLS.follow then MLS.follow.Visible = true end
        MLS.followConn = conn(RunService.RenderStepped:Connect(function()
            if not (MLS.armed and MLS.follow and MLS.follow.Parent) then return end
            pcall(function()
                local hit = Mouse.Hit.Position
                local mpos = UserInputService:GetMouseLocation()
                MLS.follow.Position = UDim2.new(0, mpos.X + 15, 0, mpos.Y - 15)
                local dist = 0
                local ch = LocalPlayer.Character
                local hrp = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
                if hrp then dist = math.floor((hit - hrp.Position).Magnitude) end
                MLS.follow.Text = string.format("Y: %.1f | Dist: %d", hit.Y, dist)
            end)
        end))
        MLS.armConn = conn(UserInputService.InputBegan:Connect(function(input, processed)
            if not MLS.armed then return end
            if processed then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if os.clock() - armedAt < 0.35 then return end
            disarmPlace()
            local ok, hit = pcall(function() return Mouse.Hit.Position end)
            if ok and hit then
                mlImport(MLS.idBox.Text, hit)
            end
        end))
        setStatus("Click anywhere in the world to spawn there", MLC.ACCENT)
    end
