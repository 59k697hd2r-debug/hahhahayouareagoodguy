-- ===== CRASH (HOT POTATO) =====
local function crashPlayer(player)
    if not player then return end
    local uid = player.UserId
    local now = tick()
    if lastCrashTime[uid] and (now - lastCrashTime[uid]) < 0.05 then return end
    lastCrashTime[uid] = now
    local vn = player.Name
    chatSystem("gear me,me,me potato")
    task.wait(1.5)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not char then return end
    local function findPotatoes(container)
        local potatoes = {}
        if not container then return potatoes end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and (string.find(t.Name, "Potato") or t.Name == "HotPotato") then
                table.insert(potatoes, t)
            end
        end
        return potatoes
    end
    local potatoes = {}
    local waited = 0
    while #potatoes == 0 and waited < 5 do
        potatoes = findPotatoes(bp)
        for _, p in ipairs(findPotatoes(char)) do table.insert(potatoes, p) end
        if #potatoes == 0 then task.wait(0.1) waited = waited + 0.1 end
    end
    if #potatoes == 0 then
        notify("Crash", "Failed to get Hot Potato", 3)
        return
    end
    chatSystem("freeze " .. vn)
    chatSystem("size " .. vn .. " nan")
    task.wait(0.3)
    chatSystem("to " .. vn)
    task.wait(0.3)
    local victimChar = player.Character
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not victimChar or not myHRP then return end
    local victimHRP = victimChar:FindFirstChild("HumanoidRootPart")
    if not victimHRP then return end
    local timeout = os.clock() + 15
    while os.clock() < timeout do
        local potatoCount = 0
        for _, t in ipairs(victimChar:GetChildren()) do
            if t:IsA("Tool") and (string.find(t.Name, "Potato") or t.Name == "HotPotato") then
                potatoCount = potatoCount + 1
            end
        end
        if potatoCount >= 3 then
            chatSystem("thaw " .. vn)
            stats.playersKicked = stats.playersKicked + 1
            chatSystem("name " .. vn .. " [CRASHED]")
            notify("Crash", "Crashed " .. vn .. " with Hot Potato!", 4)
            return
        end
        for _, p in ipairs(potatoes) do
            if p.Parent == bp then p.Parent = char end
            local handle = p:FindFirstChild("Handle") or p:FindFirstChildWhichIsA("BasePart")
            if handle then
                pcall(function()
                    firetouchinterest(handle, victimHRP, 0)
                    firetouchinterest(handle, victimHRP, 1)
                end)
            end
        end
        pcall(function()
            firetouchinterest(myHRP, victimHRP, 0)
            firetouchinterest(myHRP, victimHRP, 1)
        end)
        task.wait(0.5)
    end
    chatSystem("thaw " .. vn)
    notify("Crash", "Potato crash timed out for " .. vn, 3)
end

