            local myHrp = getHRP()
            if myHrp then
                info = info .. "\nDistance: " .. string.format("%.1f studs", (hrp.Position - myHrp.Position).Magnitude)
            end
        end
        local tools = {}
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") then table.insert(tools, c.Name) end
        end
        local bp = t:FindFirstChild("Backpack")
