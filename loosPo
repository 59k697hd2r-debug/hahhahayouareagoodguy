-- v3.3.6 MULTI-SETUP (user: ".sks 2 means it will make 2 sks setups"):
-- the old command refused when one folder existed. Now .sks takes a
-- count, each setup is its own obfuscated F3X model and they ALL live
-- under "Realistic SunRays" (NOT "Realistic Bloom" -- user explicit).
-- Variables.SKSetups tracks every folder; Variables.SKickFolder stays
-- pointed at the newest one so every pre-3.3.6 code path keeps working.
-- v3.3.7 (user: "setup one of each then copy them for the amount"):
-- the command now builds exactly ONE complete setup and F3X-CLONES that
-- finished folder for every remaining unit, so .sks 10 costs one full
-- build plus nine cheap server clones instead of ten full builds.
local function countSkSetups()
    local n = 0
    pcall(function()
        for _, f in ipairs(Variables.SKSetups) do
            if f and f.Parent and f:FindFirstChildOfClass("SkateboardPlatform") then n = n + 1 end
        end
    end)
    return n
end

local function doSingleSkSetup()
    local toBeRemoved = {}
    for _, v in ipairs(Workspace:GetChildren()) do
        if v.Name == "Skateboard" then table.insert(toBeRemoved, v) end
    end
    if #toBeRemoved > 0 then f3x({"Remove", toBeRemoved}) end
    chatSystem("gear me 27902303")
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local SkateboardTool = bp and bp:WaitForChild("ROBLOXSkateboard", 3)
    if not SkateboardTool then
        local ch = LocalPlayer.Character
        SkateboardTool = ch and ch:FindFirstChild("ROBLOXSkateboard")
    end
    if not SkateboardTool then
        notify("Error", "Failed to get tool.", 3)
        return nil
    end
    SkateboardTool.Parent = LocalPlayer.Character
    SkateboardTool:Activate()
    local SkateboardModel = Workspace:WaitForChild("Skateboard", 5)
    if not SkateboardModel then
        notify("Error", "Failed to get model, did you place it?", 3)
        return nil
    end
    local SkateboardPlatform = SkateboardModel:WaitForChild("SkateboardPlatform", 3)
    if not SkateboardPlatform then
        notify("Error", "Failed to get kickpart.", 3)
        return nil
    end
    task.spawn(function()
        f3x({"SetName", {SkateboardPlatform}, getObfName()})
    end)
    f3x({"Remove", {SkateboardPlatform:FindFirstChildOfClass("Mesh")}})
    f3x({"SyncMaterial", {{Part = SkateboardPlatform, Transparency = 1}}})
    if SkateboardPlatform.Anchored then
        SkateboardPlatform:GetPropertyChangedSignal("Anchored"):Wait()
    end
    f3x({"SyncAnchor", {{Part = SkateboardPlatform, Anchored = true}}})
    f3x({"SyncResize", {{Part = SkateboardPlatform, CFrame = CFrame.new(0, -565, 0), Size = Vector3.new(50, 50, 50)}}})
    local hp = Workspace:FindFirstChild("Realistic SunRays") or getHiddenParent()
    local folder = f3x({"CreateGroup", "Model", hp, {}})
    if not folder then
        notify("Error", "SK setup failed (no F3X response)", 3)
        return nil
    end
    task.spawn(function()
        f3x({"SetName", {folder}, getObfName()})
    end)
    local TemporaryFolder = f3x({"CreateGroup", "Folder", folder, {SkateboardPlatform}})
    local t0 = os.clock()
    repeat task.wait() until (TemporaryFolder and SkateboardPlatform.Parent == TemporaryFolder) or os.clock() - t0 > 5
    if TemporaryFolder then f3x({"Ungroup", {TemporaryFolder}}) end
    f3x({"Remove", {SkateboardModel}})
    t0 = os.clock()
    repeat task.wait() until SkateboardPlatform.Parent == folder or os.clock() - t0 > 5
    table.insert(Variables.SKSetups, folder)
    Variables.SKickFolder = folder
    return folder
end

Handler:AddCommand("skateboardkicksetup", {Args = {"Count?"}, Aliases = {"sks"}, Description = "Sets up the skateboard kick: .sks = 1, .sks 3 = 3 setups (builds 1, clones the rest)"}, function(A, F)
    if S.sksSetupInProgress then return end
    local want = math.clamp(tonumber(A[1]) or 1, 1, 10)
    local have = countSkSetups()
    if have >= want then
        notify("SK Setup", "Already have " .. have .. " setup(s)", 3)
        return true
    end
    S.sksSetupInProgress = true
    local made = 0
    -- v3.3.7 clone pipeline: pick a surviving setup as the source (a
    -- fresh build when none exists), then clone it until the count is
    -- reached. The guard caps the loop so a broken clone response can
    -- never spin forever; failed clones fall back to a full rebuild.
    local base = nil
    if have == 0 then
        notify("SK Setup", "Building setup 1/" .. want .. "...", 3)
        base = doSingleSkSetup()
        if base then made = made + 1 end
    else
        pcall(function()
            for _, f in ipairs(Variables.SKSetups) do
                if f and f.Parent and f:FindFirstChildOfClass("SkateboardPlatform") then
                    base = f
                    break
                end
            end
        end)
        if not base and Variables.SKickFolder and Variables.SKickFolder.Parent then
            base = Variables.SKickFolder
        end
    end
    local guard = 0
    while countSkSetups() < want and guard < 20 do
        guard = guard + 1
        local cloned = false
        if base and base.Parent then
            local hp = Workspace:FindFirstChild("Realistic SunRays") or getHiddenParent()
            local res = hp and f3x({"Clone", {base}, hp}) or nil
            local clone = res
            if type(res) == "table" then clone = res[1] end
            if clone and clone.Parent then
                task.spawn(function() f3x({"SetName", {clone}, getObfName()}) end)
                table.insert(Variables.SKSetups, clone)
                Variables.SKickFolder = clone
                cloned = true
                made = made + 1
            end
        end
        if not cloned then
            notify("SK Setup", "Clone unavailable - full building a setup...", 3)
            local folder = doSingleSkSetup()
            if folder then
                made = made + 1
                if not base then base = folder end
            else
                break
            end
        end
        task.wait(0.2)
    end
    chatSystem("removetools others fuck")
    S.sksSetupInProgress = false
    if made > 0 and countSkSetups() > 0 then
        notify("Success", "Skateboard kick set up! (" .. countSkSetups() .. " total)", 3)
        return true
    end
    return false
end)

