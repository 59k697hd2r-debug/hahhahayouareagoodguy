local function getSyncAPI()
    if cachedEndpoint and cachedEndpoint.Parent then
        return cachedEndpoint
    end
    cachedEndpoint = nil
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local tool = bp:FindFirstChild("Building Tools")
        if tool then
            local syncAPI = tool:FindFirstChild("SyncAPI")
            if syncAPI then
                local endpoint = syncAPI:FindFirstChild("ServerEndpoint")
                if endpoint then
                    cachedEndpoint = endpoint
                    return endpoint
                end
            end
        end
    end
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChild("Building Tools")
        if tool then
            local syncAPI = tool:FindFirstChild("SyncAPI")
            if syncAPI then
                local endpoint = syncAPI:FindFirstChild("ServerEndpoint")
                if endpoint then
                    cachedEndpoint = endpoint
                    return endpoint
                end
            end
        end
    end
    return nil
end

local function f3x(args)
    local endpoint = getSyncAPI()
    if not endpoint then
        ensureF3X()
        local waited = 0
        while not endpoint and waited < 3 do
            task.wait(0.1)
            waited = waited + 0.1
            endpoint = getSyncAPI()
        end
    end
    if not endpoint then return nil end
    local s, r = pcall(function() return endpoint:InvokeServer(table.unpack(args)) end)
    if not s then cachedEndpoint = nil end
    return s and r or nil
end

local function deleteInstances(instances)
    if type(instances) ~= "table" then instances = {instances} end
    if #instances == 0 then return 0 end
    local endpoint = getSyncAPI()
    if not endpoint then
        ensureF3X()
        local waited = 0
        while not endpoint and waited < 3 do
            task.wait(0.1)
            waited = waited + 0.1
            endpoint = getSyncAPI()
        end
    end
    if not endpoint then return 0 end
    local valid = {}
    for _, v in ipairs(instances) do
        if v and v:IsA("Instance") then table.insert(valid, v) end
    end
    if #valid == 0 then return 0 end
    local total = 0
    for i = 1, #valid, 5000 do
        local batch = {}
        for j = i, math.min(i + 4999, #valid) do table.insert(batch, valid[j]) end
        if pcall(function() endpoint:InvokeServer("Remove", batch) end) then total = total + #batch end
        task.wait(0.01)
    end
    return total
end

