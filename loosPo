local function porta(targetName)
    local target = getPlayerFromPartial(targetName)
    if not target then
        notifyError("Player not found")
        return
    end
    local victimChar = target.Character
    if not victimChar then
        notifyError("Victim has no character")
        return
    end

    chatSystem("reset " .. target.Name)
    task.wait(0.2)
    chatSystem("goto " .. target.Name)
    task.wait(0.2)

    chatSystem("gear me portable")
    local maxWait = 5
    local waited = 0
    local portable = nil
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    while waited < maxWait do
        if backpack then
            portable = backpack:FindFirstChild("PortableJustice")
            if portable then break end
        end
        task.wait(0.2)
        waited = waited + 0.2
    end
    if not portable then
        notifyError("PortableJustice tool not found after 'gear me portable'")
        return
    end
    local char = LocalPlayer.Character
    if char then
        pcall(function()
            portable.Parent = char
        end)
        task.wait(0.1)
    end
    local mouseClick = portable:FindFirstChild("MouseClick")
    if not mouseClick then
        notifyError("MouseClick not found in PortableJustice")
        return
    end
    local args = { victimChar }
    pcall(function()
        mouseClick:FireServer(unpack(args))
    end)
    stats.playersPortaUsed = stats.playersPortaUsed + 1
    chatSystem("Porta used on " .. target.Name)
end

-- === .unancall, .nocolall, .trollclr ===
local function unanchorAll()
    equipBuildingTools()
    local endpoint = getSyncAPI()
    if not endpoint then
        notifyError("Building Tools not available")
        return
    end
    local targets = {"Part", "Truss", "Wedge", "CornerWedge"}
    local parts = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            local n = string.lower(v.Name)
            for _, t in ipairs(targets) do
                if n == string.lower(t) then
                    table.insert(parts, v)
                    break
                end
            end
        end
    end
    if #parts == 0 then
        notify(".unancall", "No matching parts found")
        return
    end
    for i = 1, #parts, 5000 do
        local batch = {}
        for j = i, math.min(i + 4999, #parts) do
            table.insert(batch, {
                Part = parts[j],
                CFrame = parts[j].CFrame,
                Anchored = false
            })
        end
        local args = {"SyncAnchor", batch}
        pcall(function()
            endpoint:InvokeServer(unpack(args))
        end)
        task.wait(0.01)
    end
    notify(".unancall", "All matching parts unanchored")
end

