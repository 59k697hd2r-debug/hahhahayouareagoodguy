-- ===== PLAYER JOIN HANDLER =====
Players.PlayerAdded:Connect(function(player)
    if bannedPlayers[player.UserId] then
        task.spawn(function()
            task.wait(0.5)
            player.CharacterAdded:Wait()
            repeat task.wait(0.05) until player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local skCmd = Handler.Commands["skateboardkick"]
            local pkCmd = Handler.Commands["potatokick"]
            if skCmd then skCmd.callback({player.Name}, player.Name) end
            if pkCmd then pkCmd.callback({player.Name}, player.Name) end
            notify("Ban Enforcement", "Dual kicked on rejoin: " .. player.Name, 3)
        end)
    end
    if Variables.ServerLock then
        task.spawn(function()
            local isWhitelisted = false
            if Variables.ServerLockWhitelistFriends then
                local s, isFriend = pcall(function() return player:IsFriendsWith(LocalPlayer.UserId) end)
                if s and isFriend then isWhitelisted = true end
            end
            if table.find(Variables.ServerLockWhitelistIDs, player.UserId) then
                isWhitelisted = true
            end
            if not isWhitelisted then
                player.CharacterAdded:Wait()
                repeat task.wait(0.05) until player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Torso") and player.Character:FindFirstChild("Head")
                if Variables.ServerLock == "Skateboard" or Variables.ServerLock == "Dual" then
                    local skCmd = Handler.Commands["skateboardkick"]
                    if skCmd then skCmd.callback({player.Name}, player.Name) end
                end
                if Variables.ServerLock == "Potato" or Variables.ServerLock == "Dual" then
                    local pkCmd = Handler.Commands["potatokick"]
                    if pkCmd then pkCmd.callback({player.Name}, player.Name) end
                end
                notify("ServerLock", "Kicked " .. player.Name, 3)
            else
                notify("ServerLock", "Ignored whitelisted player: " .. player.Name, 3)
            end
        end)
    end
    if friendJoinAction ~= "none" then
        task.spawn(function()
            local s, isFriend = pcall(function() return player:IsFriendsWith(LocalPlayer.UserId) end)
            if s and isFriend then
                notify("Friend Joined", player.DisplayName .. " joined!", 5)
                task.spawn(function()
                    player.CharacterAdded:Wait()
                    repeat task.wait(0.05) until player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if friendJoinAction == "bring" then
                        chatSystem("bring " .. player.Name)
                    elseif friendJoinAction == "to" then
                        chatSystem("to " .. player.Name)
                    end
                end)
            end
        end)
    end
end)

-- ===== GEN2 UI HELPERS =====
local function uiButton(parent, props)
    return parent:CreateButton({name = props.Name or "", callback = props.Callback or function() end})
end

local function uiToggle(parent, props)
    return parent:CreateToggle({name = props.Name or "", value = props.Value or false, callback = props.Callback or function() end})
end

local function uiInput(parent, props)
    if typeof(parent.CreateInput) ~= "function" then return nil end
    return parent:CreateInput({
        name = props.Name or "",
        placeholder = props.Placeholder or "",
        callback = props.Callback or function() end,
        clearTextOnFocus = props.ClearTextOnFocus,
    })
end

local function uiText(parent, props)
    if typeof(parent.CreateText) == "function" then
        return parent:CreateText({name = props.Name or "", text = props.Text or props.Name or ""})
    end
end

local function uiDivider(parent, name)
    if typeof(parent.CreateDivider) == "function" then
        if name then
            return parent:CreateDivider({text = name})
        else
            return parent:CreateDivider()
        end
    end
end

local function uiStat(parent, props)
    if typeof(parent.CreateStat) == "function" then
        return parent:CreateStat({name = props.Name or "", value = props.Value or 0, prefix = props.Prefix})
    else
        local btn = parent:CreateButton({name = props.Name .. ": 0", callback = function() end})
        return {Set = function(_, val) btn:Set(props.Name .. ": " .. tostring(val)) end, value = 0}
    end
end

