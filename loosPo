-- === ANTI-FLING with velocity reset ===
local function getSafePosition()
    local tabby = Workspace:FindFirstChild("Tabby")
    if tabby then
        local adminHouse = tabby:FindFirstChild("Admin_House")
        if adminHouse then
            local baseplate = adminHouse:FindFirstChild("Baseplate")
            if baseplate and baseplate:IsA("BasePart") then
                return baseplate.Position + Vector3.new(0, 10, 0)
            end
        end
    end
    return Vector3.new(0, 10, 0)
end

local function startAntiFling()
    if antiFlingActive then return end
    antiFlingActive = true
    task.spawn(function()
        local lastSpeed = 0
        while antiFlingActive and monitorLoopActive do
            local char = LocalPlayer.Character
            if char then
                local rootPart = char:FindFirstChild("HumanoidRootPart")
                if rootPart and rootPart:IsA("BasePart") then
                    local currentVel = rootPart.AssemblyLinearVelocity
                    local speed = currentVel.Magnitude
                    local now = tick()
                    local spikeDetected = (speed > FLING_THRESHOLD_SPIKE and lastSpeed < 50 and speed - lastSpeed > 200)
                    if speed > FLING_THRESHOLD_HIGH or spikeDetected then
                        if (now - lastFlingTeleport) > FLING_COOLDOWN then
                            local safePos = getSafePosition()
                            rootPart.CFrame = CFrame.new(safePos)
                            rootPart.AssemblyLinearVelocity = Vector3.zero
                            rootPart.AssemblyAngularVelocity = Vector3.zero
                            lastFlingTeleport = now
                            notify("Anti-Fling", "Fling detected! Teleported to safe place", 3)
                        end
                    end
                    lastSpeed = speed
                end
            end
            task.wait(0.05)
        end
    end)
end
local function stopAntiFling() antiFlingActive = false end

