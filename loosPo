    -- ---------------------------------------------------------------
    local function runBarText(text)
        if text == "" then return end
        local codePrefix = ">" .. S.commandPrefix
        if string.sub(text, 1, #codePrefix) == codePrefix then
            runLua(prepChatCode(string.sub(text, #codePrefix + 1)))
            return
        end
        if string.sub(text, 1, #S.commandPrefix) == S.commandPrefix then
            local body = string.sub(text, #S.commandPrefix + 1)
            local first = string.match(body, "^(%S+)")
            if first and Handler.Commands[string.lower(first)] then
                -- ".fly" -> command, same as chat
                routeCommand(text)
            elseif #body > 0 then
                -- ".hello there" -> plain chat
                chatSystem(body)
            end
            return
        end
        -- bare "fly" -> command
        routeCommand(S.commandPrefix .. text)
    end

