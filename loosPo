local function deleteInstances(instances)
    if type(instances) ~= "table" then instances = {instances} end
    if #instances == 0 then return 0 end

    local endpoint = getSyncAPI()
    if not endpoint then
        notifyError("SyncAPI not available")
        return 0
    end

    local validBatch = {}
    for _, v in ipairs(instances) do
        if v and v:IsA("Instance") then
            table.insert(validBatch, v)
        end
    end
    if #validBatch == 0 then return 0 end

    local total = 0
    for i = 1, #validBatch, 5000 do
        local batch = {}
        for j = i, math.min(i + 4999, #validBatch) do
            table.insert(batch, validBatch[j])
        end
        local success = pcall(function()
            endpoint:InvokeServer("Remove", batch)
        end)
        if success then total = total + #batch end
        task.wait(0.01)
    end
    return total
end

local function deleteAllSpecialMeshes()
    local endpoint = getSyncAPI()
    if not endpoint then return end
    local meshes = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("SpecialMesh") then table.insert(meshes, v) end
    end
    if #meshes == 0 then notify(".delmesh", "No SpecialMesh found") return end
    local total = 0
    for i = 1, #meshes, 5000 do
        local batch = {}
        for j = i, math.min(i + 4999, #meshes) do table.insert(batch, meshes[j]) end
        pcall(function() endpoint:InvokeServer("Remove", batch) end)
        total = total + #batch
        task.wait(0.01)
    end
    notify(".delmesh", "Deleted " .. total .. " SpecialMesh instances")
end

