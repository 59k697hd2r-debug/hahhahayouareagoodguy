-- ===== CRASH (SWORD) =====
local function crashPlayer(player)
    if not player then return end
    local uid = player.UserId
    local now = tick()
    if lastCrashTime[uid] and (now - lastCrashTime[uid]) < 0.05 then return end
    lastCrashTime[uid] = now
    local endpoint = getSyncAPI()
    if not endpoint then return end
    local vc = player.Character
    if not vc then return end
    local hum = vc:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        chatSystem("respawn " .. player.Name)
        task.wait(0.1)
        vc = player.Character
        if not vc then return end
    end
    local rp = vc:FindFirstChild("HumanoidRootPart") or vc:FindFirstChildWhichIsA("BasePart")
    if not rp then return end
    local rpos = rp.Position
    local rh = vc:FindFirstChild("RightHand") or vc:FindFirstChild("Right Arm")
    local lh = vc:FindFirstChild("LeftHand") or vc:FindFirstChild("Left Arm")
    local rpos2 = (rh and rh:IsA("BasePart")) and rh.Position or (rpos + Vector3.new(2, 0, 0))
    local lpos2 = (lh and lh:IsA("BasePart")) and lh.Position or (rpos + Vector3.new(-2, 0, 0))
    local vn = player.Name
    chatSystem("freeze " .. vn)
    chatSystem("blind " .. vn)
    chatSystem("size " .. vn .. " nan")
    chatSystem("smoke " .. vn)
    chatSystem("flashify " .. vn)
    chatSystem("freeze me")
    for _ = 1, 8 do
        chatSystem("sword me")
        task.wait(0.02)
    end
    task.wait(0.1)
    local swords = {}
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local function collect(container)
        if container then
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") and (string.find(t.Name, "Sword") or string.find(t.Name, "LinkedSword")) then
                    table.insert(swords, t)
                end
            end
        end
    end
    collect(char)
    collect(bp)
    for _, t in ipairs(workspace:GetChildren()) do
        if t:IsA("Tool") and (string.find(t.Name, "Sword") or string.find(t.Name, "LinkedSword")) and not table.find(swords, t) then
            table.insert(swords, t)
        end
    end
    if #swords == 0 then
        chatSystem("thaw me")
        return
    end
    local posList = {}
    for i = 1, math.min(2, #swords) do table.insert(posList, rpos2 + Vector3.new(0, (i == 1 and 1 or -1), 0)) end
    for i = 1, math.min(2, math.max(0, #swords - #posList)) do table.insert(posList, lpos2 + Vector3.new(0, (i == 1 and 1 or -1), 0)) end
    local remaining = #swords - #posList
    local offsets = {Vector3.new(2, 0, 0), Vector3.new(-2, 0, 0), Vector3.new(0, 2, 0), Vector3.new(0, -2, 0)}
    for i = 1, math.min(remaining, #offsets) do table.insert(posList, rpos + offsets[i]) end
    for i = #posList + 1, #swords do
        local angle = (i - #posList) * 2.1
        table.insert(posList, rpos + Vector3.new(3 * math.cos(angle), 1, 3 * math.sin(angle)))
    end
    for i, sword in ipairs(swords) do
        if sword and sword:IsA("Tool") then
            if sword.Parent == bp then pcall(function() sword.Parent = char end) end
            pcall(function() sword.Parent = workspace end)
            local handle = sword:FindFirstChild("Handle") or sword
            if handle and handle:IsA("BasePart") then
                local pos = posList[i] or rpos + Vector3.new(0, 2 * i, 0)
                pcall(function() endpoint:InvokeServer("SyncMove", {{Part = handle, CFrame = CFrame.new(pos)}, {Pivot = CFrame.new(pos), Model = sword}}) end)
            end
            task.wait(0.01)
        end
    end
    chatSystem("thaw me")
    stats.playersKicked = stats.playersKicked + 1
    chatSystem("name " .. vn .. " [CRASHED]")
    notify("Crash", "Crashed " .. vn .. " with " .. #swords .. " swords", 4)
    task.wait(0.3)
    chatSystem("ungear " .. vn)
    chatSystem("crash " .. vn)
end

