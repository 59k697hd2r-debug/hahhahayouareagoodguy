local adminPads = {}
local clickDetector = nil

local function initAdminPads()
    local terrain = Workspace:FindFirstChild("Terrain")
    if not terrain then return false end
    local gameFolder = terrain:FindFirstChild("_Game")
    if not gameFolder then return false end
    local adminFolder = gameFolder:FindFirstChild("Admin")
    if not adminFolder then return false end
    local pads = adminFolder:FindFirstChild("Pads")
    if not pads then return false end
    adminPads = pads:GetChildren()
    if #adminPads < 9 then return false end
    clickDetector = adminFolder:FindFirstChild("Regen") and adminFolder.Regen:FindFirstChild("ClickDetector")
    return true
end

local function getHRP()
    local char = LocalPlayer.Character
    if char then return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart") end
    return nil
end

local function isDarkGreen(pad)
    local head = pad:FindFirstChild("Head")
    return head and head:IsA("BasePart") and head.BrickColor == BrickColor.new("Dark green")
end
local function isBrightRed(pad)
    local head = pad:FindFirstChild("Head")
    return head and head:IsA("BasePart") and head.BrickColor == BrickColor.new("Bright red")
end

local function fireRegen()
    if not clickDetector then return false end
    clickDetector.MaxActivationDistance = 99999
    pcall(function() fireclickdetector(clickDetector) end)
    return true
end

local function claimSinglePad(pad)
    local head = pad:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return false end
    local hrp = getHRP()
    if not hrp then return false end
    local origCF = head.CFrame
    local origCollide = head.CanCollide
    local running = true
    task.spawn(function()
        while running do
            local current = getHRP()
            if current and head and current:IsA("BasePart") then
                head.CFrame = current.CFrame
                head.CanCollide = false
                pcall(function()
                    firetouchinterest(head, current, 0)
                    firetouchinterest(head, current, 1)
                end)
            end
            task.wait(0.01)
        end
    end)
    local timeout = 15
    local elapsed = 0
    while elapsed < timeout do
        if isBrightRed(pad) then running = false; break end
        task.wait(0.05)
        elapsed = elapsed + 0.05
    end
    running = false
    head.CFrame = origCF
    head.CanCollide = origCollide
    return isBrightRed(pad)
end

local function findUnclaimedPad()
    for _, pad in ipairs(adminPads) do
        if isDarkGreen(pad) then return pad end
    end
    return nil
end

local function claimAllAdminPads()
    if not initAdminPads() then notifyError("Admin pads not available") return end
    local claimed = 0
    for attempt = 1, 30 do
        local pad = findUnclaimedPad()
        if not pad then break end
        if claimSinglePad(pad) then claimed = claimed + 1 else fireRegen(); task.wait(0.3) end
    end
    notify("Claim All", "Claimed " .. claimed .. " pads")
end

local function startAutoAdmin()
    if not initAdminPads() then notifyError("Admin pads not available") return end
    if autoAdminThread then return end
    autoAdminEnabled = true
    autoAdminThread = task.spawn(function()
        while autoAdminEnabled and monitorLoopActive do
            if not trackedAdminPad or not trackedAdminPad.Parent then
                local pad = findUnclaimedPad()
                if pad then
                    claimSinglePad(pad)
                    trackedAdminPad = pad
                else
                    fireRegen()
                    task.wait(0.3)
                    trackedAdminPad = nil
                end
            else
                if isDarkGreen(trackedAdminPad) then
                    claimSinglePad(trackedAdminPad)
                end
            end
            task.wait(0.1)
        end
        autoAdminThread = nil
    end)
    notify("Auto Admin", "Started")
end
local function stopAutoAdmin()
    autoAdminEnabled = false
    if autoAdminThread then task.cancel(autoAdminThread); autoAdminThread = nil end
    trackedAdminPad = nil
    notify("Auto Admin", "Stopped")
end

