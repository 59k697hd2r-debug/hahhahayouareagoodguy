-- v3.3.1: the real teardown lives on a global so the version guard can
-- self-heal re-execution (old instance tears down, new one loads fresh).
_G.KAHX_UNLOAD = function()
    S.monitorLoopActive = false
    stopAllLoops()
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    if S.afkConn then S.afkConn:Disconnect() end
    Antis.stopAntiKick()
    pcall(function() Antis.stopWorkspaceScan() end)
    Antis.stopAntiCrash()
    pcall(clearCats)
    -- fix #10: clear the version guard so re-executing works after unload
    _G.KAHX_VERSION = nil
    -- v3.3: kill the custom command bar / cmdlist UI too
    if type(S.CloseAllCustomUI) == "function" then pcall(S.CloseAllCustomUI) end
end

