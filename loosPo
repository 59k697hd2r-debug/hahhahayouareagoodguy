local function CreateUI()
    local function uiB(p, pr) return p:CreateButton({name = pr.Name or "", callback = pr.Callback or function() end}) end
    local function uiT(p, pr) return p:CreateToggle({name = pr.Name or "", value = pr.Value or false, callback = pr.Callback or function() end}) end
    local function uiI(p, pr)
        if typeof(p.CreateInput) ~= "function" then return nil end
        return p:CreateInput({name = pr.Name or "", placeholder = pr.Placeholder or "", callback = pr.Callback or function() end, clearTextOnFocus = pr.ClearTextOnFocus})
    end
    local function uiTx(p, pr)
        if typeof(p.CreateText) == "function" then return p:CreateText({name = pr.Name or "", text = pr.Text or pr.Name or ""}) end
    end
    local function uiD(p, n)
        if typeof(p.CreateDivider) == "function" then
            if n then return p:CreateDivider({text = n}) else return p:CreateDivider() end
        end
    end
    local function uiS(p, pr)
        if typeof(p.CreateStat) == "function" then return p:CreateStat({name = pr.Name or "", value = pr.Value or 0, prefix = pr.Prefix})
        else
            local b = p:CreateButton({name = pr.Name .. ": 0", callback = function() end})
            return {Set = function(_, v) b:Set(pr.Name .. ": " .. tostring(v)) end, value = 0}
        end
    end
    local function uiDD(p, pr)
        if typeof(p.CreateDropdown) ~= "function" then return nil end
        return p:CreateDropdown({name = pr.Name or "", options = pr.Options or {}, callback = pr.Callback or function() end})
    end
    local function uiC(p, pr)
        if typeof(p.CreateConsole) == "function" then return p:CreateConsole({name = pr.Name or "Console", height = pr.Height or 300, follow = true, maxLines = pr.MaxLines or 200}) end
        return nil
    end

