-- ANTI KILL ALL (v3.3.6): "reset <name>" for EVERY dead player.
-- Debounce per user spec: 2 tries, then stop FOR THAT VICTIM (not
-- everyone) for 45s; tries clear when the victim is alive again.
function Antis.startKillAll()
    if S.antiKillAllActive then return end
    S.antiKillAllActive = true
    runLoop("mon_resetall", 0.15, function()
        for _, p in ipairs(Players:GetPlayers()) do
            local k = tostring(p.UserId)
            local c = p.Character
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and c.Parent == Workspace then
                    -- alive again -> tries reset
                    S.resetTries[k] = 0
                end
            end
            local dead = false
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h and h.Health <= 0 then dead = true end
            end
            if dead then
                local n = os.clock()
                if S.resetCooldown[k] and n < S.resetCooldown[k] then
                    -- paused FOR THIS VICTIM only
                elseif (S.resetTries[k] or 0) >= 2 then
                    S.resetCooldown[k] = n + 45
                    S.resetTries[k] = 0
                    print("[KAHX Anti-Kill-All] " .. p.Name .. " hit 2 resets - paused for them 45s")
                elseif not S.resetLast[k] or (n - S.resetLast[k]) >= 1.5 then
                    S.resetLast[k] = n
                    S.resetTries[k] = (S.resetTries[k] or 0) + 1
                    chatSystem("reset " .. p.Name)
                    print("[KAHX Anti-Kill-All] reset " .. p.Name .. " (try " .. tostring(S.resetTries[k]) .. ")")
                end
            end
        end
    end, true)
end

function Antis.stopKillAll()
    S.antiKillAllActive = false
    stopLoop("mon_resetall")
end

