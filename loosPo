        if type(props) == "table" then
            if props.Parent ~= nil then wantParent = props.Parent end
            for k, v in pairs(props) do
                if k == "Parent" then
                elseif k == "Name" then
                    inst.Name = v
                else
                    local okp = pcall(function() inst[k] = v end)
                    if not okp then
                        pcall(function()
                            print("[KAHX ML] skipped property " .. class .. "." .. tostring(k))
                        end)
                    end
                end
            end
        end
        if wantParent then
            local okp2 = pcall(function() inst.Parent = wantParent end)
            if not okp2 then wantParent = nil end
        end
        return inst
    end
