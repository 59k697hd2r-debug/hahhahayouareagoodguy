local Characters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
local function randomString(length)
    local result = ""
    for i = 1, length do
        result = result .. string.sub(Characters, math.random(1, #Characters), math.random(1, #Characters))
    end
    return result
end

local function waitForChildOfClass(parent, className, timeout)
    timeout = timeout or 5
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA(className) then return child end
    end
    local start, found = os.clock(), nil
    local conn = parent.ChildAdded:Connect(function(c) if c:IsA(className) then found = c end end)
    while not found do
        if (os.clock() - start) >= timeout then
            conn:Disconnect()
            return nil
        end
        task.wait()
    end
    conn:Disconnect()
    return found
end

local function getPlayerFromPartial(name)
    if not name or name == "" then return nil end
    name = string.lower(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name) == name or string.lower(p.DisplayName) == name then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(p.Name), name) or string.find(string.lower(p.DisplayName), name) then return p end
    end
    return nil
end

local function gp(input)
    if not input or input == "" then return {} end
    input = string.lower(input)
    local result = {}
    if input == "all" then
        for _, p in ipairs(Players:GetPlayers()) do table.insert(result, p) end
        return result
    elseif input == "others" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(result, p) end
        end
        return result
    elseif input == "me" then
        return {LocalPlayer}
    elseif input == "random" then
        local list = Players:GetPlayers()
        if #list > 0 then return {list[math.random(1, #list)]} end
        return {}
    elseif input == "friends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, isFriend = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if s and isFriend then table.insert(result, p) end
            end
        end
        return result
    elseif input == "nonfriends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, isFriend = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if not (s and isFriend) then table.insert(result, p) end
            end
        end
        return result
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if string.sub(string.lower(p.Name), 1, #input) == input or string.sub(string.lower(p.DisplayName), 1, #input) == input then
                table.insert(result, p)
            end
        end
        return result
    end
end

