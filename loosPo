local function stopLoopKill(input)
    if not input or input == "" then notifyError("No target") return end
    if string.lower(input) == "all" then
        for key, thread in pairs(loopkillTasks) do
            if thread and type(thread) == "thread" then task.cancel(thread) end
            loopkillTasks[key] = nil
            loopkillTargetSet[key] = nil
        end
        loopkillTargetFuture = false
        notify("LoopKill", "Stopped all", 3)
        return
    end
    local player = getPlayerFromPartial(input)
    if player then
        stopLoopKillForPlayer(player)
        notify("LoopKill", "Stopped on " .. player.Name, 3)
    else
        notifyError("Player not found")
    end
end

local function startLoopKill(input, targetFutureJoins)
