local function routeCommand(msg)
    local body = string.sub(msg, #S.commandPrefix + 1)
    local args = {}
    for w in string.gmatch(body, "([^%s]+)") do table.insert(args, w) end
    if #args == 0 then return end
    local full = string.sub(body, #args[1] + 2)
    if S.chatCmdsToCode and not Handler.Commands[string.lower(args[1])] then
        runLua(prepChatCode(body))
        return
    end
    task.spawn(function()
        Handler:RunCommand(args[1], {table.unpack(args, 2)}, full)
    end)
end
local function matchChatBind(text)
    if not S.chatCmdsEnabled then return nil end
    local phrase = string.lower(tostring(text or ""))
    if phrase == "" then return nil end
    local cmd = (S.chatBinds or {})[phrase]
    if not cmd then return nil end
    local now = os.clock()
    if phrase == S.lastChatBindText and (now - (S.lastChatBindAt or 0)) < 0.75 then
        return nil
    end
    S.lastChatBindText = phrase
    S.lastChatBindAt = now
    return cmd
end
local function processText(text)
    local cb = (S.chatBinds or {})[string.lower(text)]
    if cb then
        task.spawn(routeCommand, S.commandPrefix .. cb)
        return
    end
    local codePrefix = ">" .. S.commandPrefix
    if string.sub(text, 1, #codePrefix) == codePrefix then
        runLua(prepChatCode(string.sub(text, #codePrefix + 1)))
        return
    end
    if string.sub(text, 1, #S.commandPrefix) == S.commandPrefix then
        routeCommand(text)
    else
        chatSystem(text)
    end
end
pcall(function()
    conn(TextChatService.SendingMessage:Connect(function(msg)
        local text = msg.Text
        if not S.chatCmdsEnabled then return end
        local bindCmd = matchChatBind(text)
        if bindCmd then
            pcall(function() msg.Text = "" end)
            task.spawn(routeCommand, S.commandPrefix .. bindCmd)
            return
        end
        local codePrefix = ">" .. S.commandPrefix
        if string.sub(text, 1, #codePrefix) == codePrefix then
            pcall(function() msg.Text = "" end)
            runLua(prepChatCode(string.sub(text, #codePrefix + 1)))
            return
        end
        if string.sub(text, 1, #S.silentPrefix) == S.silentPrefix then
            pcall(function() msg.Text = "" end)
            local body = string.sub(text, #S.silentPrefix + 1)
            if #body > 0 then
                local args = {}
                for w in string.gmatch(body, "([^%s]+)") do table.insert(args, w) end
                if #args > 0 then
                    Handler:RunCommand(args[1], {table.unpack(args, 2)}, string.sub(body, #args[1] + 2))
                end
            end
        elseif string.sub(text, 1, #S.commandPrefix) == S.commandPrefix then
            if S.silentCommands then pcall(function() msg.Text = "" end) end
            routeCommand(text)
        end
    end))
end)
