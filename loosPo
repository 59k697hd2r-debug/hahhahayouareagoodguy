-- === .kick ===
local function kickPlayer(targetName)
    local target = getPlayerFromPartial(targetName)
    if not target then
        notifyError("Player not found.")
        return
    end
    equipBuildingTools()
    local endpoint = getSyncAPI()
    if not endpoint then
        notifyError("Building Tools not available.")
        return
    end

    local victimChar = target.Character
    if not victimChar then
        notifyError("Victim has no character.")
        return
    end
    local victimPart = victimChar:FindFirstChild("HumanoidRootPart")
    if not victimPart then
        victimPart = victimChar:FindFirstChildWhichIsA("BasePart")
    end
    if not victimPart then
        notifyError("Victim has no BasePart.")
        return
    end
    local victimPos = victimPart.Position
    local victimName = target.Name

    chatSystem("freeze " .. victimName)
    task.wait(0.1)
    chatSystem("size " .. victimName .. " nan")
    task.wait(0.1)
    chatSystem("speed " .. victimName .. " 0")
    task.wait(0.1)

    for i = 1, 3 do
        local createArgs = {
            "CreatePart",
            "Tool",
            CFrame.new(victimPos + Vector3.new(0, i * 2, 0)),
            workspace
        }
        local success = pcall(function()
            endpoint:InvokeServer(unpack(createArgs))
        end)
        if not success then
            notifyError("Tool creation failed for tool " .. i)
            break
        end

        task.wait(0.2)
        local toolModel = nil
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v.Name == "Tool" then
                toolModel = v
                break
            end
        end
        if not toolModel then
            toolModel = getNil("Tool", "Model")
        end
        if not toolModel then
            notifyError("Could not find tool " .. i)
            break
        end

        local handle = toolModel:FindFirstChild("Handle")
        if not handle then
            notifyError("Tool " .. i .. " has no Handle.")
            break
        end

        local resizeArgs = {
            "SyncResize",
            {
                {
                    Part = handle,
                    CFrame = CFrame.new(victimPos + Vector3.new(0, i * 2 + 2, 0)),
                    Size = Vector3.new(10, 10, 10)
                }
            }
        }
        pcall(function()
            endpoint:InvokeServer(unpack(resizeArgs))
        end)

        local transArgs = {
            "SyncMaterial",
            {
                {
                    Part = handle,
                    Transparency = 1
                }
            }
        }
        pcall(function()
            endpoint:InvokeServer(unpack(transArgs))
        end)

        task.wait(0.1)
    end

    chatSystem("Kicked " .. victimName .. " with 3 transparent giant tools.")
end

