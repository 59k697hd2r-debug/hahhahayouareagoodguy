-- Home point: old game has Tabby.Admin_House.Baseplate; new game has no
-- baseplate, so we average the live admin pad head positions (filtering
-- out removed pads teleported to -1e6 or float overflow) and hover there.
local function getHomeCFrame()
    local tabby = Workspace:FindFirstChild("Tabby")
    if tabby then
        local ah = tabby:FindFirstChild("Admin_House")
        if ah then
            local bp = ah:FindFirstChild("Baseplate")
            if bp then return bp.CFrame + Vector3.new(0, 5, 0) end
        end
    end
    local pads = getAdminPads()
    if pads then
        local sx, sy, sz, n = 0, 0, 0, 0
        for _, pad in ipairs(pads:GetChildren()) do
            local head = pad:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                local p = head.Position
                if math.abs(p.X) < 10000 and math.abs(p.Y) < 10000 and math.abs(p.Z) < 10000 then
                    sx = sx + p.X
                    sy = sy + p.Y
                    sz = sz + p.Z
                    n = n + 1
                end
            end
        end
        if n > 0 then
            return CFrame.new(sx / n, (sy / n) + 4, (sz / n) - 10)
        end
    end
    return CFG.HOME_FALLBACK
end

