    for i = 1, len do r = r .. string.sub(Chars, math.random(1, #Chars), math.random(1, #Chars)) end
    return r
end

local function waitForChildOfClass(parent, cn, to)
    to = to or 5
    for _, c in ipairs(parent:GetChildren()) do if c:IsA(cn) then return c end end
    local s, f = os.clock(), nil
    local conn = parent.ChildAdded:Connect(function(c) if c:IsA(cn) then f = c end end)
    while not f do if (os.clock() - s) >= to then conn:Disconnect() return nil end task.wait() end
    conn:Disconnect()
    return f
end

