-- === CHAT COMMAND HOOK (with toggles) ===
local old
old = hookmetamethod(game, "__namecall", function(self, ...)
    if chatCmdsEnabled and self == ChatEvent and getnamecallmethod() == "FireServer" and typeof(({...})[1]) == "string" then
        local args = {...}
        local msg = string.lower(args[1])
        local parts = string.split(msg, " ")
        local cmd = parts[1]
        local arg1 = parts[2]
        local arg2 = parts[3]

        local function executeWithTargets(input, commandFunc, delay, friendChoice, skipCrashed)
            if not input or input == "" then
                chatSystem("Usage: " .. cmd .. " <player/random/all>")
                return
            end
            resolvePlayerInput(input, function(players)
                for i, player in ipairs(players) do
                    if delay and i > 1 then task.wait(delay) end
                    commandFunc(player)
                end
            end, friendChoice or false, skipCrashed or false)
        end

        local function handleCrash(input)
            local skip = (string.lower(input) == "all")
            executeWithTargets(input, crashPlayer, 0.5, true, skip)
        end

        local function handleGearban(input)
            executeWithTargets(input, function(p)
                addGearbanTarget(p)
                chatSystem("Now monitoring " .. p.Name .. " for gears")
            end, 0.5, false, false)
        end

        local function handleUngearban(input)
            executeWithTargets(input, function(p)
                removeGearbanTarget(p)
                chatSystem("Stopped monitoring " .. p.Name .. " for gears")
            end, 0.5, false, false)
        end

        local function handlePorta(input)
            executeWithTargets(input, function(p)
                porta(p.Name)
            end, 0.5, false, false)
        end

        local function handleBan(input)
            executeWithTargets(input, banPlayer, 0.5, false, false)
        end

        local function handleAfk(input)
            executeWithTargets(input, function(p)
                goAfk(p.Name)
            end, 0.5, false, false)
        end

        local function handleUnAfk(input)
            executeWithTargets(input, function(p)
                unAfk(p.Name)
            end, 0.5, false, false)
        end

        if cmd == ".clr" then
            task.spawn(clearAll)
        elseif cmd == ".adminclr" then
            task.spawn(adminClear)
        elseif cmd == ".getinfo" then
            if arg1 then
                executeWithTargets(arg1, function(p)
                    local gamepassStr = getGamepassInfo(p)
                    local info = "Name: " .. p.Name .. " | Display: " .. p.DisplayName .. " | UserId: " .. p.UserId .. gamepassStr
                    notify("Player Info", info, 5)
                end, 0.5, false, false)
            else
                notify("Player Info", "Usage: .getinfo <player/random/all>", 3)
            end
        elseif cmd == ".crash" or cmd == ".kick" then
            if arg1 then handleCrash(arg1) else chatSystem("Usage: .crash <player/random/all>") end
        elseif cmd == ".unancall" then
            task.spawn(unanchorAll)
        elseif cmd == ".nocolall" then
            task.spawn(nocolAll)
        elseif cmd == ".trollclr" then
            task.spawn(trollClr)
        elseif cmd == ".rejoin" then
            task.spawn(rejoin)
        elseif cmd == ".gearban" or cmd == ".gban" then
            if arg1 then handleGearban(arg1) else chatSystem("Usage: .gearban <player/random/all>") end
        elseif cmd == ".ungearban" or cmd == ".ungban" then
            if arg1 then handleUngearban(arg1) else chatSystem("Usage: .ungearban <player/random/all>") end
        elseif cmd == ".gameinfo" then
            task.spawn(gameInfo)
        elseif cmd == ".serverinfo" then
            task.spawn(serverInfo)
        elseif cmd == ".porta" then
            if arg1 then handlePorta(arg1) else chatSystem("Usage: .porta <player/random/all>") end
        elseif cmd == ".loopws" then
            if arg1 then
                local num = tonumber(arg1)
                if num then
                    if loopWSActive then stopLoopWS() end
                    startLoopWS(num)
                    chatSystem("WalkSpeed loop started at " .. num)
                else
                    chatSystem("Invalid number. Usage: .loopws <number>")
                end
            else
                if loopWSActive then stopLoopWS() chatSystem("WalkSpeed loop stopped") else chatSystem("WalkSpeed loop not active. Usage: .loopws <number>") end
            end
        elseif cmd == ".loopjp" then
            if arg1 then
                local num = tonumber(arg1)
                if num then
                    if loopJPActive then stopLoopJP() end
                    startLoopJP(num)
                    chatSystem("JumpPower loop started at " .. num)
                else
                    chatSystem("Invalid number. Usage: .loopjp <number>")
                end
            else
                if loopJPActive then stopLoopJP() chatSystem("JumpPower loop stopped") else chatSystem("JumpPower loop not active. Usage: .loopjp <number>") end
            end
        elseif cmd == ".loopgravity" then
            if arg1 then
                local num = tonumber(arg1)
                if num then
                    if loopGravityActive then stopLoopGravity() end
                    startLoopGravity(num)
                    chatSystem("Gravity loop started at " .. num)
                else
                    chatSystem("Invalid number. Usage: .loopgravity <number>")
                end
            else
                if loopGravityActive then stopLoopGravity() chatSystem("Gravity loop stopped") else chatSystem("Gravity loop not active. Usage: .loopgravity <number>") end
            end
        elseif cmd == ".afk" then
            if arg1 then handleAfk(arg1) else chatSystem("Usage: .afk <player/random/all>") end
        elseif cmd == ".unafk" then
            if arg1 then handleUnAfk(arg1) else chatSystem("Usage: .unafk <player/random/all>") end
        elseif cmd == ".ban" then
            if arg1 then handleBan(arg1) else chatSystem("Usage: .ban <player/random/all>") end
        elseif cmd == ".unban" then
            if arg1 then unbanPlayer(arg1) else chatSystem("Usage: .unban <name or User ID>") end
        elseif cmd == ".freeze" then
            if arg1 then
                executeWithTargets(arg1, function(p)
                    chatSystem("freeze " .. p.Name)
                end, 0.5, false, false)
            else chatSystem("Usage: .freeze <player/random/all>") end
        elseif cmd == ".thaw" then
            if arg1 then
                executeWithTargets(arg1, function(p)
                    chatSystem("thaw " .. p.Name)
                end, 0.5, false, false)
            else chatSystem("Usage: .thaw <player/random/all>") end
        elseif cmd == ".blind" then
            if arg1 then
                executeWithTargets(arg1, function(p)
                    chatSystem("blind " .. p.Name)
                end, 0.5, false, false)
            else chatSystem("Usage: .blind <player/random/all>") end
        elseif cmd == ".size" then
            if arg1 and arg2 then
                local target = getPlayerFromPartial(arg1)
                if target then
                    chatSystem("size " .. target.Name .. " " .. arg2)
                else
                    chatSystem("Player not found")
                end
            else
                chatSystem("Usage: .size <player> <value>")
            end
        elseif cmd == ".speed" then
            if arg1 and arg2 then
                local target = getPlayerFromPartial(arg1)
                if target then
                    chatSystem("speed " .. target.Name .. " " .. arg2)
                else
                    chatSystem("Player not found")
                end
            else
                chatSystem("Usage: .speed <player> <value>")
            end
        elseif cmd == ".reset" then
            if arg1 then
                executeWithTargets(arg1, function(p)
                    chatSystem("reset " .. p.Name)
                end, 0.5, false, false)
            else chatSystem("Usage: .reset <player/random/all>") end
        end

        if silentCommands then
            return nil
        else
            return old and old(self, ...)
        end
    end
    return old and old(self, ...)
end)

-- === CHARACTER MONITOR (auto-respawn) ===
local wasAlive = true
local debounce = false
local lastReTime = 0
local suppressRe = false

task.spawn(function()
    while monitorLoopActive do
        local char = LocalPlayer.Character
        local isDead = false
        local isPunished = false
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                isDead = true
            end
            if char.Parent == Lighting then
                isPunished = true
            end
        end
        local isAlive = (char ~= nil and char.Parent == workspace and not isDead and not isPunished)
        if wasAlive and not isAlive then
            local now = tick()
            if not debounce and not suppressRe and (now - lastReTime > 1) then
                chatSystem("re")
                debounce = true
                lastReTime = now
                task.wait(0.4)
                debounce = false
            end
        end
        wasAlive = isAlive
        task.wait(0.05)
    end
end)

