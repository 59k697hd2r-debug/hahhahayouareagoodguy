local function crashPlayer(player)
    if not player then return end
    local userId = player.UserId
    local now = tick()
    if lastCrashTime[userId] and (now - lastCrashTime[userId]) < CRASH_COOLDOWN then return end
    lastCrashTime[userId] = now

    local endpoint = getSyncAPI()
    if not endpoint then notifyError("SyncAPI not available") return end

    local victimChar = player.Character
    if not victimChar then notifyError(player.Name .. " has no character") return end

    local humanoid = victimChar:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        chatSystem("respawn " .. player.Name)
        task.wait(0.2)
        victimChar = player.Character
        if not victimChar then notifyError(player.Name .. " still no character") return end
    end

    local rootPart = victimChar:FindFirstChild("HumanoidRootPart") or victimChar:FindFirstChildWhichIsA("BasePart")
    if not rootPart then notifyError("No BasePart") return end
    local rootPos = rootPart.Position

    local rightHand = victimChar:FindFirstChild("RightHand") or victimChar:FindFirstChild("Right Arm")
    local leftHand = victimChar:FindFirstChild("LeftHand") or victimChar:FindFirstChild("Left Arm")
    local rightPos = (rightHand and rightHand:IsA("BasePart")) and rightHand.Position or (rootPos + Vector3.new(2,0,0))
    local leftPos = (leftHand and leftHand:IsA("BasePart")) and leftHand.Position or (rootPos + Vector3.new(-2,0,0))

    local victimName = player.Name

    chatSystem("freeze " .. victimName)
    chatSystem("blind " .. victimName)
    chatSystem("size " .. victimName .. " nan")
    chatSystem("smoke " .. victimName)
    chatSystem("flashify " .. victimName)
    chatSystem("freeze me")

    for i = 1, 8 do chatSystem("sword me"); task.wait(0.05) end
    task.wait(0.3)

    local swords = {}
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    local function collect(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and (string.find(tool.Name, "Sword") or string.find(tool.Name, "LinkedSword")) then
                table.insert(swords, tool)
            end
        end
    end
    collect(char)
    collect(backpack)
    for _, tool in ipairs(workspace:GetChildren()) do
        if tool:IsA("Tool") and (string.find(tool.Name, "Sword") or string.find(tool.Name, "LinkedSword")) then
            if not table.find(swords, tool) then table.insert(swords, tool) end
        end
    end

    if #swords == 0 then
        notifyError("No swords found")
        chatSystem("thaw me")
        return
    end

    local posList = {}
    for i = 1, math.min(2, #swords) do
        table.insert(posList, rightPos + Vector3.new(0, (i==1 and 1 or -1), 0))
    end
    for i = 1, math.min(2, math.max(0, #swords - #posList)) do
        table.insert(posList, leftPos + Vector3.new(0, (i==1 and 1 or -1), 0))
    end
    local remaining = #swords - #posList
    local offsets = {Vector3.new(2,0,0), Vector3.new(-2,0,0), Vector3.new(0,2,0), Vector3.new(0,-2,0)}
    for i = 1, math.min(remaining, #offsets) do
        table.insert(posList, rootPos + offsets[i])
    end
    for i = #posList + 1, #swords do
        local angle = (i - #posList) * 2.1
        table.insert(posList, rootPos + Vector3.new(3*math.cos(angle), 1, 3*math.sin(angle)))
    end

    for i, sword in ipairs(swords) do
        if sword and sword:IsA("Tool") then
            if sword.Parent == backpack then pcall(function() sword.Parent = char end) end
            pcall(function() sword.Parent = workspace end)
            local handle = sword:FindFirstChild("Handle") or sword
            if handle and handle:IsA("BasePart") then
                local pos = posList[i] or rootPos + Vector3.new(0, 2*i, 0)
                local moveArgs = {
                    "SyncMove",
                    {
                        {Part = handle, CFrame = CFrame.new(pos)},
                        {Pivot = CFrame.new(pos), Model = sword}
                    }
                }
                pcall(function() endpoint:InvokeServer(unpack(moveArgs)) end)
            end
            task.wait(0.05)
        end
    end

    chatSystem("thaw me")
    stats.playersKicked = stats.playersKicked + 1
    chatSystem("name " .. victimName .. " [CRASHED]")
    notify("Crash", "Crashed " .. victimName .. " with " .. #swords .. " swords", 4)
    task.wait(1)
    chatSystem("ungear " .. victimName)
    chatSystem("crash " .. victimName)
end

local bannedPlayers = {}
local function banPlayer(player)
    if not player then return end
    if bannedPlayers[player.UserId] then
        notify("Ban", player.Name .. " already banned", 3)
        return
    end
    bannedPlayers[player.UserId] = {name = player.Name, displayName = player.DisplayName}
    crashPlayer(player)
    notify("Ban", "Banned " .. player.Name, 3)
end

local function unbanPlayer(userIdOrName)
    local userId = tonumber(userIdOrName)
    if userId and bannedPlayers[userId] then
        bannedPlayers[userId] = nil
        notify("Unban", "Unbanned ID " .. userId, 3)
        return true
    else
        for uid, info in pairs(bannedPlayers) do
            if string.lower(info.name) == string.lower(userIdOrName) or string.lower(info.displayName) == string.lower(userIdOrName) then
                bannedPlayers[uid] = nil
                notify("Unban", "Unbanned " .. info.name, 3)
                return true
            end
        end
        notify("Unban", "No ban found", 3)
        return false
    end
end

