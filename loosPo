local function isPlatformWhitelisted(obj)
    if Variables.SKickFolder and obj:IsDescendantOf(Variables.SKickFolder) then return true end
    do
        local hit = false
        pcall(function()
            for _, f in ipairs(Variables.SKSetups) do
                if f and f.Parent and obj:IsDescendantOf(f) then hit = true break end
            end
        end)
        if hit then return true end
    end
    local a = obj:FindFirstAncestorOfClass("Model")
    if a then
        local plr = Players:GetPlayerFromCharacter(a)
        if plr and plr ~= LocalPlayer then return true end
    end
    local bp = obj:FindFirstAncestorOfClass("Backpack")
    if bp then
        local plr = bp:FindFirstAncestorOfClass("Player")
        if plr and plr ~= LocalPlayer then return true end
    end
    local wlNames = {}
    pcall(function()
        for plrName, _ in pairs(WhitelistedSKS) do table.insert(wlNames, plrName) end
    end)
    for _, plrName in ipairs(wlNames) do
        local p = Players:FindFirstChild(plrName)
        if p then
            if p:FindFirstChild("Backpack") and obj:IsDescendantOf(p.Backpack) then return true end
            if p.Character and obj:IsDescendantOf(p.Character) then return true end
        end
    end
    return false
end
