-- === NOTIFICATION WRAPPER using window:Notify ===
local function notify(title, content, duration)
    duration = duration or 5
    pcall(function()
        window:Notify({
            Title = title,
            Content = content,
            Duration = duration,
        })
    end)
end

local function notifyError(msg)
    notify("Error", msg, 5)
end

-- === TOAST for join/leave ===
local function toastJoin(player)
    pcall(function()
        window:Toast({
            title = player.DisplayName,
            subtitle = player.Name .. " (" .. player.UserId .. ")",
            avatar = player.UserId,  -- uses player's avatar thumbnail
        })
    end)
end

local function toastLeave(player)
    pcall(function()
        window:Toast({
            title = player.DisplayName .. " left",
            subtitle = player.Name .. " (" .. player.UserId .. ")",
            avatar = player.UserId,
        })
    end)
end

-- Listen to join/leave
Players.PlayerAdded:Connect(toastJoin)
Players.PlayerRemoved:Connect(toastLeave)

