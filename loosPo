-- Protected names: our own constructions that must survive clear commands.
-- =====================================================================
local PROTECTED_NAMES = {skybox = true, AntiAbusePass = true}

local function isProtectedInstance(v)
    return PROTECTED_NAMES[v.Name] == true
end

local function clearByFilter(f, exc, ext, etb, ekf)
    local e = getEndpoint()
    if not e then return 0 end
    local tr = Workspace:FindFirstChild("Terrain")
    local tb = Workspace:FindFirstChild("Tabby")
    local ins = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if f(v) and not isProtectedInstance(v) then
            local s = false
            if exc then
                -- v3.3.6 (user: "make clrws also not delete any character
                -- models"): the check below only skipped things INSIDE a
                -- character model -- the character MODEL ITSELF passed the
                -- filter and got removed. Also skip the model itself.
                if v:IsA("Model") and Players:GetPlayerFromCharacter(v) then s = true end
                if not s then
                    local m = v:FindFirstAncestorOfClass("Model")
                    if m and Players:GetPlayerFromCharacter(m) then s = true end
                end
            end
            if not s and ext and tr and v:IsDescendantOf(tr) then s = true end
            if not s and etb and tb and v:IsDescendantOf(tb) then s = true end
            if not s and ekf and Variables.SKickFolder and v:IsDescendantOf(Variables.SKickFolder) then s = true end
            -- v3.3.6: our own gear survives every clear unconditionally
            if not s and Variables.PKS and v == Variables.PKS then s = true end
            if not s then
                pcall(function()
                    for _, sk in ipairs(Variables.SKSetups) do
                        if sk and sk.Parent and v:IsDescendantOf(sk) then s = true end
                    end
                end)
            end
            if not s then
                pcall(function()
                    for _, pk in ipairs(Variables.PKSetups) do
                        if pk and pk.Parent and v:IsDescendantOf(pk) then s = true end
                    end
                end)
            end
            if not s and Variables.AKBFolder and v:IsDescendantOf(Variables.AKBFolder) then s = true end
            if not s then table.insert(ins, v) end
        end
    end
    if #ins == 0 then return 0 end
    for i = 1, #ins, CFG.BATCH_SIZE do
        local b = {}
        for j = i, math.min(i + CFG.BATCH_SIZE - 1, #ins) do table.insert(b, ins[j]) end
        pcall(function() e:InvokeServer("Remove", b) end)
        task.wait(0.01)
    end
    return #ins
end

local function getFilteredParts()
    local tr = Workspace:FindFirstChild("Terrain")
    local tb = Workspace:FindFirstChild("Tabby")
    local ps = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and CFG.VALID_PART_NAMES[v.Name] and not isProtectedInstance(v) then
            local s = false
            local m = v:FindFirstAncestorOfClass("Model")
            if m and Players:GetPlayerFromCharacter(m) then s = true end
            if not s and tr and v:IsDescendantOf(tr) then s = true end
            if not s and tb and v:IsDescendantOf(tb) then s = true end
            if not s and Variables.SKickFolder and v:IsDescendantOf(Variables.SKickFolder) then s = true end
            -- v3.3.6: multi-setup + shield exclusions
            if not s then
                pcall(function()
                    for _, sk in ipairs(Variables.SKSetups) do
                        if sk and sk.Parent and v:IsDescendantOf(sk) then s = true end
                    end
                end)
            end
            if not s and Variables.AKBFolder and v:IsDescendantOf(Variables.AKBFolder) then s = true end
            if not s then table.insert(ps, v) end
        end
    end
    return ps
end

local function syncParts(ps, ua, nc)
    local e = getEndpoint()
    if not e then return end
    local b = {}
    for _, v in ipairs(ps) do
        local en = {Part = v}
        if ua then
            en.CFrame = v.CFrame
            en.Anchored = false
        end
        if nc then en.CanCollide = false end
        table.insert(b, en)
        if #b == CFG.BATCH_SIZE then
            if ua then pcall(function() e:InvokeServer("SyncAnchor", b) end) end
            if nc then pcall(function() e:InvokeServer("SyncCollision", b) end) end
            b = {}
            task.wait(0.01)
        end
    end
    if #b > 0 then
        if ua then pcall(function() e:InvokeServer("SyncAnchor", b) end) end
        if nc then pcall(function() e:InvokeServer("SyncCollision", b) end) end
    end
end

