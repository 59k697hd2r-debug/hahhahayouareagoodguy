                    addGbanTarget(target)
                else
                    chatSystem("Player not found.")
                end
            else
                chatSystem("Usage: .gban <partial name>")
            end
            return nil
        elseif cmd == ".gameinfo" then
            task.spawn(gameInfo)
            return nil
        elseif cmd == ".serverinfo" then
            task.spawn(serverInfo)
            return nil
        elseif cmd == ".porta" then
            if parts[2] then
                task.spawn(function()
                    porta(parts[2])
                end)
            else
                chatSystem("Usage: .porta <partial name>")
            end
            return nil
        end -- end of if cmd == ... block
    end -- end of if self == ChatEvent ...
    return old and old(self, ...)
end) -- end of hookmetamethod

