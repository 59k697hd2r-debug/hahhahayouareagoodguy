Handler:AddCommand("getinfo", {Args = {"*Player*"}, Aliases = {"info", "pinfo"}, Description = "Get detailed player info"}, function(Arguments)
    local t = getPlayerFromPartial(Arguments[1] or "")
    if not t then notify("Error", "Player not found", 3) return end
    local info = "Name: " .. t.Name .. "\nDisplay: " .. t.DisplayName .. "\nUserID: " .. t.UserId .. "\nAccount Age: " .. t.AccountAge .. " days"
    local char = t.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            info = info .. "\nHealth: " .. math.floor(hum.Health) .. "/" .. hum.MaxHealth
            info = info .. "\nWalkSpeed: " .. hum.WalkSpeed
            info = info .. "\nJumpPower: " .. hum.JumpPower
            info = info .. "\nRig: " .. (hum.RigType and hum.RigType.Name or "Unknown")
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            info = info .. "\nPosition: " .. string.format("%.1f, %.1f, %.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
            local myHrp = getHRP()
            if myHrp then
                info = info .. "\nDistance: " .. string.format("%.1f studs", (hrp.Position - myHrp.Position).Magnitude)
            end
        end
        local tools = {}
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") then table.insert(tools, c.Name) end
        end
        local bp = t:FindFirstChild("Backpack")
        if bp then
            for _, c in ipairs(bp:GetChildren()) do
                if c:IsA("Tool") then table.insert(tools, c.Name .. " (BP)") end
            end
        end
        info = info .. "\nTools: " .. (#tools > 0 and table.concat(tools, ", ") or "None")
    else
        info = info .. "\nCharacter: None"
    end
    local s, isFriend = pcall(function() return t:IsFriendsWith(LocalPlayer.UserId) end)
    if s then info = info .. "\nFriend: " .. (isFriend and "Yes" or "No") end
    info = info .. "\nPing: " .. string.format("%.0fms", t:GetNetworkPing() * 1000)
    notify("Player Info - " .. t.DisplayName, info, 12)
    print("=== Player Info: " .. t.Name .. " ===\n" .. info)
end)

