local function startKillbrickImmunity()
    if killbrickImmunityActive then return end
    killbrickImmunityActive = true
    killbrickLoopThread = task.spawn(function()
        while killbrickImmunityActive and monitorLoopActive do
            pcall(function()
                local tabby = Workspace:FindFirstChild("Tabby")
                if tabby then
                    local ah = tabby:FindFirstChild("Admin_House")
                    if ah then
                        local obby = ah:FindFirstChild("Obby")
                        if obby then
                            for _, c in ipairs(obby:GetChildren()) do
                                if c:IsA("BasePart") and c.CanTouch then c.CanTouch = false end
                            end
                        end
                    end
                end
            end)
            task.wait(0.02)
        end
    end)
end

local function stopKillbrickImmunity()
    killbrickImmunityActive = false
    if killbrickLoopThread then task.cancel(killbrickLoopThread) killbrickLoopThread = nil end
end

