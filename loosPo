    local function containerBox(object)
        local parts = {}
        if object:IsA("BasePart") then table.insert(parts, object) end
        for _, d in ipairs(object:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(parts, d) end
        end
        if #parts == 0 then return CFrame.new(), Vector3.new(4, 1, 2) end
        local minX, minY, minZ = math.huge, math.huge, math.huge
        local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
        for _, p in ipairs(parts) do
            local cf, half = p.CFrame, p.Size / 2
            local corners = {
                cf * Vector3.new(-half.X, -half.Y, -half.Z),
                cf * Vector3.new(half.X, -half.Y, -half.Z),
                cf * Vector3.new(-half.X, half.Y, -half.Z),
                cf * Vector3.new(half.X, half.Y, -half.Z),
                cf * Vector3.new(-half.X, -half.Y, half.Z),
                cf * Vector3.new(half.X, -half.Y, half.Z),
                cf * Vector3.new(-half.X, half.Y, half.Z),
                cf * Vector3.new(half.X, half.Y, half.Z),
            }
            for _, c in ipairs(corners) do
                minX = math.min(minX, c.X)
                minY = math.min(minY, c.Y)
                minZ = math.min(minZ, c.Z)
                maxX = math.max(maxX, c.X)
                maxY = math.max(maxY, c.Y)
                maxZ = math.max(maxZ, c.Z)
            end
        end
        local center = Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)
        return CFrame.new(center), Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
    end
    local function mapPartType(part)
        if part:IsA("SpawnLocation") then return "Spawn" end
        if part:IsA("VehicleSeat") then return "Vehicle Seat" end
        if part:IsA("Seat") then return "Seat" end
        if part:IsA("WedgePart") then return "Wedge" end
        if part:IsA("CornerWedgePart") then return "Corner" end
        if part:IsA("TrussPart") then return "Truss" end
        if part:IsA("Part") then
            if part.Shape == Enum.PartType.Ball then return "Ball" end
            if part.Shape == Enum.PartType.Cylinder then return "Cylinder" end
        end
        return "Normal"
    end
    local meshAuthCache = {}
    local function authoredMeshSize(meshId)
        if not meshId or meshId == "" then return nil end
        local cached = meshAuthCache[meshId]
        if cached then return cached end
        local idNum = tostring(meshId):match("%d+")
        if not idNum then return nil end
        local obj = safeGetObjects(idNum)
        if not obj then return nil end
        local size = nil
        pcall(function()
            if obj:IsA("MeshPart") then
                size = obj.Size
            elseif obj:IsA("BasePart") then
                size = obj.Size
            else
                local mp = obj:FindFirstChildWhichIsA("MeshPart", true)
                    or obj:FindFirstChildWhichIsA("BasePart", true)
                if mp then size = mp.Size end
            end
        end)
        pcall(function() obj:Destroy() end)
        if size and size.X > 0.001 and size.Y > 0.001 and size.Z > 0.001 then
            meshAuthCache[meshId] = size
            return size
        end
        return nil
    end
    local function meshProps(part, createdPart)
        local createMeshEntry = nil
        local syncMeshEntry = nil
        if part:IsA("MeshPart") then
            createMeshEntry = { Part = createdPart }
            local scale = Vector3.new(1, 1, 1)
            local msOk, ms = pcall(function() return part.MeshSize end)
            if msOk and ms and ms.X > 0.001 and ms.Y > 0.001 and ms.Z > 0.001 then
                scale = part.Size / ms
            else
                local midOk, mid = pcall(function() return part.MeshId end)
                local authored = midOk and authoredMeshSize(mid) or nil
                if authored then
                    scale = part.Size / authored
                end
            end
            local tex = ""
            pcall(function() tex = part.TextureID or "" end)
            syncMeshEntry = {
                Part = createdPart,
                MeshType = Enum.MeshType.FileMesh,
                MeshId = part.MeshId,
                TextureId = tex,
                Scale = scale,
                Offset = Vector3.new(0, 0, 0),
                VertexColor = Vector3.new(1, 1, 1),
            }
        else
            local specialMesh = part:FindFirstChildWhichIsA("SpecialMesh")
            if specialMesh then
                createMeshEntry = { Part = createdPart }
                syncMeshEntry = {
                    Part = createdPart,
                    MeshType = specialMesh.MeshType,
                    MeshId = specialMesh.MeshId,
                    TextureId = specialMesh.TextureId,
                    Scale = specialMesh.Scale,
                    Offset = specialMesh.Offset,
                    VertexColor = specialMesh.VertexColor,
                }
            end
        end
        return createMeshEntry, syncMeshEntry
    end
    local function frontPosition()
        local ch = LocalPlayer.Character
        local hrp = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
        if not hrp then
            local cam = Workspace.CurrentCamera
            if cam then return cam.CFrame.Position + cam.CFrame.LookVector * 20 end
            return Vector3.new(0, 10, 0)
        end
        local ahead = hrp.CFrame.Position + hrp.CFrame.LookVector * 18
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        if ch then params.FilterDescendantsInstances = { ch } end
        local hit = Workspace:Raycast(ahead + Vector3.new(0, 60, 0), Vector3.new(0, -400, 0), params)
        local y = hit and hit.Position.Y or hrp.Position.Y
        return Vector3.new(ahead.X, y, ahead.Z)
    end
