    local function measurePingFps(plr)
        local ping, fps = "unknown", "unknown"
        if not plr then return ping, fps end
        pcall(function()
            local secs = plr:GetNetworkPing()
            if type(secs) == "number" and secs >= 0 then
                ping = string.format("%d ms", math.floor(secs * 1000 + 0.5))
            end
        end)
        if plr == LocalPlayer then
            local frames, t0 = 0, os.clock()
            pcall(function()
                while os.clock() - t0 < 0.6 do
                    RunService.RenderStepped:Wait()
                    frames = frames + 1
                end
            end)
            local dt = os.clock() - t0
            if frames > 0 and dt > 0 then
                fps = tostring(math.floor(frames / dt + 0.5))
            end
        else
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then
                local last, changes, t0 = hrp.Position, 0, os.clock()
                pcall(function()
                    while os.clock() - t0 < 0.6 do
                        RunService.Heartbeat:Wait()
                        if not hrp.Parent then break end
                        if (hrp.Position - last).Magnitude > 0.05 then
                            changes = changes + 1
                            last = hrp.Position
                        end
                    end
                end)
                local dt = os.clock() - t0
                if dt > 0 then
                    fps = tostring(math.floor(changes / dt + 0.5))
                end
            end
        end
        return ping, fps
    end
