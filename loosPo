-- ---------------------------------------------------------------------
-- Keybinds (fix #15, v3.2) -- DIRECT syntax first:
--     .bind <Key> <anything>
-- The bound value runs through the SAME router as typed text
-- (processText): chat commands, silent commands, >. Lua, plain chat.
-- Every chat command is therefore bindable. The old capture flow
-- ("keybind add <text>" then press a key) still works.
-- ---------------------------------------------------------------------
local function resolveKeyName(input)
    local s = tostring(input or "")
    if s == "" then return nil end
    local ok, key = pcall(function() return Enum.KeyCode[s] end)
    if ok and key then return key.Name end
    local cap = string.upper(string.sub(s, 1, 1)) .. string.lower(string.sub(s, 2))
    local ok2, key2 = pcall(function() return Enum.KeyCode[cap] end)
    if ok2 and key2 then return key2.Name end
    return nil
end

local function bindKeyToText(keyName, text)
    KeyBinds[keyName] = text
    notify("Keybind", "Bound \"" .. keyName .. "\" -> \"" .. text .. "\"", 5)
    print("[KAHX] Bind: " .. keyName .. " -> " .. text)
end

Handler:AddCommand("bind", {Args = {"*Key*", "*Text/Command*"}, Aliases = {}, Description = "DIRECT bind: .bind F .fly (command, ..silent, >.lua or plain text)"}, function(A, F)
    local keyName = resolveKeyName(A[1])
    if not keyName then
        notify("Keybind", "Unknown key \"" .. tostring(A[1]) .. "\"", 3)
        return
    end
    local rest = string.sub(F, string.len(A[1] or "") + 2)
    if rest == "" then
        notify("Keybind", "Nothing to bind: .bind <Key> <text/command>", 3)
        return
    end
    bindKeyToText(keyName, rest)
end)

Handler:AddCommand("unbind", {Args = {"*Key*"}, Aliases = {"unkeybind"}, Description = "Removes a keybind: .unbind F"}, function(A, F)
    local keyName = resolveKeyName(A[1])
