    if not t then notify("Error", "Player not found", 3) return end
    local info = "Name: " .. t.Name .. "\nDisplay: " .. t.DisplayName .. "\nUserID: " .. t.UserId .. "\nAccount Age: " .. t.AccountAge .. " days"
