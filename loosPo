-- ===== PLAYER RESOLUTION =====
local function resolvePlayerInput(input, callback, includeSelf)
    if not input or input == "" then callback({}) return end
    local players = {}
    if input == "random" then
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if includeSelf or p ~= LocalPlayer then table.insert(list, p) end
        end
        if #list > 0 then table.insert(players, list[math.random(1, #list)]) end
    elseif input == "all" then
        for _, p in ipairs(Players:GetPlayers()) do
            if includeSelf or p ~= LocalPlayer then table.insert(players, p) end
        end
    elseif input == "friends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, isFriend = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if s and isFriend then table.insert(players, p) end
            end
        end
    elseif input == "nonfriends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, isFriend = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if not (s and isFriend) then table.insert(players, p) end
            end
        end
    else
        local found = getPlayerFromPartial(input)
        if found then table.insert(players, found) end
    end
    if #players == 0 then notify("Player not found", "No player(s) matched", 3) else callback(players) end
end

local function resolveAllWithFriends(input, callback, includeSelf)
    if string.lower(input) ~= "all" then
        resolvePlayerInput(input, callback, includeSelf)
        return
    end
    local friends = getFriendsInServer()
    if #friends > 0 then
        local names = {}
        for _, f in ipairs(friends) do table.insert(names, f.DisplayName) end
        createPopup("Include Friends?", "You have " .. #friends .. " friend(s): " .. table.concat(names, ", ") .. "\nInclude them?",
            function() resolvePlayerInput("all", callback, includeSelf) end,
            function()
                local players = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if (includeSelf or p ~= LocalPlayer) then
                        local s, isFriend = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                        if not (s and isFriend) then table.insert(players, p) end
                    end
                end
                callback(players)
            end, "Include", "Exclude")
    else
        resolvePlayerInput("all", callback, includeSelf)
    end
end

-- ===== F3X (Auto Give) =====
local lastF3XTime = 0
local function hasF3X()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild("Building Tools") then return true end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Building Tools") then return true end
    return false
end

local function ensureF3X()
    if not hasF3X() then
        local now = tick()
        if (now - lastF3XTime) >= 0.5 then
            chatSystem("startergive self")
            lastF3XTime = now
        end
    end
end

local function getSyncAPI()
    local tool = nil
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then tool = bp:FindFirstChild("Building Tools") end
    if not tool then
        local char = LocalPlayer.Character
        if char then tool = char:FindFirstChild("Building Tools") end
    end
    if not tool then return nil end
    local syncAPI = tool:FindFirstChild("SyncAPI")
    if not syncAPI then return nil end
    return syncAPI:FindFirstChild("ServerEndpoint")
end

local function f3x(args)
    local endpoint = getSyncAPI()
    if not endpoint then
        ensureF3X()
        local waited = 0
        while not endpoint and waited < 3 do
            task.wait(0.1)
            waited = waited + 0.1
            endpoint = getSyncAPI()
        end
    end
    if not endpoint then return nil end
    local s, r = pcall(function() return endpoint:InvokeServer(table.unpack(args)) end)
    return s and r or nil
end

local function deleteInstances(instances)
    if type(instances) ~= "table" then instances = {instances} end
    if #instances == 0 then return 0 end
    local endpoint = getSyncAPI()
    if not endpoint then
        ensureF3X()
        endpoint = getSyncAPI()
    end
    if not endpoint then return 0 end
    local valid = {}
    for _, v in ipairs(instances) do
        if v and v:IsA("Instance") then table.insert(valid, v) end
    end
    if #valid == 0 then return 0 end
    local total = 0
    for i = 1, #valid, 5000 do
        local batch = {}
        for j = i, math.min(i + 4999, #valid) do table.insert(batch, valid[j]) end
        if pcall(function() endpoint:InvokeServer("Remove", batch) end) then total = total + #batch end
        task.wait(0.01)
    end
    return total
end

