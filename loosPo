local function resolvePlayerInput(input, cb, incSelf)
    if not input or input == "" then cb({}) return end
    local ps = {}
    if input == "random" then
        local l = {}
        for _, p in ipairs(Players:GetPlayers()) do if incSelf or p ~= LocalPlayer then table.insert(l, p) end end
        if #l > 0 then table.insert(ps, l[math.random(1, #l)]) end
    elseif input == "all" then
        for _, p in ipairs(Players:GetPlayers()) do if incSelf or p ~= LocalPlayer then table.insert(ps, p) end end
    elseif input == "friends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if s and f then table.insert(ps, p) end
            end
        end
    elseif input == "nonfriends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local s, f = pcall(function() return p:IsFriendsWith(LocalPlayer.UserId) end)
                if not (s and f) then table.insert(ps, p) end
            end
        end
    else
        local f = getPlayerFromPartial(input)
        if f then table.insert(ps, f) end
    end
    if #ps == 0 then notify("Player not found", "No match", 3) else cb(ps) end
end

local function resolveAllWithFriends(input, cb, incSelf)
    if string.lower(input) ~= "all" then resolvePlayerInput(input, cb, incSelf) return end
    resolvePlayerInput("all", cb, incSelf)
end

