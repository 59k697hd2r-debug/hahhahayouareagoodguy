local function processCommand(msg)
    local lowerMsg = string.lower(msg)
    local parts = string.split(lowerMsg, " ")
    local cmd = parts[1]
    local playerArg = parts[2]
    if not cmd or cmd == "" then return end
    if Handler.Commands[cmd] then
        local command = Handler.Commands[cmd]
        local arguments = {}
        if command.config.Args and #command.config.Args > 0 then
            table.insert(arguments, playerArg or "")
            if command.config.Args[2] then
                table.insert(arguments, parts[3] or "")
            end
        end
        task.spawn(function()
            pcall(function() command.callback(arguments, lowerMsg) end)
        end)
    end
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if chatCmdsEnabled and self == ChatEvent and getnamecallmethod() == "FireServer" and typeof(({...})[1]) == "string" then
        local msg = ({...})[1]
        local isSilent = false
        local cmdStr = ""
        
        if string.sub(msg, 1, #silentPrefix) == silentPrefix then
            isSilent = true
            cmdStr = string.sub(msg, #silentPrefix + 1)
        elseif string.sub(msg, 1, #commandPrefix) == commandPrefix then
            cmdStr = string.sub(msg, #commandPrefix + 1)
        else
            return oldNamecall(self, ...)
        end
        
        processCommand(cmdStr)
        
        if isSilent or silentCommands then
            return nil
        end
        return oldNamecall(self, ...)
    end
    return oldNamecall(self, ...)
end)

pcall(function()
    TextChatService.SendingMessage:Connect(function(message)
        if not chatCmdsEnabled then return end
        local msg = message.Text
        if not msg then return end
        local isSilent = false
        local cmdStr = ""
        
        if string.sub(msg, 1, #silentPrefix) == silentPrefix then
            isSilent = true
            cmdStr = string.sub(msg, #silentPrefix + 1)
        elseif string.sub(msg, 1, #commandPrefix) == commandPrefix then
            cmdStr = string.sub(msg, #commandPrefix + 1)
        else
            return
        end
        
        processCommand(cmdStr)
        
        if isSilent or silentCommands then
            message.Text = ""
        end
    end)
end)

-- ===== DEATH PROTECTION =====
local wasAlive = true
local debounce = false
task.spawn(function()
    while monitorLoopActive do
        local char = LocalPlayer.Character
        local isDead, isPunished = false, false
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then isDead = true end
            if char.Parent == Lighting then isPunished = true end
        end
        local isAlive = (char ~= nil and char.Parent == Workspace and not isDead and not isPunished)
        if wasAlive and not isAlive then
            local now = tick()
            if not debounce and not suppressRe and (now - lastReTime > 1) then
                debounce = true
                lastReTime = now
                chatSystem("re")
                task.wait(0.3)
                debounce = false
            end
        end
        wasAlive = isAlive
        task.wait(0.03)
    end
end)

