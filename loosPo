local function catSpam(targetName, amount)
    amount = math.clamp(tonumber(amount) or 25, 1, CFG.CAT_SPAM_MAX)
    local target = getPlayerFromPartial(targetName)
    if not target then
        notify("Cat Spam", "Target not found", 3)
        return
    end
    if target == LocalPlayer and not S.allowSelfTarget then
        notify("Cat Spam", "Enable Allow Self-Targeting in Settings to hit yourself", 4)
        return
    end
    task.spawn(function()
        local pets = findPets()
        if #pets == 0 then
            notify("Cat Spam", "Gearing Mr. Whiskers + F3X...", 5)
            chatSystem("f3x me")
            chatSystem("gear me " .. CFG.MW_GEAR_ID)
            local tool, w = nil, 0
            while not tool and w < 8 do
                local bp = LocalPlayer:FindFirstChild("Backpack")
                if bp then
                    for _, t in ipairs(bp:GetChildren()) do
                        if t:IsA("Tool") and t.Name ~= "Building Tools" then
                            tool = t
                            break
                        end
                    end
                end
                if not tool and LocalPlayer.Character then
                    for _, t in ipairs(LocalPlayer.Character:GetChildren()) do
                        if t:IsA("Tool") and t.Name ~= "Building Tools" then
                            tool = t
                            break
                        end
                    end
                end
                if not tool then task.wait(0.25) w = w + 0.25 end
            end
            if not tool then
                notify("Cat Spam", "Failed to get Mr. Whiskers tool (need admin)", 5)
                return
            end
            if LocalPlayer.Character and tool.Parent ~= LocalPlayer.Character then
                tool.Parent = LocalPlayer.Character
            end
            notify("Cat Spam", "Equipped. Waiting for cat...", 4)
            pets = findPets()
            w = 0
            while #pets == 0 and w < 10 do
                task.wait(0.5)
                w = w + 0.5
                pets = findPets()
            end
            if #pets == 0 then
                notify("Cat Spam", "No cat detected after equip", 5)
                return
            end
        end
        local source = pets[1]
        if not target.Parent or not target.Character then
            notify("Cat Spam", "Target has no character", 3)
            return
        end
        notify("Cat Spam", "Spamming " .. amount .. " cats into " .. target.DisplayName, 5)
        local t0 = os.clock()
        local spawned = 0
        for i = 1, amount do
            if not target.Parent or not target.Character then break end
            local res = f3x({"Clone", {source}, target.Character})
            if res then
                if type(res) == "table" then res = res[1] end
                if res then
                    table.insert(S.catCloneRefs, res)
                    spawned = spawned + 1
                end
            end
            if i % 5 == 0 then task.wait(0.1) end
        end
        local ms = math.floor((os.clock() - t0) * 1000)
        stats.catsSpawned = stats.catsSpawned + spawned
        notify("Cat Spam", spawned .. " cats in " .. ms .. "ms", 5)
        print("[KAHX] Cat spam: " .. spawned .. "/" .. amount .. " in " .. ms .. "ms -> " .. target.DisplayName)
    end)
end
