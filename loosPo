local function gameInfo()
    local infoText = ""
    local success, info = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)
    if success and info then
        local placeName = info.Name or "Unknown"
        local creatorName = info.Creator and info.Creator.Name or "Unknown"
        local creatorType = info.Creator and info.Creator.CreatorType or "Unknown"
        infoText = "Place: " .. placeName .. "\nCreator: " .. creatorName .. " (" .. tostring(creatorType) .. ")"
    else
        infoText = "Could not fetch product info."
        local creatorId = game.CreatorId
        if creatorId and creatorId ~= 0 then
            local creatorType = game.CreatorType
            local creatorName = ""
            if creatorType == Enum.CreatorType.User then
                local success2, name = pcall(function()
                    return Players:GetNameFromUserIdAsync(creatorId)
                end)
                if success2 then creatorName = name end
            elseif creatorType == Enum.CreatorType.Group then
