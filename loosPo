    -- ---------------------------------------------------------------
    -- command registry snapshot (canonical names + alias map)
    -- built once; the predictor, fuzzy matcher and cmdlist all use it
    -- ---------------------------------------------------------------
    local cmdNames, aliasMap = {}, {}
    do
        local seenCfg = {}
        for _, e in ipairs(Handler.Order) do
            if not seenCfg[e.config] then
                seenCfg[e.config] = true
                table.insert(cmdNames, {name = e.name, config = e.config})
            end
        end
        table.sort(cmdNames, function(a, b) return a.name < b.name end)
        for _, e in ipairs(cmdNames) do
            local als = e.config.Aliases or {}
            for _, a in ipairs(als) do aliasMap[string.lower(a)] = e.name end
        end
    end

    -- ---------------------------------------------------------------
    -- Levenshtein distance (short strings only; classic 2-row DP)
    -- ---------------------------------------------------------------
    local function levenshtein(a, b)
        local la, lb = #a, #b
        if la == 0 then return lb end
        if lb == 0 then return la end
        local prev, curr = {}, {}
        for j = 0, lb do prev[j] = j end
        for i = 1, la do
            curr[0] = i
            local ca = string.byte(a, i)
            for j = 1, lb do
                local cost = (ca == string.byte(b, j)) and 0 or 1
                local v = prev[j] + 1
                local v2 = curr[j - 1] + 1
                if v2 < v then v = v2 end
                local v3 = prev[j - 1] + cost
                if v3 < v then v = v3 end
                curr[j] = v
            end
            local tmp = prev
            prev = curr
            curr = tmp
        end
        return prev[lb]
    end

    -- fuzzy scoring: distance, minus a bonus for prefix / substring
    local function scoreMatch(bad, cand)
        local d = levenshtein(bad, cand)
        if string.sub(cand, 1, #bad) == bad then d = d - 1.5 end
        if string.find(cand, bad, 1, true) then d = d - 1 end
        return d
    end

    -- did-you-mean: the single best candidate above the threshold
    local function findBestMatch(bad)
        bad = string.lower(bad)
        if bad == "" then return nil end
        local pool = {}
        for _, e in ipairs(cmdNames) do table.insert(pool, e.name) end
        for a, _ in pairs(aliasMap) do table.insert(pool, a) end
        local best, bestScore = nil, math.huge
        for _, cand in ipairs(pool) do
            local d = scoreMatch(bad, cand)
            if d < bestScore then
                bestScore = d
                best = cand
            end
        end
        local threshold = math.max(2, math.floor(#bad / 3))
        if best and bestScore <= threshold and bestScore < #bad then
            return aliasMap[best] or best
        end
        return nil
    end

    -- v3.3.5 "SIMILARITIES" (user request): ranked list of the commands
    -- closest to what was typed. Used by the did-you-mean popup, the
    -- cmdlist detail panel and the search fallback. Looser than the
    -- did-you-mean threshold -- this is a display aid, not an auto-run.
    local function findSimilar(bad, max)
        bad = string.lower(bad)
        if bad == "" then return {} end
        max = max or 3
        local pool = {}
        for _, e in ipairs(cmdNames) do table.insert(pool, e.name) end
        for a, _ in pairs(aliasMap) do table.insert(pool, a) end
        local scored = {}
        for _, cand in ipairs(pool) do
            if cand ~= bad then
                table.insert(scored, {name = aliasMap[cand] or cand, d = scoreMatch(bad, cand)})
            end
        end
        table.sort(scored, function(x, y) return x.d < y.d end)
        local out, seen = {}, {}
        local cut = math.max(3, math.floor(#bad / 2) + 2)
        for _, s in ipairs(scored) do
            if not seen[s.name] and s.d <= cut then
                seen[s.name] = true
                table.insert(out, s.name)
                if #out >= max then break end
            end
        end
        return out
    end

    -----------------------------------------------------------------
    -- MILESTONE 1: the two ScreenGuis (v3.3.7 POPULATE-THEN-PARENT):
