local executorName    = "Unknown"

-- ── executor capability test ────────────────────────────
local function runExecutorTest()
    -- get executor name
    pcall(function()
        if identifyexecutor then
            local name, version = identifyexecutor()
            if name and #name > 0 then
                executorName = name
                if version and #version > 0 then
                    executorName = name .. " v" .. tostring(version)
                end
            end
        end
    end)

    -- test 1: file saving (writefile + isfile + readfile + delfile)
    local testFile   = "bcv_capability_test.txt"
    local testLetter = "x"
    local saveOK     = false

    pcall(function()
        writefile(testFile, testLetter)
    end)

    local exists = false
    pcall(function()
        exists = isfile and isfile(testFile)
    end)

    if exists then
        local content = nil
        pcall(function()
            content = readfile(testFile)
        end)
        if content == testLetter then
            saveOK = true
        end
        -- cleanup: delete the test file
        pcall(function()
            if delfile then delfile(testFile) end
        end)
        -- if delfile isn't available, overwrite to empty then try again
        if saveOK then
            pcall(function()
                if isfile and isfile(testFile) and delfile then
                    -- already deleted above, this is a double-check
                end
            end)
        end
    end

    capSaving = saveOK

    -- test 2: getscriptbytecode
    local bytecodeOK = false
    pcall(function()
        if getscriptbytecode and type(getscriptbytecode) == "function" then
            -- try it on a known script to confirm it actually works
            -- use a core script that should always exist
            local testScript = game:GetService("Players").LocalPlayer
                and game:FindService("CoreScripts")
            if testScript then
                local bc = getscriptbytecode(testScript)
                if bc then bytecodeOK = true end
            else
                -- function exists, that's enough for the capability flag
                bytecodeOK = true
            end
        end
    end)

    -- if the above pcall failed, try a simpler check
    if not bytecodeOK then
        pcall(function()
            if type(getscriptbytecode) == "function" then
                bytecodeOK = true
            end
        end)
    end

    capBytecode = bytecodeOK

    -- build status message
    local statusParts = {}
    local allPass = true

    if capSaving then
        table.insert(statusParts, '<font color="#5ab464">Saving ✓</font>')
    else
        table.insert(statusParts, '<font color="#c84646">Saving ✗</font>')
        allPass = false
    end

    if capBytecode then
        table.insert(statusParts, '<font color="#5ab464">Bytecode ✓</font>')
    else
        table.insert(statusParts, '<font color="#c84646">Bytecode ✗</font>')
        allPass = false
    end

    local line1 = "Executor: " .. executorName
    local line2 = table.concat(statusParts, "  |  ")

    if allPass then
        StatusBanner.Text = '<font color="#5ab464">'
            .. line1 .. ' — saving and bytecode getter supported</font>\n'
            .. line2
        StatusBanner.BackgroundColor3 = Color3.fromRGB(20, 32, 24)
        DisplayText.Text = '<font color="#7ec0a0">Executor ready. Enter a file path or script instance path above.</font>'
    else
        StatusBanner.Text = '<font color="#c8af46">'
            .. line1 .. ' — does not have full support</font>\n'
            .. line2
        StatusBanner.BackgroundColor3 = Color3.fromRGB(32, 28, 20)

        local warnings = {}
        if not capSaving then
            table.insert(warnings, '<font color="#c84646">File saving unavailable — Export will not work.</font>')
        end
        if not capBytecode then
            table.insert(warnings, '<font color="#c84646">getscriptbytecode unavailable — can only use file-based compilation.</font>')
        end
        DisplayText.Text = table.concat(warnings, "\n")
    end

    -- disable/enable buttons based on capabilities
    if not capSaving then
        ExportBtn.BackgroundColor3 = Color3.fromRGB(60, 55, 40)
        ExportBtn.Text = "Export (N/A)"
        ExportBtn.Active = false
    end
end

-- run the test
task.spawn(function()
    task.wait(0.1)
    runExecutorTest()
end)

-- ── dragging ─────────────────────────────────────────────
do
    local dragging, dragStart, startPos

    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = Window.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Window.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

