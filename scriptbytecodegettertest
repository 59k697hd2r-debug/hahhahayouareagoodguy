-- ── export ──────────────────────────────────────────────
ExportBtn.MouseButton1Click:Connect(function()
    if not capSaving then
        DisplayText.Text = '<font color="#ff6b6b">Export unavailable — executor does not support file saving.</font>'
        return
    end
    if not currentBytecode or #currentBytecode == 0 then
        DisplayText.Text = '<font color="#ff6b6b">Nothing to export.</font>'
        return
    end

    local baseFolder = "BytecodeExports"
    local timestamp  = os.date("%Y%m%d_%H%M%S")
    local safeName   = currentSource:gsub("[/\\:*?\"<>|]", "_")
        :gsub("^%s+", ""):gsub("%s+$", "")
    if #safeName == 0 then safeName = "untitled" end
    if #safeName > 40 then safeName = safeName:sub(1, 40) end

    local exportName = safeName .. "_" .. timestamp
    local exportPath = baseFolder .. "/" .. exportName

    pcall(function() makefolder(baseFolder) end)
    pcall(function() makefolder(exportPath) end)

    local hex = toHex(currentBytecode)
    local count = 0

    -- .txt
    local txt = "Bytecode Export\n"
    txt ..= "Source: " .. currentSource .. "\n"
    txt ..= "Executor: " .. executorName .. "\n"
    txt ..= "Exported: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n"
    txt ..= "Size: " .. #currentBytecode .. " bytes\n"
    txt ..= "\n" .. string.rep("=", 60) .. "\n\n"
    txt ..= hex .. "\n"
    pcall(function()
        writefile(exportPath .. "/" .. exportName .. ".txt", txt)
        count += 1
    end)

    -- .lua
    pcall(function()
        writefile(exportPath .. "/" .. exportName .. ".lua", currentBytecode)
        count += 1
    end)

    -- .luau
    pcall(function()
        writefile(exportPath .. "/" .. exportName .. ".luau", currentBytecode)
        count += 1
    end)

    if count > 0 then
        DisplayText.Text = '<font color="#7ec0a0">Exported ' .. count
            .. '/3 files to:</font>\n<font color="#c0c0ff">' .. exportPath
            .. '/</font>\n\n' .. exportName .. '.txt\n' .. exportName
            .. '.lua\n' .. exportName .. '.luau\n\n' .. hex
    else
        DisplayText.Text = '<font color="#ff6b6b">Export failed — could not write files.</font>\n\n' .. hex
    end
end)
