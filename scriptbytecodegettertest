-- ── helpers ─────────────────────────────────────────────

local function toHex(data)
    if not data or #data == 0 then return "" end
    local parts = table.create(#data)
    for i = 1, #data do
        parts[i] = string.format("%02X", string.byte(data, i))
    end
    local lines = {}
    for i = 1, #parts, 16 do
        local chunk = {}
        for j = i, math.min(i + 15, #parts) do
            chunk[#chunk + 1] = parts[j]
        end
        lines[#lines + 1] = string.format("%08X  %s", i - 1, table.concat(chunk, " "))
    end
    return table.concat(lines, "\n")
end

local function resolveInstance(path)
    local current = game
    for part in string.gmatch(path, "[^%.%/]+") do
        if not current then return nil end
        current = current:FindFirstChild(part)
    end
    return current
end

local function getBytecode(path)
    -- Method 1: file path
    local fileContent
    pcall(function() fileContent = readfile(path) end)

    if fileContent and #fileContent > 0 then
        local fn
        pcall(function() fn = loadstring(fileContent) end)
        if fn then
            local dump
            pcall(function() dump = string.dump(fn) end)
            if dump and #dump > 0 then
                return dump, "file (string.dump)"
            end
        end

        local compiled
        pcall(function()
            if luau and luau.compile then
                compiled = luau.compile(fileContent)
            elseif Luau and Luau.compile then
                compiled = Luau.compile(fileContent)
            end
        end)
        if compiled and #compiled > 0 then
            return compiled, "file (luau.compile)"
        end

        return nil, "Could not compile source — no bytecode compiler available"
    end

    -- Method 2: script instance path (only if getscriptbytecode is available)
    if capBytecode then
        local inst = resolveInstance(path)
        if inst then
            local bc
            pcall(function() bc = getscriptbytecode(inst) end)
            if bc and #bc > 0 then
                return bc, "instance (getscriptbytecode)"
            end
        end
    end

    return nil, "Could not read file or resolve script at: " .. tostring(path)
end

-- ── load ────────────────────────────────────────────────
local function doLoad()
    local path = PathBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if path == "" then
        DisplayText.Text = '<font color="#ff6b6b">Enter a file path or script path.</font>'
        return
    end

    DisplayText.Text = '<font color="#c0c0ff">Compiling bytecode...</font>'

    task.spawn(function()
        local bytecode, sourceType = getBytecode(path)

        if bytecode and #bytecode > 0 then
            currentBytecode = bytecode
            currentSource   = path
            local hex       = toHex(bytecode)
            local display   = hex
            if #hex > 50000 then
                display = hex:sub(1, 50000)
                    .. "\n\n... (" .. #bytecode .. " bytes total, display truncated)"
            end
            DisplayText.Text = '<font color="#7ec0a0">'
                .. #bytecode .. ' bytes | ' .. sourceType .. '</font>\n\n' .. display
        else
            currentBytecode = ""
            DisplayText.Text = '<font color="#ff6b6b">Error: '
                .. tostring(sourceType) .. '</font>'
        end
        Display.CanvasPosition = Vector2.new(0, 0)
    end)
end

LoadBtn.MouseButton1Click:Connect(doLoad)
PathBox.FocusLost:Connect(function(enter)
    if enter then doLoad() end
end)

-- ── copy ────────────────────────────────────────────────
CopyBtn.MouseButton1Click:Connect(function()
    if currentBytecode and #currentBytecode > 0 then
        local hex = toHex(currentBytecode)
        local ok  = false
        pcall(function()
            if setclipboard then
                setclipboard(hex)
                ok = true
            end
        end)
        if ok then
            DisplayText.Text = '<font color="#7ec0a0">Copied '
                .. #currentBytecode .. ' bytes to clipboard.</font>\n\n' .. hex
        else
            DisplayText.Text = '<font color="#ff6b6b">Clipboard not available.</font>\n\n' .. hex
        end
    else
        DisplayText.Text = '<font color="#ff6b6b">Nothing to copy.</font>'
    end
end)

